// KofShare product entry (implementation-plan.md §2 slice 3). Commands:
//   server [port] [--key <hex>]  control plane: serves offers over web.app()
//   offer <file>                 digest a file into an OfferInfo JSON record
//   fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure]
//                                [--relay <rhost> <rport>]
//                                pull an offer over kof.net into <dest>
//   relay <port> <peerHost> <peerPort> [--tamper]
//                                ciphertext-only relay for one session
//   --check                      full product golden (registry + plain +
//                                secure envelope legs), prints CHECK-OK
//   --dry                        resolve the transfer PLAN only, no sockets
//
// The registry verbs are the slice-1 pure domain; the transport is the
// slice-2 control surface; the transfer is the measured kof.net core. No
// new stdlib face is invented here (D-KOFSHARE-100KOF).

Int defaultControlPort() {
    return 18322
}

Int checkPortPlain() {
    return 19321
}

Int checkPortSecure() {
    return 19322
}

Int checkResumePlain() {
    return 100000
}

Int checkResumeSecure() {
    return 123456
}

String defaultKey() {
    return "kofshare-cli-key"
}

// File bytes (Int[] 0..255) → the wire Byte[] the digest/net faces take.
// Deterministic 200000-byte source for the `--check` legs (same generator as
// the e2e oracle, kept local so the product entry owns no e2e main()).
Int[] makeSource() {
    var n = 200000
    var a = new Int[n]
    var i = 0
    while (i < n) {
        a[i] = (i * 7 + 3) % 256
        i = i + 1
    }
    return a
}

Int[] prefix(Int[] src, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = src[i]
        i = i + 1
    }
    return out
}

// `offer <file>` — real content digest (sha256Bytes over the file bytes).
String offerJson(String path) {
    if (!File(path).exists()) {
        return "OFFER-ERR: file not found: " + path
    }
    var data = File(path).readBytes()
    if (data.size == 0) {
        return "OFFER-ERR: empty file: " + path
    }
    var digest = crypto.sha256Bytes(toBytes(data))
    var o = OfferRequest("o-" + digest.substring(0, 12), "local", path, data.size, digest, "", "", "", 0, "", "")
    return json.encode(o)
}

// `--check` leg 1 — the pure registry golden (no IO).
Boolean persistLeg() {
    var dp = "check-persist.devices.json"
    var op = "check-persist.offers.json"
    persistClean(dp)
    persistClean(op)
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    var ok = controlRegister(devices, DeviceInfo("d9", "persist", "127.0.0.1:8021")) == "OK"
    ok = ok && (controlSaveList(dp, controlDevicesJson(devices)) == "OK")
    var reload = new Map<String, DeviceInfo>()
    ok = ok && (controlLoadList(dp, reload, null) == "OK")
    ok = ok && (controlDevicesJson(reload) == controlDevicesJson(devices))
    var junk = "check-persist.junk.json"
    File(junk).writeText("nope")
    ok = ok && controlLoadList(junk, new Map<String, DeviceInfo>(), null).startsWith("REG009:")
    persistClean(junk)
    persistClean(dp)
    persistClean(op)
    return ok
}

void persistClean(String path) {
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
}

Boolean registryLeg() {
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    var ok = controlRegister(devices, DeviceInfo("d1", "alpha", "192.168.1.10:8021")) == "OK"
    ok = ok && (controlRegister(devices, DeviceInfo("", "x", "1.2.3.4:1")) == "REG001: empty device id")
    var d1 = controlResolve(devices, "d1")
    ok = ok && (d1 != null && d1.name == "alpha")
    var dig = crypto.sha256("/srv/a.bin")
    ok = ok && (controlOffer(offers, devices, OfferInfo("o1", "d1", "/srv/a.bin", 2048, dig, 1789000000000, "", "", 0, "", "")) == "OK")
    var back = controlResolveOffer(offers, "o1")
    ok = ok && (back != null && back.size == 2048 && back.deviceId == "d1")
    ok = ok && (controlRevoke(offers, "o1") == "OK")
    ok = ok && (controlResolveOffer(offers, "o1") == null)
    return ok
}

// `--check` leg 2 — the plain transfer core (resume@100000, real kof.net
// loopback), byte-for-byte + session Done.
Boolean plainLeg() {
    var src = "cli-check-src.bin"
    var dst = "cli-check-dst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, checkResumePlain()))
    var l = net.listen(checkPortPlain())
    var worker = spawn {
        var s = l.accept()
        serveFile(s, src, checkResumePlain(), "k0")
        s.close()
    }
    var c = net.connect("127.0.0.1", checkPortPlain())
    var t = fetchFile(c, dst, checkResumePlain(), "check-plain", "devA", "k0")
    c.close()
    await worker
    l.close()
    var a = File(src).readBytes()
    var b = File(dst).readBytes()
    var ok = (t.state == SessionState.Done) && (a.size == b.size) && (firstMismatch(a, b) < 0)
    File(src).delete()
    File(dst).delete()
    return ok
}

// `--check` leg 3 — the secure envelope (resume@123456): X25519 + HKDF
// direction keys, encrypt-then-MAC, byte-for-byte + session Done.
Boolean secureLeg() {
    var src = "cli-check-sec-src.bin"
    var dst = "cli-check-sec-dst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, checkResumeSecure()))
    var l = net.listen(checkPortSecure())
    var worker = spawn {
        var sv = l.accept()
        var privS = keyExchange.privateKey()
        serveFileSecure(sv, src, checkResumeSecure(), privS, security.randomHex(16))
        sv.close()
    }
    var c = net.connect("127.0.0.1", checkPortSecure())
    var privC = keyExchange.privateKey()
    var hs = fetchHandshake(c, privC)
    var t = fetchFileSecure(c, dst, checkResumeSecure(), "check-sec", "devB", hs.get(4), hs.get(5))
    c.close()
    var out = File(dst).readBytes()
    var ok = (t.state == SessionState.Done) && (out.size == data.size) && (firstMismatch(out, data) < 0)
    // directions must be distinct: encTx != encRx and macTx != macRx
    ok = ok && (hs.get(2) != hs.get(4)) && (hs.get(3) != hs.get(5))
    await worker
    l.close()
    File(src).delete()
    File(dst).delete()
    return ok
}

// `--check` — the one command that shows the whole product green.
// `--check` leg 8 — Track A identity, pure single-process (Script-safe):
// boot persists, id derives, canonical sign/verify round-trips through the
// PUBLIC half alone, and both lies (tampered message, wrong key) refuse.
// The identity file for this leg is scratch (deleted at the end).
Bool identityLeg() {
    var path = "check-identity.ed25519"
    if (File(path).exists()) {
        File(path).delete()
    }
    var sk = identityBoot(path)
    var pub = identityPub(sk)
    var id = identityDeviceId(pub)
    var again = identityBoot(path)
    var persisted = identityPub(again) == pub
    var sig = signReg(sk, id, "n", "127.0.0.1:1", pub)
    var verified = verifyReg(pub, id, "n", "127.0.0.1:1", sig)
    var tampered = verifyReg(pub, id, "n", "127.0.0.1:2", sig)
    var sk2 = keyExchange.privateKey("Ed25519")
    var wrongKey = verifyReg(identityPub(sk2), id, "n", "127.0.0.1:1", sig)
    var osig = signOffer(sk, "o-1", id, "f.bin", 10, "ab")
    var everified = verifyOffer(pub, "o-1", id, "f.bin", 10, "ab", osig)
    var elied = verifyOffer(pub, "o-1", id, "f.bin", 11, "ab", osig)
    File(path).delete()
    return pub.length() == 64 && id.indexOf("d-") == 0 && persisted && verified
        && !tampered && !wrongKey && everified && !elied
}

// `--check` leg 9 — Track C session machine, pure single-process (the exact
// sequence the sprobe measured 05/10 — expectations copied from GROUND TRUTH,
// not from hope): the legal ladder walks once; ownerAddr is STAMPED from the
// registry at CLAIMED; every shortcut/backstep/terminal-reentry refuses
// SES002; a terminal slot frees the token for a new rendezvous (SES005 only
// blocks ACTIVE sessions); the clock stamps EXPIRED and the touch refuses
// SES003; bad token SES004; empty recipient SES006; purge drops terminal.
Bool sessionLeg() {
    var shares = new Map<String, ShareInfo>()
    var devices = new Map<String, DeviceInfo>()
    var sessions = new Map<String, SessionInfo>()
    devices.put("d1", DeviceInfo("d1", "n", "127.0.0.1:1"))
    devices.put("d9", DeviceInfo("d9", "n", "127.0.0.9:9"))
    shares.put("sh1", ShareInfo("sh1", "tok1", "d1", "o1", "read", 1, 0, 0, 0, "active", "", "", ""))
    shares.put("sh2", ShareInfo("sh2", "tok2", "d9", "o2", "read", 1, 0, 0, 0, "active", "", "", ""))
    var ladder = new List<String>()
    ladder.add("CLAIMED")
    ladder.add("NEGOTIATING")
    ladder.add("CONNECTED")
    ladder.add("TRANSFERRING")
    ladder.add("COMPLETED")
    var created = sessionCreate(sessions, shares, "", "s1", SessionRequest("tok1", "d2", "10.0.0.2:5"), 100) == "OK"
    var walkOk = true
    for (var to in ladder) {
        if (to == "CLAIMED") {
            walkOk = walkOk && sessionClaim(sessions, devices, "s1", 200) == "OK"
        } else {
            walkOk = walkOk && sessionAdvance(sessions, "s1", to, "", 200) == "OK"
        }
    }
    var e1: SessionInfo? = sessionResolve(sessions, "s1")
    var oaddr = ""
    if (e1 != null) {
        oaddr = e1.ownerAddr
    }
    var completed = e1 != null && e1.state == "COMPLETED" && oaddr == "127.0.0.1:1"
    var backstep = sessionAdvance(sessions, "s1", "NEGOTIATING", "", 300).indexOf("SES002") == 0
    var afterTerminalOk = sessionCreate(sessions, shares, "", "s2", SessionRequest("tok1", "d3", ""), 300).indexOf("OK") == 0
    var activeBlock = sessionCreate(sessions, shares, "", "s3", SessionRequest("tok1", "d4", ""), 300).indexOf("SES005") == 0
    var s8 = sessionCreate(sessions, shares, "", "s8", SessionRequest("tok2", "d8", ""), 100) == "OK"
    var skipRef = sessionAdvance(sessions, "s8", "CONNECTED", "", 400).indexOf("SES002") == 0
    var expire = sessionAdvance(sessions, "s8", "TRANSFERRING", "", 99999999).indexOf("SES003") == 0
    var e8: SessionInfo? = sessionResolve(sessions, "s8")
    var expiredStamped = e8 != null && e8.state == "EXPIRED"
    var afterExpire = sessionAdvance(sessions, "s8", "COMPLETED", "", 99999999).indexOf("SES002") == 0
    var badTok = sessionCreate(sessions, shares, "", "s5", SessionRequest("nope", "d6", ""), 500).indexOf("SES004") == 0
    var emptyDev = sessionCreate(sessions, shares, "", "s6", SessionRequest("tok2", "", ""), 500).indexOf("SES006") == 0
    var purged = sessionPurgeExpired(sessions, 99999999) >= 3
    return created && walkOk && completed && backstep && afterTerminalOk && activeBlock
        && s8 && skipRef && expire && expiredStamped && afterExpire && badTok && emptyDev && purged
}

// `--check` leg 12 — Track F resource identity, PURE (Script-safe):
// derivation is stable and NEVER path-shaped; the same content from two
// devices yields DIFFERENT resource ids and DIFFERENT offer slots (the
// measured collision truth, closed by construction); hash stays a SEPARATE
// attribute of the resource, never its identity.
Bool resourceLeg() {
    var d1 = "d-0123456789abcdef"
    var d2 = "d-1111111111111111"
    var h = crypto.sha256("same-bytes")
    var r1 = resourceIdFor(d1, "a.bin", 10, h)
    var r2 = resourceIdFor(d1, "a.bin", 10, h)
    var r3 = resourceIdFor(d2, "a.bin", 10, h)
    var derivOk = r1 == r2 && r1.length() == 18 && r1.indexOf("r-") == 0
    var deviceScoped = r1 != r3 && r1.substring(2, r1.length()) != h.substring(0, 16)
    var hashSeparate = crypto.sha256("same-bytes") == h &&
        offerIdFor(d1, r1) != offerIdFor(d2, r1) && offerIdFor(d1, r1).length() == 14
    var nameOk = resourceName("/home/mel/docs/a.bin") == "a.bin" &&
        resourceName("C:\\Users\\Mel\\docs\\a.bin") == "a.bin" &&
        resourceName("plain.bin") == "plain.bin"
    var devs = new Map<String, DeviceInfo>()
    controlRegister(devs, DeviceInfo(d1, "res-probe", "127.0.0.1:1"))
    controlRegister(devs, DeviceInfo(d2, "res-probe2", "127.0.0.1:2"))
    var leak = controlOffer(new Map<String, OfferInfo>(), devs,
        OfferInfo("o9", d1, "/srv/a.bin", 10, h, 1789000000000, "/home/mel/a.bin", "", 0, "", ""))
    var pathRefused = leak.indexOf("REG013") == 0
    var liarRefused = controlOffer(new Map<String, OfferInfo>(), devs,
        OfferInfo("o8", d1, "a.bin", 10, h, 1789000000000, "r-ffffffffffffffff", "a.bin", 0, "", ""))
        .indexOf("REG014") == 0
    var metaOk = isPathLike("../../etc/passwd") && isPathLike("/etc/passwd") &&
        isPathLike("C:\\x") && !isPathLike("a.bin") &&
        resourceName("../../etc/passwd") == "passwd"
    return derivOk && deviceScoped && hashSeparate && nameOk && pathRefused &&
        liarRefused && metaOk
}

// `--check` leg 11 — Track E page/contract, PURE (Script-safe): the page is
// a STRING asset (no web front needed to verify its contract); it must carry
// the API routes, must NEVER carry credentials vocabulary, and the refusal
// normalization must keep the NAMED head of a multi-line error.
Bool appLeg() {
    var html = pageHtml()
    var pageOk = html.indexOf("<!doctype html>") == 0
        && html.indexOf("/api/info") >= 0
        && html.indexOf("/jobs") >= 0
        && html.indexOf("Bearer") < 0
        && html.indexOf("server-control") < 0
    var nameOk = baseName("/srv/a.bin") == "a.bin" && baseName("plain.bin") == "plain.bin"
    var viewOk = json.decode<GrantView>(json.encode(GrantView("REFUSED", "", 0, ""))).error == "REFUSED"
    var errOk = errName("REFUSED: x\nstack") == "REFUSED: x"
    return pageOk && nameOk && viewOk && errOk
}

// `--check` leg 10 — Track D strategy, PURE (no sockets, Script-safe): the
// ordered-attempt classification (both real locales of "refused", timeout,
// unknown), first-ok wins, all-dead fails CONNECTIVITY_FAILED by name.
Bool connectLeg() {
    var t1 = new List<NegotiateAttempt>()
    t1.add(NegotiateAttempt("direct", "ok"))
    var p1 = negotiatePath(t1)
    var directWins = p1.transport == "direct" && p1.attempts == 1
    var t2 = new List<NegotiateAttempt>()
    t2.add(NegotiateAttempt("direct", "dead"))
    t2.add(NegotiateAttempt("relay", "ok"))
    var p2 = negotiatePath(t2)
    var relayFallback = p2.transport == "relay" && p2.attempts == 2
    var t3 = new List<NegotiateAttempt>()
    t3.add(NegotiateAttempt("direct", "dead"))
    t3.add(NegotiateAttempt("relay", "dead"))
    var p3 = negotiatePath(t3)
    var allFail = p3.transport == "CONNECTIVITY_FAILED"
    var cl1 = classifyConnect("kof.net: cannot connect: Connection refused") == "dead"
    var cl2 = classifyConnect("kof.net: cannot connect to 127.0.0.1: Conexão recusada") == "dead"
    var cl3 = classifyConnect("some other socket error") == "other"
    return directWins && relayFallback && allFail && cl1 && cl2 && cl3
}

Bool dirLeg() {
    // Track G pure units: deterministic walk/sort/digest + named refusals.
    var dev = "d-0123456789abcdef"
    var e1 = DirEntry("r-aaaaaaaaaaaaaaaa", "docs/b.txt", "FILE", 3, "h3", 10)
    var e2 = DirEntry("r-bbbbbbbbbbbbbbbb", "docs/a.txt", "FILE", 4, "h4", 11)
    var e3 = DirEntry("r-cccccccccccccccc", "docs", "DIRECTORY", 0, "", 9)
    var seed = new List<DirEntry>()
    seed.add(e3)
    seed.add(e1)
    seed.add(e2)
    var sorted = sortEntries(seed)
    var orderOk = sorted.get(0).logicalPath == "docs" &&
        sorted.get(1).logicalPath == "docs/a.txt" &&
        sorted.get(2).logicalPath == "docs/b.txt"
    var h1 = directoryDigest("docs", sorted)
    var seed2 = new List<DirEntry>()
    seed2.add(e1)
    seed2.add(e2)
    seed2.add(e3)
    var h2 = directoryDigest("docs", sortEntries(seed2))
    var digestOk = h1.length() == 64 && h1 == h2
    var vOk = dirValidate(sorted, h1) == "OK"
    var bad = new List<DirEntry>()
    bad.add(DirEntry("r-aaaaaaaaaaaaaaaa", "../escape", "FILE", 3, "h3", 10))
    var travOk = dirValidate(bad, directoryDigest("docs", bad)).indexOf("REG015") == 0
    var baseOk = dirBaseName("docs/sub/a.txt") == "a.txt" && dirBaseName("a.txt") == "a.txt"
    var jsonOk = dirEntriesFromJson(dirEntriesJson(sorted)).get(1).logicalPath == "docs/a.txt"
    var idOk = resourceIdFor(dev, "docs/a.txt", 4, "h4").length() == 18
    return orderOk && digestOk && vOk && travOk && baseOk && jsonOk && idOk
}

Bool uxLeg() {
    // Track I pure units: duration parsing, human error mapping, ttl labels.
    var ttlOk = parseTtlMs("24h") == 86400000 && parseTtlMs("30m") == 1800000
        && parseTtlMs("7d") == 604800000 && parseTtlMs("45s") == 45000
        && parseTtlMs("1500ms") == 1500 && parseTtlMs("90000") == 90000
    var hintOk = errText("REG038: share exhausted").indexOf("already used") >= 0
        && errText("REG035: unknown share token").indexOf("no longer exists") >= 0
        && errText("DEV-OFFLINE: d-x is not reachable").indexOf("offline") >= 0
        && errText("DEV003: device revoked d-x").indexOf("revoked") >= 0
        && errText("CONNECTIVITY_FAILED").indexOf("No path") >= 0
        && errText("REG013: resource id must not be path-like").indexOf("refused by design") >= 0
        && errText("REG016: directory manifest digest mismatch").indexOf("refused by design") >= 0
        && errText("totally unknown thing").length() == 0
    var labelOk = ttlLabel(86400000) == "1 day(s)" && ttlLabel(3600000) == "1 hour(s)"
        && ttlLabel(600000) == "10 minute(s)" && ttlLabel(1000) == "1 second(s)"
    var detOk = parseTtlMs("24h") > parseTtlMs("23h")
    return ttlOk && hintOk && labelOk && detOk
}

Int runCheck() {
    var reg = registryLeg()
    var plain = plainLeg()
    var secure = secureLeg()
    var persist = persistLeg()
    println("registry=" + reg)
    println("persist=" + persist)
    println("plain=" + plain)
    println("secure=" + secure)
    var share = shareLeg()
    println("share=" + share)
    var auth = authLeg()
    println("auth=" + auth)
    var resume = resumeLeg()
    println("resume=" + resume)
    var identity = identityLeg()
    println("identity=" + identity)
    var sess = sessionLeg()
    println("session=" + sess)
    var conn = connectLeg()
    println("connect=" + conn)
    var app = appLeg()
    println("app=" + app)
    var reso = resourceLeg()
    println("resource=" + reso)
    var dir = dirLeg()
    println("dir=" + dir)
    var ux = uxLeg()
    println("ux=" + ux)
    if (reg && persist && plain && secure && share && auth && resume && identity && sess && conn && app && reso && dir && ux) {
        println("CHECK-OK")
        return 0
    }
    println("CHECK-FAIL")
    return 1
}

// `--check` leg 4 — the C2 share model (pure domain + C1 signature face).
// issue/touch/exhaust/revoke/expired/purge + sign/verify/tamper, all by NAME.
Bool shareLeg() {
    var now = 1000
    var sk = keyExchange.privateKey("Ed25519")
    var pub = keyExchange.publicKey(sk)
    var shares = new Map<String, ShareInfo>()
    var ok = true
    ok = ok && (shareIssue(shares, ShareInfo("s1", tokenOf("11"), "d1", "o1", "read", now, now + 10, 1, 0, "active", "", "", "")) == "OK")
    var core = shareResolve(shares, tokenOf("11"))
    if (core == null) {
        return false
    }
    var st = shareSign(sk, core)
    var signed = ShareInfo(core.id, core.token, core.deviceId, core.offerId, core.permissions, core.createdAt, core.expiresAt, core.maxUses, core.used, core.status, core.revocation, st, "")
    shares.put("s1", signed)
    ok = ok && shareVerify(secrets.of(pub), signed)
    ok = ok && shareTouch(shares, signed.token, now) == "OK"
    ok = ok && shareTouch(shares, signed.token, now + 1) == "REG038: share exhausted"
    ok = ok && shareRevoke(shares, "s1", "check") == "OK"
    ok = ok && shareTouch(shares, signed.token, now + 2) == "REG036: share revoked"
    ok = ok && shareResolve(shares, tokenOf("ff")) == null
    ok = ok && sharesPurgeExpired(shares, now + 999) == 1
    return ok
}


Int runAccount(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("ACCOUNT-ERR: usage: account <host> <port> list | account <host> <port> add <id> <label> | account <host> <port> revoke <id>")
        return 1
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    var sub = rest.get(2)
    var bearer = "Authorization: Bearer " + bearerArg(rest, 3)
    if (sub == "list") {
        var body = http.get(base + "/accounts", bearer)
        if (body == null) {
            println("ACCOUNT-ERR: control plane unreachable")
            return 1
        }
        println(body)
        return 0
    }
    if (sub == "add" && args.size >= 5) {
        var resp = http.post(base + "/accounts", json.encode(AccountRequest(rest.get(3), rest.get(4), 0)), bearer)
        if (resp == null) {
            println("ACCOUNT-ERR: control plane unreachable")
            return 1
        }
        println(resp)
        return 0
    }
    if (sub == "revoke" && args.size >= 4) {
        var resp = http.post(base + "/accounts/" + rest.get(3) + "/revoke", "", bearer)
        if (resp == null) {
            println("ACCOUNT-ERR: control plane unreachable")
            return 1
        }
        println(resp)
        return 0
    }
    println("ACCOUNT-ERR: unknown subcommand " + sub)
    return 1
}

String tokenOf(String seed) {
    var s = seed
    while (s.length < 64) {
        s = s + "0"
    }
    return s.substring(0, 64)
}

// `--check` leg 5 — the C3 bearer model (pure): issue/identity/revocation
// matrix + JWT mint/verify/parse round-trip (jwt over the control secret);
// corrupt load refuses by name. The wire-level gate is httpcheck's job.
// `--check` leg 7 — A3 resume negotiation, pure matrix (Script-safe; the
// wire refusal cases live in `resumecheck/checkresume.kf`, JVM goldens).
Bool resumeLeg() {
    var ok = true
    ok = ok && (resumeVerify(0, 5000) == "OK")
    ok = ok && (resumeVerify(2000, 5000) == "OK")
    ok = ok && (resumeVerify(5000, 5000) == "OK")
    ok = ok && (resumeVerify(6000, 5000) == "RESUME-ERR: server file shorter than requested offset")
    ok = ok && (resumeVerify(0 - 1, 5000) == "RESUME-ERR: negative offset")
    ok = ok && (helloIndex() == 1073741822)
    ok = ok && (resumeErrIndex() == 1073741821)
    return ok
}

Bool authLeg() {
    var accounts = new Map<String, Account>()
    var ok = true
    ok = ok && (authIssue(accounts, "a1", "alpha", 1) == "OK")
    ok = ok && (authIssue(accounts, "a1", "dup", 2) == "AUTH005: duplicate account id a1")
    ok = ok && (authIssue(accounts, "", "x", 2) == "AUTH005: empty account id")
    ok = ok && (authIssue(accounts, "a2", "", 2) == "AUTH004: empty account label")
    var secret = security.apiKeyGenerate()
    var token = authMint(secret, "a1", "alpha", 60)
    ok = ok && (token.length() > 0)
    var verified = jwt.verify(token, secret)
    ok = ok && (verified.length() > 0)
    var sub = authParseSub(verified)
    ok = ok && (sub == "a1")
    ok = ok && (authActive(accounts, sub) == "OK")
    ok = ok && (authActive(accounts, "ghost") == "AUTH006: unknown account ghost")
    ok = ok && (authActive(accounts, "") == "AUTH002: bearer has no identity")
    ok = ok && (authRevoke(accounts, "a1") == "OK")
    ok = ok && (authActive(accounts, "a1") == "AUTH003: revoked")
    ok = ok && (authParseSub("not json") == "")
    var apath = "check-auth.accounts.json"
    var f0 = File(apath)
    if (f0.exists()) {
        f0.delete()
    }
    ok = ok && (controlSaveList(apath, authAccountsJson(accounts)) == "OK")
    var acc2 = new Map<String, Account>()
    ok = ok && (authLoadList(acc2, apath) == "OK")
    ok = ok && (authAccountsJson(acc2) == authAccountsJson(accounts))
    if (f0.exists()) {
        f0.delete()
    }
    var jf = File("check-auth.junk.json")
    jf.writeText("{ not json")
    var acc3 = new Map<String, Account>()
    ok = ok && (authLoadList(acc3, "check-auth.junk.json").indexOf("AUTH043") == 0)
    jf.delete()
    return ok
}

// `--dry` — print the resolved product plan, no IO. Deterministic.
Int runDry() {
    println("DRY-PLAN commands:")
    println("  server [port] [--key <hex>]  -> control plane web.app() on port " + defaultControlPort())
    println("  offer <file>                 -> OfferInfo JSON (sha256Bytes over the file)")
    println("  fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>] -> kof.net pull")
    println("  serve <path> <port> [--resume <n>] [--key <hex>] [--secure] [--salt <hex>] [--once] -> kof.net device-side serving (one session)")
    println("  up <ctrlHost> <ctrlPort> <file> --id <dev> --serve <host:port> [--name <n>] [--bearer <jwt>] -> publish device+offer to the control plane")
    println("  down <ctrlHost> <ctrlPort> <token> <dest> [--key <hex>] [--relay <rhost> <rport>] -> resolve /s/<token>, fetch (direct or relayed), verify digest")
    println("  relay <port> <peerHost> <peerPort> [--tamper] -> ciphertext-only relay")
    println("  share <host> <port> <offerId> [--once] [--read-only] [--ttl <ms>] -> mint grant")
    println("  revoke <host> <port> <shareId> [reason] | shares <host> <port>")
    println("  authorize <host> <port> <token> -> GET /s/<token> (grant JSON or REG refusal)")
    println("  --check                      -> registry + plain port=" + checkPortPlain()
        + " resume=" + checkResumePlain() + " + secure port=" + checkPortSecure()
        + " resume=" + checkResumeSecure())
    println("DRY-OK")
    return 0
}

// `fetch` — real transfer from a serving peer. `--resume <n>` appends to a
// partial file; `--key <hex>` must match the peer's key; `--secure` uses the
// X25519/HKDF envelope; `--relay <host> <port>` routes through the
// ciphertext-only relay (slice 5). Without `--relay` the client connects
// directly to the peer.
// A6 user-flow verbs — thin wrappers over kofshare.userflow (golden-
// proven). `up` PUBLISHES the story in one command: registers device+offer
// in the control plane (bearer from --bearer or server-control.bearer),
// prints the OFFER id. `down` RECEIVES it: resolves GET /s/<token> on the
// control plane, learns the publisher address FROM THE GRANT, resumes from
// any local .part, transfers and verifies the offer digest (DOWN-ERR by
// name on mismatch — never silent).
Int runHeartbeat(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("HEARTBEAT-ERR: usage: heartbeat <ctrlHost> <ctrlPort> <deviceId> [--bearer <jwt>]")
        return 1
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    println(http.post(base + "/devices/" + rest.get(2) + "/heartbeat", "{}",
        "Authorization: Bearer " + bearerArg(rest, 3)))
    return 0
}

Int cliRunApp(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 5) {
        println("APP-ERR: usage: app <planePort> <localPort> <token> <key> <destDir> [--recipient R] [--relay host:port]")
        return 1
    }
    var base = "http://127.0.0.1:" + rest.get(0)
    var localPort = math.parseInt(rest.get(1))
    var token = rest.get(2)
    var key = rest.get(3)
    var destDir = rest.get(4)
    var recipient = "browser-client"
    var relayHost = ""
    var relayPort = 0
    var i = 5
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--recipient") {
            recipient = argAt(rest, i + 1)
            i = i + 2
        } else {
            if (a == "--relay") {
                var rp = argAt(rest, i + 1)
                var colon = rp.lastIndexOf(":")
                if (colon > 0) {
                    relayHost = rp.substring(0, colon)
                    relayPort = math.parseInt(rp.substring(colon + 1, rp.length()))
                }
                i = i + 2
            } else {
                i = i + 1
            }
        }
    }
    return runApp(base, localPort, token, key, destDir, recipient, relayHost, relayPort)
}

Int runDevice(List<String> args) {
    if (args.size < 1) {
        println("DEVICE-ERR: usage: device new | device enroll <ctrlHost> <ctrlPort> [--name <n>] [--bearer <jwt>] | device revoke <ctrlHost> <ctrlPort> <deviceId> [--bearer <jwt>] | device list <ctrlHost> <ctrlPort> [--bearer <jwt>]")
        return 1
    }
    var sub = args.get(0)
    if (sub == "new") {
        var sk = identityBoot("kofshare-device.ed25519")
        var pub = identityPub(sk)
        println("DEVICE-ID " + identityDeviceId(pub))
        println("PUB " + pub)
        return 0
    }
    if (sub == "enroll") {
        if (args.size < 3) {
            println("DEVICE-ERR: enroll needs <ctrlHost> <ctrlPort>")
            return 1
        }
        var base = "http://" + args.get(1) + ":" + args.get(2)
        var name = "device"
        var bearer = ""
        var i = 3
        while (i < args.size) {
            var a = argAt(args, i)
            if (a == "--name") {
                name = argAt(args, i + 1)
                i = i + 2
            } else {
                if (a == "--bearer") {
                    bearer = argAt(args, i + 1)
                    i = i + 2
                } else {
                    i = i + 1
                }
            }
        }
        var addr = argAt(args, 1) + ":" + argAt(args, 2)
        var sk = identityBoot("kofshare-device.ed25519")
        var pub = identityPub(sk)
        var id = identityDeviceId(pub)
        var out = http.post(base + "/devices/register",
            json.encode(DeviceRegister(id, name, addr, pub, signReg(sk, id, name, addr, pub))),
            "Authorization: Bearer " + bearer)
        println(out)
        return 0
    }
    if (sub == "revoke") {
        if (args.size < 4) {
            println("DEVICE-ERR: revoke needs <ctrlHost> <ctrlPort> <deviceId>")
            return 1
        }
        var base = "http://" + args.get(1) + ":" + args.get(2)
        var bearer = ""
        if (args.size > 4 && argAt(args, 4) == "--bearer") {
            bearer = argAt(args, 5)
        }
        var out = http.post(base + "/devices/" + args.get(3) + "/revoke", "{}",
            "Authorization: Bearer " + bearer)
        println(out)
        return 0
    }
    if (sub == "list") {
        if (args.size < 3) {
            println("DEVICE-ERR: list needs <ctrlHost> <ctrlPort>")
            return 1
        }
        var base = "http://" + args.get(1) + ":" + args.get(2)
        var bearer = ""
        if (args.size > 3 && argAt(args, 3) == "--bearer") {
            bearer = argAt(args, 4)
        }
        println(http.get(base + "/devices"))
        return 0
    }
    println("DEVICE-ERR: unknown device subcommand " + sub)
    return 1
}

Int runUpDir(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 4) {
        println("UP-ERR: usage: updir <ctrlHost> <ctrlPort> <dir> --serve <host:port> [--bearer <jwt>]")
        return 1
    }
    var controlBase = "http://" + rest.get(0) + ":" + rest.get(1)
    var rootPath = rest.get(2)
    var serveAddr = ""
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--serve") {
            serveAddr = argAt(rest, i + 1)
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if (serveAddr.length() == 0) {
        println("UP-ERR: updir needs --serve <host:port> (the dir face the recipient dials)")
        return 1
    }
    var bearer = "Authorization: Bearer " + bearerArg(rest, 3)
    var sk = identityBoot("kofshare-device.ed25519")
    var out = upPublishDir(controlBase, sk, serveAddr, rootPath, bearer)
    println(out)
    return 0
}

Int runDownDir(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 4) {
        println("DOWN-ERR: usage: downdir <ctrlHost> <ctrlPort> <token> <destRoot> [key]")
        return 1
    }
    var controlBase = "http://" + rest.get(0) + ":" + rest.get(1)
    var key = "k0"
    if (rest.size >= 5) {
        key = rest.get(4)
    }
    var out = downDir(controlBase, rest.get(2), rest.get(3), key)
    println(out)
    return 0
}

Int runServeDir(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 2) {
        println("SERVE-ERR: usage: serve-dir <root> <port> [key] [--server host:port]")
        return 1
    }
    var key = "k0"
    if (rest.size >= 3) {
        key = rest.get(2)
    }
    var srv = ""
    var j = 3
    while (j < rest.size) {
        if (rest.get(j) == "--server") {
            srv = argAt(rest, j + 1)
            j = j + 2
        } else {
            j = j + 1
        }
    }
    if (srv.length() > 0) {
        startFaceHeartbeat(srv, math.parseInt(rest.get(1)))
    }
    serveDirLoop(rest.get(0), math.parseInt(rest.get(1)), key)
    return 0
}

Int runUp(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 4) {
        println("UP-ERR: usage: up <ctrlHost> <ctrlPort> <file> --serve <host:port> [--id <dev>] [--name <n>] [--bearer <jwt>]  (--id present = v1 keyless lane; absent = Track A signed identity)")
        return 1
    }
    var controlBase = "http://" + rest.get(0) + ":" + rest.get(1)
    var filePath = rest.get(2)
    var deviceId = ""
    var name = deviceId
    var serveAddr = ""
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--id") {
            deviceId = argAt(rest, i + 1)
            i = i + 2
        } else {
            if (a == "--name") {
                name = argAt(rest, i + 1)
                i = i + 2
            } else {
                if (a == "--serve") {
                    serveAddr = argAt(rest, i + 1)
                    i = i + 2
                } else {
                    i = i + 1
                }
            }
        }
    }
    if (serveAddr.length() == 0) {
        println("UP-ERR: up needs --serve <host:port> (the address the recipient will dial)")
        return 1
    }
    if (name.length() == 0) {
        name = deviceId
    }
    var bearer = "Authorization: Bearer " + bearerArg(rest, 3)
    var out = ""
    if (deviceId.length() > 0) {
        // v1 lane (Track M): hand-picked id, keyless registration
        out = upPublish(controlBase, deviceId, name, serveAddr, filePath, bearer)
    } else {
        // TRACK A lane: one Ed25519 identity per installation, id derived
        // from the public key, enrollment+offer signed by the device.
        var sk = identityBoot("kofshare-device.ed25519")
        if (name.length() == 0) {
            name = "device"
        }
        out = upPublishSigned(controlBase, sk, name, serveAddr, filePath, bearer)
    }
    println(out)
    return 0
}

Int runDown(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("DOWN-ERR: usage: down <controlHost> <controlPort> <token> <dest> [--key <hex>] [--relay <rhost> <rport>]")
        return 1
    }
    var controlBase = "http://" + rest.get(0) + ":" + rest.get(1)
    var token = rest.get(2)
    var dest = rest.get(3)
    var key = defaultKey()
    var relayHost = ""
    var relayPort = 0
    var auto = false
    var recipient = ""
    var i = 4
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--key") {
            key = argAt(rest, i + 1)
            i = i + 2
        } else {
            if (a == "--relay") {
                relayHost = argAt(rest, i + 1)
                relayPort = math.parseInt(argAt(rest, i + 2))
                i = i + 3
            } else {
                if (a == "--auto") {
                    auto = true
                    i = i + 1
                } else {
                    if (a == "--recipient") {
                        recipient = argAt(rest, i + 1)
                        i = i + 2
                    } else {
                        i = i + 1
                    }
                }
            }
        }
    }
    if (auto) {
        var dev = recipient
        if (dev.length() == 0) {
            dev = identityDeviceId(identityPub(identityBoot("kofshare-device.ed25519")))
        }
        println(downAuto(controlBase, token, dest, key,
            "Authorization: Bearer " + bearerArg(rest, 4), dev, relayHost, relayPort))
        return 0
    }
    println(downFetch(controlBase, token, dest, key, relayHost, relayPort))
    return 0
}

// Device side of the data plane (A5): serve ONE session of `path` on `port`
// (single-session by design — one accept then exit; --once kept for help).
// plain = serveFile with the shared key; --secure = X25519 envelope
// (device-minted key, optional --salt hex). Prints SERVE-LISTENING before
// accept so harnesses can sync, SERVED <bytes> (or SERVE-REFUSED rc 2 when
// resumeVerify rejects the peer's HELLO offset) after the pump.
Int runServe(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 2) {
        println("SERVE-ERR: usage: serve <path> <port> [--resume <n>] [--key <hex>] [--secure] [--salt <hex>] [--once]")
        return 1
    }
    var path = rest.get(0)
    var port = 0
    var resume = 0
    var key = defaultKey()
    var secure = false
    var salt = ""
    var loopOn = false
    var serverAddr = ""
    var i = 2
    // v2-Track F face: `serve --resource r-… <port>` resolves the LOCAL
    // binding (the path never comes from the wire — §6/§7 boundary). The old
    // `serve <path> <port>` face is untouched (v1 compat, §11).
    if (path == "--resource") {
        if (rest.size < 3) {
            println("SERVE-ERR: usage: serve --resource <resourceId> <port>")
            return 1
        }
        var rid = rest.get(1)
        var bp = bindingResolve("kofshare-resources.json", rid)
        if (bp.length() == 0) {
            println("SERVE-ERR: no local binding for resource " + rid)
            return 1
        }
        path = bp
        port = math.parseInt(rest.get(2))
        i = 3
    } else {
        port = math.parseInt(rest.get(1))
    }
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--loop") {
            loopOn = true
            i = i + 1
        } else {
            if (a == "--server") {
                serverAddr = argAt(rest, i + 1)
                i = i + 2
            } else {
                if (a == "--resume") {
            var nxt = argAt(rest, i + 1)
            if (isDigits(nxt)) {
                resume = math.parseInt(nxt)
                i = i + 2
            } else {
                i = i + 1
            }
        } else {
            if (a == "--key") {
                key = argAt(rest, i + 1)
                i = i + 2
            } else {
                if (a == "--secure") {
                    secure = true
                    i = i + 1
                } else {
                    if (a == "--salt") {
                        salt = argAt(rest, i + 1)
                        i = i + 2
                    } else {
                        i = i + 1
                    }
                    }
                }
            }
        }
    }
    }
    if (!File(path).exists()) {
        println("SERVE-ERR: file not found: " + path)
        return 1
    }
    var l = net.listen(port)
    println("SERVE-LISTENING " + port)
    if (serverAddr.length() > 0) {
        startFaceHeartbeat(serverAddr, port)
    }
    if (loopOn) {
        // v2-Track I: the product face keeps OFFERING the file — recipients
        // dial repeatedly (resume across attempts is per session, per file).
        var n = 0
        while (n < 256) {
            var sc = l.accept()
            var rc = serveOne(sc, path, resume, key, secure, salt)
            sc.close()
            if (rc != 0 - 3) {
                println("SERVED " + rc)
            } else {
                println("SERVE-REFUSED: peer offset rejected (client-side RESUME-ERR names it)")
            }
            n = n + 1
        }
        l.close()
        return 0
    }
    var s = l.accept()
    var served = serveOne(s, path, resume, key, secure, salt)
    s.close()
    l.close()
    if (served == 0 - 3) {
        println("SERVE-REFUSED: peer offset rejected (client-side RESUME-ERR names it)")
        return 2
    }
    println("SERVED " + served)
    return 0
}

Int serveOne(Conn sc, String path, Int resume, String key, Bool secure, String salt) {
    if (secure) {
        var priv = keyExchange.privateKey()
        var saltHex = salt
        if (saltHex.length() == 0) {
            saltHex = security.randomHex(16)
        }
        return serveFileSecure(sc, path, resume, priv, saltHex)
    }
    return serveFile(sc, path, resume, key)
}

void startFaceHeartbeat(String serverAddr, Int port) {
    var sp = serverAddr.indexOf(":")
    var h = serverAddr.substring(0, sp)
    var pp = serverAddr.substring(sp + 1, serverAddr.length())
    var dev = identityDeviceId(identityPub(identityBoot("kofshare-device.ed25519")))
    var auth = "Authorization: Bearer " + localBearer()
    spawn {
        while (true) {
            http.post("http://" + h + ":" + pp + "/devices/" + dev + "/heartbeat", "{}", auth)
            time.sleep(60000)
        }
    }
}

Int runFetch(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("FETCH-ERR: usage: fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>]")
        return 1
    }
    var host = argAt(rest, 0)
    var port = math.parseInt(argAt(rest, 1))
    var dest = argAt(rest, 2)
    var resume = 0
    var key = defaultKey()
    var secure = false
    var relayed = false
    var relayHost = ""
    var relayPort = 0
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--resume") {
            var nxt = argAt(rest, i + 1)
            if (isDigits(nxt)) {
                resume = math.parseInt(nxt)
                i = i + 2
            } else {
                // bare --resume: continue from what the .part already holds
                if (File(dest).exists()) {
                    resume = File(dest).size() as Int
                }
                i = i + 1
            }
        } else {
            if (a == "--key") {
                key = argAt(rest, i + 1)
                i = i + 2
            } else {
                if (a == "--secure") {
                    secure = true
                    i = i + 1
                } else {
                    if (a == "--relay") {
                        relayed = true
                        relayHost = argAt(rest, i + 1)
                        relayPort = math.parseInt(argAt(rest, i + 2))
                        i = i + 3
                    } else {
                        i = i + 1
                    }
                }
            }
        }
    }
    var hostToUse = host
    var portToUse = port
    if (relayed) {
        hostToUse = relayHost
        portToUse = relayPort
    }
    var c = net.connect(hostToUse, portToUse)
    var t: Transfer
    if (secure) {
        var privC = keyExchange.privateKey()
        var hs = fetchHandshake(c, privC)
        t = fetchFileSecure(c, dest, resume, "cli-fetch", "peer", hs.get(4), hs.get(5))
    } else {
        t = fetchFile(c, dest, resume, "cli-fetch", "peer", key)
    }
    c.close()
    println("FETCH-DONE state=" + t.state + " offset=" + t.offset + "/" + t.totalBytes
        + " relay=" + relayed + " secure=" + secure)
    if (t.state == SessionState.Done) {
        println("FETCH-OK")
        return 0
    }
    return 1
}

// `relay <port> <peerHost> <peerPort> [--tamper]` — serve one ciphertext-only
// relayed session. `--tamper` flips one ciphertext byte (probe only).
Int runRelay(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("RELAY-ERR: usage: relay <port> <peerHost> <peerPort> [--tamper]")
        return 1
    }
    var port = math.parseInt(argAt(rest, 0))
    var peerHost = argAt(rest, 1)
    var peerPort = math.parseInt(argAt(rest, 2))
    var tamper = argAt(rest, 3) == "--tamper"
    println("RELAY-READY port=" + port + " peer=" + peerHost + ":" + peerPort + " tamper=" + tamper)
    if (tamper) {
        var l = net.listen(port)
        relayServeTamperOn(l, peerHost, peerPort)
    } else {
        relayServe(port, peerHost, peerPort)
    }
    return 0
}

// `server` — the control plane daemon (listen blocks; stop = process).
Int runServer(List<String> args) {
    var rest = tail(args, 1)
    var port = defaultControlPort()
    var key = defaultKey()
    // `server --start` = detached product launch: returns when SERVER-READY
    // is on the log; the plane keeps running (Track I happy path).
    var detached = false
    var i = 0
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--key") {
            key = argAt(rest, i + 1)
            i = i + 2
        } else {
            if (a == "--start") {
                detached = true
                i = i + 1
            } else {
                port = math.parseInt(a)
                i = i + 1
            }
        }
    }
    if (detached) {
        if (healthNow("http://127.0.0.1:" + port)) {
            println("SERVER-READY (already up) port=" + port)
            return 0
        }
        var sp = spawnDetached("kofshare-server.log", listOf("server", "" + port, "--key", key),
            "kofshare-server.pid")
        if (sp < 0) {
            println("SERVER-ERR: cannot self-spawn (no kofshare-cli.config with jar=)")
            return 1
        }
        var t0 = 0
        var ready = false
        while (t0 < 60 && !ready) {
            if (File("kofshare-server.log").exists()) {
                var txt = File("kofshare-server.log").readText()
                if (txt != null && txt.indexOf("SERVER-READY") >= 0) {
                    ready = true
                }
            }
            if (!ready) {
                time.sleep(250)
                t0 = t0 + 1
            }
        }
        if (!ready) {
            println("SERVER-ERR: plane did not become ready in 15s (see kofshare-server.log)")
            return 1
        }
        println("SERVER-READY port=" + port + " (detached; kofshare stop --server to stop)")
        return 0
    }
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    controlLoadList("server-registry.devices.json", devices, null)
    controlLoadList("server-registry.offers.json", null, offers)
    var devkeys = new Map<String, DeviceKey>()
    var kload = controlLoadDevkeys(devkeys, "server-registry.devkeys.json")
    if (kload.indexOf("REG009") == 0) {
        println(kload)
        return 1
    }
    var presences = new Map<String, PresenceInfo>()
    var pload = presenceLoadList(presences, "server-registry.presence.json")
    if (pload.indexOf("PRES041") == 0) {
        println(pload)
        return 1
    }
    var sessions = new Map<String, SessionInfo>()
    var nload = sessionLoadList(sessions, "server-registry.sessions.json")
    if (nload.indexOf("SES041") == 0) {
        println(nload)
        return 1
    }
    var snPurge = sessionPurgeExpired(sessions, time.now())
    if (snPurge > 0) {
        controlSaveList("server-registry.sessions.json", sessionsJson(sessions, "", ""))
    }
    var shares = new Map<String, ShareInfo>()
    var spath = "server-registry.shares.json"
    var load = shareLoadList(shares, spath)
    if (load.indexOf("REG041") == 0) {
        println(load)
        return 1
    }
    sharesPurgeExpired(shares, time.now())
    var controlKey = loadControlKey("server-control.ed25519")
    var accounts = new Map<String, Account>()
    var apath = "server-registry.accounts.json"
    var aload = authLoadList(accounts, apath)
    if (aload.indexOf("AUTH043") == 0) {
        println(aload)
        return 1
    }
    presenceMarkOfflineAll(presences, devices, time.now())
    // measured 04/10 (A6 golden): READY must never print before the bind
    // succeeds — a lying READY let an interrupted plane hijack the port and
    // the fresh bearer 401ed against the STALE process. Probe first.
    try {
        var probe = net.listen(port)
        probe.close()
    } catch (String e) {
        println("SERVER-ERR: control port " + port + " already bound: " + e)
        return 1
    }
    var controlSecret = loadControlSecret()
    bootstrapAdmin(accounts, apath, controlSecret)
    println("SERVER-READY port=" + port + " key=" + key + " devices=" + devices.size() + " offers=" + offers.size() + " shares=" + shares.size() + " accounts=" + accounts.size())
    controlServe(port, devices, offers,
        "server-registry.devices.json", "server-registry.offers.json",
        shares, spath, controlKey, accounts, apath, controlSecret,
        devkeys, "server-registry.devkeys.json", sessions, "server-registry.sessions.json",
        presences, "server-registry.presence.json")
    return 0
}

String loadControlSecret() {
    var f = File("server-control.apikey")
    if (f.exists()) {
        var txt = f.readText()
        if (txt != null && txt.length() >= 32) {
            var ok = auth.secret(txt)
            if (!ok) {
                println("SERVER-ERR: control secret rejected")
                return ""
            }
            return txt
        }
    }
    var fresh = security.apiKeyGenerate()
    if (!f.writeText(fresh)) {
        println("SERVER-ERR: cannot persist control secret")
        return ""
    }
    if (!auth.secret(fresh)) {
        println("SERVER-ERR: control secret rejected")
        return ""
    }
    return fresh
}

// C3 bootstrap (same law as server.kf): empty table mints an admin bearer,
// plaintext key lives in server-control.apikey (never printed, never logged).
void bootstrapAdmin(Map<String, Account> accounts, String apath, String controlSecret) {
    var hasActive = false
    var ids = accounts.keys()
    ids.sort()
    for (var id in ids) {
        var a: Account? = accounts.get(id)
        if (a != null && a.status == "active") {
            hasActive = true
        }
    }
    if (hasActive) {
        return
    }
    var r = authIssue(accounts, "admin", "owner", 1)
    if (r != "OK") {
        println("SERVER-ERR: admin bootstrap refused: " + r)
        return
    }
    controlSaveList(apath, authAccountsJson(accounts))
    var bearer = File("server-control.bearer")
    if (!bearer.writeText(authMint(controlSecret, "admin", "owner", 86400))) {
        println("SERVER-ERR: cannot persist admin bearer")
    }
}

Secret loadControlKey(String kpath) {
    var kf = File(kpath)
    if (kf.exists()) {
        var txt = kf.readText()
        if (txt == null) {
            throw "kofshare: unreadable control key " + kpath
        }
        return secrets.of(txt)
    }
    var fresh = keyExchange.privateKey("Ed25519")
    if (!kf.writeText(fresh.reveal())) {
        throw "kofshare: cannot persist control key " + kpath
    }
    return fresh
}


String localBearer() {
    var f = File("server-control.bearer")
    if (!f.exists()) {
        return ""
    }
    var t = f.readText()
    if (t == null) {
        return ""
    }
    return t
}

String bearerArg(List<String> rest, Int start) {
    var i = start
    while (i < rest.size) {
        if (rest.get(i) == "--bearer") {
            return argAt(rest, i + 1)
        }
        i = i + 1
    }
    return localBearer()
}

// C2 commands (vote D2=A): share/revoke/shares/authorize talk to the control
// plane over kof.http — the token never leaves the link; the GRANT response
// of /s/<token> is what the recipient feeds into `fetch` unchanged.
// ─── v2-Track I: the PRODUCT face ─────────────────────────────────────────
// One command per human intent, riding EVERY existing contract (upPublish/
// share mint/session/downAuto/serve — §16: the UX layer CONSUMES the
// protocol, never rewrites it). Internal names (resourceId, offerId,
// deviceId, bearer) never appear on the happy path; `--raw` restores the
// machine-readable UP-OK/SHARED lines for operators and goldens.

// Self-spawn config: CWD-relative file `kofshare-cli.config` with `jar=`
// (and optional `workdir=`). There is NO env/home primitive in Kof today —
// this is the honest, documented way the product face restarts itself.
String selfConfigPath() {
    if (File("kofshare-cli.config").exists()) {
        return "kofshare-cli.config"
    }
    return ""
}

String selfConfigField(String key) {
    var p = selfConfigPath()
    if (p.length() == 0) {
        return ""
    }
    var t = File(p).readText()
    if (t == null) {
        return ""
    }
    var lines = t.split("\n")
    var i = 0
    while (i < lines.size) {
        var ln = lines[i]
        if (ln.indexOf(key + "=") == 0) {
            return ln.substring(key.length() + 1, ln.length())
        }
        i = i + 1
    }
    return ""
}

String selfJar() {
    return selfConfigField("jar")
}

// LIVENESS by TCP connect, NOT http.get: the http module lets a raw
// java.net.ConnectException escape Kof's `catch (String e)` (measured this
// session; recorded as a runtime gap for upstream — the net module DOES wrap
// refusals into named String errors, so the port probe is the safe shape).
// hostOfBase/basePort split "http://h:p" by hand (no url parser in stdlib).
String baseHost(String base) {
    var cut = base.indexOf("//")
    var hp = base.substring(cut + 2, base.length())
    var colon = hp.indexOf(":")
    if (colon < 0) {
        return hp
    }
    return hp.substring(0, colon)
}

Int basePort(String base) {
    var cut = base.indexOf("//")
    var hp = base.substring(cut + 2, base.length())
    var colon = hp.indexOf(":")
    var rest = hp.substring(colon + 1, hp.length())
    var slash = rest.indexOf("/")
    if (slash >= 0) {
        rest = rest.substring(0, slash)
    }
    return math.parseInt(rest)
}

Bool healthNow(String base) {
    try {
        var c = net.connect(baseHost(base), basePort(base))
        c.close()
        return true
    } catch (String e) {
        return false
    }
}

Bool waitHealth(String base) {
    var t0 = 0
    while (t0 < 60) {
        if (healthNow(base)) {
            return true
        }
        time.sleep(250)
        t0 = t0 + 1
    }
    return false
}

// Detached helper process, same spawn/sh pattern the goldens proved — the
// face OUTLIVES the share command so the link keeps working after it exits.
Int spawnDetached(String log, List<String> verbArgs, String pidfile) {
    if (File(log).exists()) {
        File(log).delete()
    }
    var jar = selfJar()
    if (jar.length() == 0) {
        return 0 - 1
    }
    var wd = selfConfigField("workdir")
    if (wd.length() == 0) {
        wd = "."
    }
    var cmd = "cd " + wd + " && nohup java -jar " + jar
        + " run src/main/kof/kofshare/cli/cli.kf"
    for (var a in verbArgs) {
        cmd = cmd + " " + a
    }
    cmd = cmd + " > " + log + " 2>&1 & echo $! > " + pidfile
    process.spawn("sh", "-c", cmd)
    return 1
}

// Named internal codes stay INTACT (the goldens prove them); the hint only
// ADDS the human sentence. Pure, CHECK-leg green (§10).
String errText(String raw) {
    if (raw.indexOf("REG038") >= 0) {
        return "This link was already used and is spent. Ask for a new share link."
    }
    if (raw.indexOf("REG034") >= 0 || raw.indexOf("REG035") >= 0) {
        return "That link no longer exists on the plane — it expired or the file was un-shared. Ask for a new link."
    }
    if (raw.indexOf("DEV003") >= 0) {
        return "The sharer revoked this device. The transfer is closed by its owner — nothing more happens with this link."
    }
    if (raw.indexOf("DEV-OFFLINE") >= 0) {
        return "The sharer's device is offline right now. Ask them to run kofshare share again (it renews presence) — the link itself is still valid."
    }
    if (raw.indexOf("CONNECTIVITY_FAILED") >= 0) {
        return "No path to the other device: direct was refused and no relay was given. Ask the sharer for `--relay <host:port>` from a machine both sides can reach, and pass it to kofshare receive."
    }
    if (raw.indexOf("REG013") >= 0 || raw.indexOf("REG014") >= 0) {
        return "The resource identity does not check out (path-shaped or foreign id). This is refused by design — re-share the file from its own device."
    }
    if (raw.indexOf("REG015") >= 0 || raw.indexOf("REG016") >= 0) {
        return "The directory manifest did not match what the plane recomputes (traversal or digest mismatch). This is refused by design — re-share the folder."
    }
    if (raw.indexOf("AUTH001") >= 0 || raw.indexOf("AUTH") >= 0) {
        return "The control plane needs credentials. Run kofshare server first (it writes the bearer next to the registry), or pass --bearer."
    }
    if (raw.indexOf("UP-ERR") >= 0 || raw.indexOf("SHARE-ERR") >= 0) {
        return "The plane refused the publish/share step. Check the server is up (kofshare server) and retry; the line above keeps the exact reason."
    }
    return ""
}

Long parseTtlMs(String v) {
    var digits = ""
    var i = 0
    while (i < v.length()) {
        var ch = v.charAt(i)
        if (ch >= 48 && ch <= 57) {
            digits = digits + v.substring(i, i + 1)
        }
        i = i + 1
    }
    // BARE NUMBER = MILLISECONDS (the legacy `--ttl <ms>` meaning is kept);
    // suffixes s/m/h/d are the human lane.
    var mult = 1
    if (v.indexOf("ms") == v.length() - 2) {
        mult = 1
    } else if (v.indexOf("s") == v.length() - 1) {
        mult = 1000
    } else if (v.indexOf("m") == v.length() - 1) {
        mult = 60000
    } else if (v.indexOf("h") == v.length() - 1) {
        mult = 3600000
    } else if (v.indexOf("d") == v.length() - 1) {
        mult = 86400000
    }
    if (digits.length() == 0) {
        return 0 - 0
    }
    return math.parseLong(digits) * mult
}

String fieldOf(String msg, String key) {
    var i = msg.indexOf(key)
    if (i < 0) {
        return ""
    }
    var st = i + key.length()
    var en = msg.indexOf(" ", st)
    if (en < 0) {
        en = msg.length()
    }
    return msg.substring(st, en)
}

Int cliRunShareSimple(List<String> args) {
    // ONE human surface around the operator primitives: named internal errors
    // stay VISIBLE (codes are not removed — §10) and only ADD the guidance
    // line; the stack trace never reaches a first-time user.
    try {
        return shareProduct(args)
    } catch (String err) {
        println(err)
        var hint = errText(err)
        if (hint.length() > 0) {
            println("Hint: " + hint)
        }
        return 1
    }
}

Int shareProduct(List<String> args) {
    var rest = tail(args, 1)
    var path = rest.get(0)
    var host = "127.0.0.1"
    var port = defaultControlPort() + 1
    var facePort = 0
    var faceHost = "127.0.0.1"
    var once = false
    var readOnly = false
    var dirShare = false
    var raw = false
    var ttlMs: Long = 86400000
    var i = 1
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--server") {
            var hv = argAt(rest, i + 1)
            var colon = hv.lastIndexOf(":")
            if (colon > 0) {
                host = hv.substring(0, colon)
                port = math.parseInt(hv.substring(colon + 1, hv.length()))
            }
            i = i + 2
        } else if (a == "--once") {
            once = true
            i = i + 1
        } else if (a == "--read-only") {
            readOnly = true
            i = i + 1
        } else if (a == "--dir") {
            dirShare = true
            i = i + 1
        } else if (a == "--raw") {
            raw = true
            i = i + 1
        } else if (a == "--ttl" || a == "--expires") {
            ttlMs = parseTtlMs(argAt(rest, i + 1))
            i = i + 2
        } else if (a == "--face") {
            facePort = math.parseInt(argAt(rest, i + 1))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    var isDir = File(path).isDirectory()
    if (!File(path).exists()) {
        println("Nothing to share: " + path + " is not a file or directory here.")
        return 1
    }
    if (isDir) {
        dirShare = true
    }
    if (facePort == 0) {
        facePort = defaultControlPort() + 78
    }
    var base = "http://" + host + ":" + port
    if (!healthNow(base)) {
        println("KofShare needs a control plane, and none answered on " + base + ".")
        println("  Start one (this machine):  kofshare server " + (defaultControlPort() + 1) + " --start")
        println("  Or point elsewhere:         kofshare share " + path + " --server <host:port>")
        println("SERVER-UNREACHABLE " + base)
        return 1
    }
    var bearer = "Authorization: Bearer " + bearerArg(rest, 1)
    var sk = identityBoot("kofshare-device.ed25519")
    var serveAddr = faceHost + ":" + facePort
    var upOut = ""
    var offerId = ""
    if (dirShare) {
        upOut = upPublishDir(base, sk, serveAddr, path, bearer)
    } else {
        upOut = upPublishSigned(base, sk, resourceName(path), serveAddr, path, bearer)
    }
    if (!raw) {
        if (dirShare) {
            var fc = fieldOf(upOut, "files=")
            var es = fieldOf(upOut, "entries=")
            println("Sharing directory: " + resourceName(path) + "/")
            println("  Files: " + fc + "   Manifest entries: " + es)
        } else {
            println("Sharing file: " + resourceName(path) + " (" + File(path).size() + " bytes)")
        }
    } else {
        println(upOut)
    }
    offerId = fieldOf(upOut, "offer=")
    var req = ShareRequest(offerId, ttlMs, 0, readOnly, dirShare)
    if (once) {
        req = ShareRequest(offerId, ttlMs, 1, readOnly, dirShare)
    }
    var resp = http.post(base + "/shares", json.encode(req), bearer)
    if (resp == null || resp.indexOf("SHARED ") != 0) {
        println(resp)
        var hint = errText("" + resp)
        if (hint.length() > 0) {
            println("Hint: " + hint)
        }
        return 1
    }
    var token = resp.split(" ")[2]
    if (raw) {
        println(resp)
        println("SHARE-LINK " + base + "/s/" + token)
    }
    // ONE active offer per device: replace the previous face BEFORE binding
    // (share twice, serve the second — the port must not EADDRINUSE-fail
    // silently in nohup).
    stopHelper("kofshare-face.pid")
    freePort(facePort)
    var faceArgs = new List<String>()
    if (dirShare) {
        faceArgs.add("serve-dir")
        faceArgs.add(path)
        faceArgs.add("" + facePort)
        faceArgs.add(defaultKey())
        faceArgs.add("--loop")
    } else {
        faceArgs.add("serve")
        faceArgs.add(path)
        faceArgs.add("" + facePort)
        faceArgs.add("--key")
        faceArgs.add(defaultKey())
        faceArgs.add("--loop")
    }
    faceArgs.add("--server")
    faceArgs.add(host + ":" + port)
    var sp = spawnDetached("kofshare-face.log", faceArgs, "kofshare-face.pid")
    if (!raw) {
        println("")
        println("Link (copy and send):")
        println("  " + base + "/s/" + token)
        println("")
        if (once) {
            println("This link works ONCE. It expires in " + ttlLabel(ttlMs) + ".")
        } else {
            println("The link expires in " + ttlLabel(ttlMs) + ".")
        }
        if (sp >= 0) {
            println("Your device is now offering the transfer (port " + facePort + ").")
        } else {
            println("NOTE: could not start the offering helper (no kofshare-cli.config with jar=) —")
            println("      run `serve` yourself on port " + facePort + " so the recipient can dial in.")
        }
        println("To stop offering: kofshare stop")
    }
    return 0
}

String ttlLabel(Long ms) {
    if (ms % 86400000 == 0) {
        return "" + (ms / 86400000) + " day(s)"
    }
    if (ms % 3600000 == 0) {
        return "" + (ms / 3600000) + " hour(s)"
    }
    if (ms % 60000 == 0) {
        return "" + (ms / 60000) + " minute(s)"
    }
    return "" + (ms / 1000) + " second(s)"
}

Int cliRunReceive(List<String> args) {
    try {
        return receiveProduct(args)
    } catch (String err) {
        println(err)
        var hint = errText(err)
        if (hint.length() > 0) {
            println("Hint: " + hint)
        }
        return 1
    }
}

Int receiveProduct(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 1) {
        println("RECEIVE-ERR: usage: receive <link> [dest] [--browser] [--server host:port] [--relay host:port] [--key <hex>]")
        return 1
    }
    var link = rest.get(0)
    var cut = link.indexOf("/s/")
    if (cut < 0) {
        println("RECEIVE-ERR: that is not a kofshare link (expected .../s/<token>): " + link)
        return 1
    }
    var base = link.substring(0, cut)
    var token = link.substring(cut + 3, link.length())
    var sp = token.indexOf("/")
    if (sp >= 0) {
        token = token.substring(0, sp)
    }
    if (token.length() == 0) {
        println("RECEIVE-ERR: empty token in link")
        return 1
    }
    var key = defaultKey()
    var relayHost = ""
    var relayPort = 0
    var browser = false
    var dest = ""
    var i = 1
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--key") {
            key = argAt(rest, i + 1)
            i = i + 2
        } else if (a == "--relay") {
            var rp = argAt(rest, i + 1)
            var colon = rp.lastIndexOf(":")
            relayHost = rp.substring(0, colon)
            relayPort = math.parseInt(rp.substring(colon + 1, rp.length()))
            i = i + 2
        } else if (a == "--browser") {
            browser = true
            i = i + 1
        } else {
            dest = a
            i = i + 1
        }
    }
    if (!healthNow(base)) {
        println("The plane behind that link did not answer (" + base + ").")
        println("Hint: " + errText("SERVER-UNREACHABLE"))
        println("SERVER-UNREACHABLE " + base)
        return 1
    }
    var grantRaw = http.get(base + "/s/" + token, "")
    if (grantRaw.indexOf("{") != 0) {
        println("The link refused: " + grantRaw)
        var hint = errText(grantRaw)
        if (hint.length() > 0) {
            println("Hint: " + hint)
        }
        return 1
    }
    var g = json.decode<ShareGrant>(grantRaw)
    if (dest.length() == 0) {
        dest = g.name
    }
    // NOTE: this resolve ALREADY spent one use (shareTouch law) — the
    // download paths below take the PRE-RESOLVED grant; resolving /s a
    // second time would double-consume `--once` (Track I golden caught it).
    if (browser) {
        var cargs = new List<String>()
        cargs.add("app")
        var pc = base.lastIndexOf(":")
        cargs.add(base.substring(pc + 1, base.length()))
        cargs.add("19555")
        cargs.add(token)
        cargs.add(key)
        cargs.add(dest)
        spawnDetached("kofshare-app.log", cargs, "kofshare-app.pid")
        println("Local page started. Open http://127.0.0.1:19555 (this machine only) —")
        println("the page shows the file and downloads it through THIS device.")
        return 0
    }
    println("Downloading " + g.name + " ...")
    if (g.type == "DIRECTORY") {
        var out = downDirAutoWithGrant(base, token, g, dest, key, "Authorization: Bearer " + bearerArg(rest, 1),
            identityDeviceId(identityPub(identityBoot("kofshare-device.ed25519"))), relayHost, relayPort)
        println(out)
        return 0
    }
    var msg = downAutoWithGrant(base, token, g, dest, key, "Authorization: Bearer " + bearerArg(rest, 1),
        identityDeviceId(identityPub(identityBoot("kofshare-device.ed25519"))), relayHost, relayPort)
    println(msg)
    var hint = errText(msg)
    if (hint.length() > 0) {
        println("Hint: " + hint)
    }
    return 0
}

// A nohup'd helper whose pidfile was overwritten can ORPHAN its port (two
// faces, one bind — measured in the Track I golden: the stale face served
// the WRONG bytes). Replacement therefore: kill the recorded pid AND
// force the port bindable again by name (same ss-sweep law as the goldens).
Bool freePort(Int port) {
    var t0 = 0
    while (t0 < 40) {
        var bindable = false
        try {
            var pr = net.listen(port)
            pr.close()
            bindable = true
        } catch (String e) {
            bindable = false
        }
        if (bindable) {
            return true
        }
        var res = shell.run("ss", listOf("-tlnp"))
        var lines = res.stdout.split("\n")
        var i = 0
        while (i < lines.size) {
            var line = lines[i]
            if (line.indexOf("LISTEN") >= 0 && line.indexOf(":" + port) >= 0) {
                var pi = line.indexOf("pid=")
                if (pi >= 0) {
                    var num = ""
                    var j = pi + 4
                    while (j < line.length()) {
                        var ch = line.charAt(j)
                        if (ch < 48 || ch > 57) {
                            break
                        }
                        num = num + line.substring(j, j + 1)
                        j = j + 1
                    }
                    if (num.length() > 0) {
                        shell.run("kill", listOf("-9", num))
                    }
                }
            }
            i = i + 1
        }
        time.sleep(250)
        t0 = t0 + 1
    }
    return false
}

void stopHelper(String pidfile) {
    if (!File(pidfile).exists()) {
        return
    }
    // COALESCE before use: the nullable readText result threaded through the
    // guard into a call argument crashes the JVM backend (COMP002 — same
    // shape as the T? parameter bug; fresh local after the guard is the
    // compiling shape).
    var pid = ""
    var raw = File(pidfile).readText()
    if (raw != null) {
        pid = raw
    }
    pid = "" + pid
    var cut = pid.indexOf("\n")
    if (cut >= 0) {
        pid = pid.substring(0, cut)
    }
    if (pid.length() > 0) {
        shell.run("kill", listOf(pid))
    }
    File(pidfile).delete()
}

Int cliRunStop(List<String> args) {
    var killed = 0
    for (var pf in listOf("kofshare-face.pid", "kofshare-app.pid", "kofshare-server.pid")) {
        if (File(pf).exists()) {
            killed = killed + 1
            stopHelper(pf)
        }
    }
    println("Stopped " + killed + " helper process(es). Links that were already used stay consumed on the plane.")
    return 0
}

Int runShare(List<String> args) {
    var rest = tail(args, 1)
    // v2-Track I routing rule: a PATH first argument is the product lane
    // (`share ./file`); a HOST first argument stays the operator lane
    // (`share <host> <port> <offerId>`, byte-for-byte the old contract).
    if (rest.size >= 1) {
        var first = rest.get(0)
        if (first.indexOf("./") == 0 || first.indexOf("/") == 0 || first.indexOf("~") == 0
            || File(first).exists()) {
            return cliRunShareSimple(args)
        }
    }
    if (rest.size < 3) {
        println("SHARE-ERR: usage: share <host> <port> <offerId> [--once] [--read-only] [--ttl <ms>]")
        return 1
    }
    var req = ShareRequest(rest.get(2), 0, 0, false, false)
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--once") {
            req = ShareRequest(req.offerId, req.ttlMs, 1, req.readOnly, false)
            i = i + 1
        } else if (a == "--read-only") {
            req = ShareRequest(req.offerId, req.ttlMs, req.maxUses, true, false)
            i = i + 1
        } else if (a == "--ttl") {
            req = ShareRequest(req.offerId, req.ttlMs + ttlOf(argAt(rest, i + 1)), req.maxUses, req.readOnly, false)
            i = i + 2
        } else {
            i = i + 1
        }
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    var bearer = "Authorization: Bearer " + bearerArg(rest, 3)
    var resp = http.post(base + "/shares", json.encode(req), bearer)
    if (resp == null) {
        println("SHARE-ERR: control plane unreachable")
        return 1
    }
    if (resp.indexOf("SHARED ") != 0) {
        println(resp)
        return 1
    }
    var parts = resp.split(" ")
    println("SHARE-LINK " + base + "/s/" + parts[2])
    println("SHARE-ID " + parts[1])
    return 0
}

Long ttlOf(String s) {
    return math.parseLong(s)
}

Int runRevoke(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("REVOKE-ERR: usage: revoke <host> <port> <shareId> [reason]")
        return 1
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    var reason = "manual"
    if (rest.size > 3) {
        reason = rest.get(3)
    }
    var rb = "Authorization: Bearer " + bearerArg(rest, 4)
    var resp = http.post(base + "/shares/" + rest.get(2) + "/revoke?reason=" + reason, "", rb)
    if (resp == null) {
        println("REVOKE-ERR: control plane unreachable")
        return 1
    }
    println(resp)
    if (resp.indexOf("SHARE-REVOKED") == 0) {
        return 0
    }
    return 1
}

Int runShares(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 2) {
        println("SHARES-ERR: usage: shares <host> <port>")
        return 1
    }
    var sb = "Authorization: Bearer " + bearerArg(rest, 2)
    var body = http.get("http://" + rest.get(0) + ":" + rest.get(1) + "/shares", sb)
    if (body == null) {
        println("SHARES-ERR: control plane unreachable")
        return 1
    }
    println(body)
    return 0
}

Int runAuthorize(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("AUTH-ERR: usage: authorize <host> <port> <token>")
        return 1
    }
    var body = http.get("http://" + rest.get(0) + ":" + rest.get(1) + "/s/" + rest.get(2))
    if (body == null) {
        println("AUTH-ERR: control plane unreachable")
        return 1
    }
    println(body)
    if (body.indexOf("REG") == 0) {
        return 1
    }
    return 0
}

Int runOffer(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 1) {
        println("OFFER-ERR: usage: offer <file>")
        return 1
    }
    var out = offerJson(argAt(rest, 0))
    println(out)
    if (out.startsWith("OFFER-ERR")) {
        return 1
    }
    return 0
}

// ── tiny List helpers (no new stdlib face) ──

List<String> tail(List<String> xs, Int from) {
    var out = listOf()
    var i = from
    while (i < xs.size) {
        out.add(xs.get(i))
        i = i + 1
    }
    return out
}

String argAt(List<String> xs, Int i) {
    if (i < 0 || i >= xs.size) {
        return ""
    }
    return xs.get(i)
}

Boolean isDigits(String s) {
    if (s.length == 0) {
        return false
    }
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < '0' || c > '9') {
            return false
        }
        i = i + 1
    }
    return true
}

main(args: List<String>) {
    // Accept both `run cli.kf --target jvm --check` and the explicit
    // `run cli.kf --target jvm -- --check` (the latter yields a leading "--").
    var start = 0
    if (args.size > 0 && args.get(0) == "--") {
        start = 1
    }
    if (args.size <= start) {
        println("USAGE: kofshare server [port] [--key <hex>] | offer <file> | fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>] | relay <port> <peerHost> <peerPort> [--tamper] | --check | --dry")
        return
    }
    var cmd = args.get(start)
    if (cmd == "--check") {
        var rc = runCheck()
        if (rc != 0) {
            throw "kofshare: CHECK-FAIL"
        }
        return
    }
    if (cmd == "--dry") {
        runDry()
        return
    }
    if (cmd == "server") {
        runServer(tail(args, start))
        return
    }
    if (cmd == "offer") {
        var rc = runOffer(tail(args, start))
        if (rc != 0) {
            throw "kofshare: OFFER-ERR"
        }
        return
    }
    if (cmd == "fetch") {
        var rc = runFetch(tail(args, start))
        if (rc != 0) {
            throw "kofshare: FETCH-ERR"
        }
        return
    }
    if (cmd == "serve") {
        var rc = runServe(tail(args, start))
        if (rc != 0) {
            throw "kofshare: SERVE-ERR"
        }
        return
    }
    if (cmd == "receive") {
        cliRunReceive(tail(args, start))
        // Track I: product verbs RETURN — a refused link must not spray a
        // stack trace at a first-time user (§10). Operator lanes keep the
        // throw style; the human line already named the reason.
        return
    }
    if (cmd == "stop") {
        cliRunStop(tail(args, start))
        return
    }
    if (cmd == "updir") {
        var rcu = runUpDir(tail(args, start))
        if (rcu != 0) {
            throw "kofshare: UP-ERR"
        }
        return
    }
    if (cmd == "downdir") {
        var rcd = runDownDir(tail(args, start))
        if (rcd != 0) {
            throw "kofshare: DOWN-ERR"
        }
        return
    }
    if (cmd == "serve-dir") {
        var rcs = runServeDir(tail(args, start))
        if (rcs != 0) {
            throw "kofshare: SERVE-ERR"
        }
        return
    }
    if (cmd == "up") {
        var rc = runUp(tail(args, start))
        if (rc != 0) {
            throw "kofshare: UP-ERR"
        }
        return
    }
    if (cmd == "down") {
        var rc = runDown(tail(args, start))
        if (rc != 0) {
            throw "kofshare: DOWN-ERR"
        }
        return
    }
    if (cmd == "heartbeat") {
        var rc = runHeartbeat(tail(args, start))
        if (rc != 0) {
            throw "kofshare: HEARTBEAT-ERR"
        }
        return
    }
    if (cmd == "app") {
        var rc = cliRunApp(tail(args, start))
        if (rc != 0) {
            throw "kofshare: APP-ERR"
        }
        return
    }
    if (cmd == "device") {
        var rc = runDevice(tail(args, start))
        if (rc != 0) {
            throw "kofshare: DEVICE-ERR"
        }
        return
    }
    if (cmd == "account") {
        var rc = runAccount(tail(args, start))
        if (rc != 0) {
            throw "kofshare: CMD-ERR account"
        }
        return
    }
    if (cmd == "share" || cmd == "revoke" || cmd == "shares" || cmd == "authorize") {
        var rc = 1
        var product = false
        if (cmd == "share") {
            // v2-Track I: the product lane prints human guidance (and its
            // named marker) and returns QUIETLY — a first-time user must
            // never see a stack. The operator lane keeps the throw style.
            var srest = tail(args, start)
            // srest[0] IS the "share" token (verb functions tail(1) it
            // themselves) — the path is srest[1].
            if (srest.size >= 2) {
                var sfirst = srest.get(1)
                product = sfirst.indexOf("./") == 0 || sfirst.indexOf("/") == 0
                    || sfirst.indexOf("~") == 0 || File(sfirst).exists()
            }
            rc = runShare(srest)
            if (product) {
                return
            }
        } else if (cmd == "revoke") {
            rc = runRevoke(tail(args, start))
        } else if (cmd == "shares") {
            rc = runShares(tail(args, start))
        } else {
            rc = runAuthorize(tail(args, start))
        }
        if (rc != 0) {
            throw "kofshare: CMD-ERR " + cmd
        }
        return
    }
    if (cmd == "relay") {
        var rc = runRelay(tail(args, start))
        if (rc != 0) {
            throw "kofshare: RELAY-ERR"
        }
        return
    }
    println("UNKNOWN-COMMAND: " + cmd)
}
