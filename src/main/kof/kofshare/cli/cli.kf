package kofshare.cli

import kofshare.transfer
import kofshare.domain
import kofshare.control.registry
import kofshare.control.app
import kofshare.control.share
import kofshare.control.auth
import kof.http
import kof.time
import kofshare.session
import kofshare.protocol
import kofshare.relay
import kof.json
import kof.crypto
import kof.keyExchange
import kof.secrets
import kof.security
import kof.auth
import kof.jwt

// KofShare product entry (implementation-plan.md §2 slice 3). Commands:
//   server [port] [--key <hex>]  control plane: serves offers over web.app()
//   offer <file>                 digest a file into an OfferInfo JSON record
//   fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure]
//                                [--relay <rhost> <rport>]
//                                pull an offer over kof.net into <dest>
//   relay <port> <peerHost> <peerPort> [--tamper]
//                                ciphertext-only relay for one session
//   --check                      full product golden (registry + plain +
//                                secure envelope legs), prints CHECK-OK
//   --dry                        resolve the transfer PLAN only, no sockets
//
// The registry verbs are the slice-1 pure domain; the transport is the
// slice-2 control surface; the transfer is the measured kof.net core. No
// new stdlib face is invented here (D-KOFSHARE-100KOF).

Int defaultControlPort() {
    return 18322
}

Int checkPortPlain() {
    return 19321
}

Int checkPortSecure() {
    return 19322
}

Int checkResumePlain() {
    return 100000
}

Int checkResumeSecure() {
    return 123456
}

String defaultKey() {
    return "kofshare-cli-key"
}

// File bytes (Int[] 0..255) → the wire Byte[] the digest/net faces take.
Byte[] toBytes(Int[] src) {
    var out = new Byte[src.size]
    var i = 0
    while (i < src.size) {
        var v = src[i]
        if (v < 0) {
            v = v + 256
        }
        out[i] = v
        i = i + 1
    }
    return out
}

// Deterministic 200000-byte source for the `--check` legs (same generator as
// the e2e oracle, kept local so the product entry owns no e2e main()).
Int[] makeSource() {
    var n = 200000
    var a = new Int[n]
    var i = 0
    while (i < n) {
        a[i] = (i * 7 + 3) % 256
        i = i + 1
    }
    return a
}

Int[] prefix(Int[] src, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = src[i]
        i = i + 1
    }
    return out
}

// `offer <file>` — real content digest (sha256Bytes over the file bytes).
String offerJson(String path) {
    if (!File(path).exists()) {
        return "OFFER-ERR: file not found: " + path
    }
    var data = File(path).readBytes()
    if (data.size == 0) {
        return "OFFER-ERR: empty file: " + path
    }
    var digest = crypto.sha256Bytes(toBytes(data))
    var o = OfferRequest("o-" + digest.substring(0, 12), "local", path, data.size, digest)
    return json.encode(o)
}

// `--check` leg 1 — the pure registry golden (no IO).
Boolean persistLeg() {
    var dp = "check-persist.devices.json"
    var op = "check-persist.offers.json"
    persistClean(dp)
    persistClean(op)
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    var ok = controlRegister(devices, DeviceInfo("d9", "persist", "127.0.0.1:8021")) == "OK"
    ok = ok && (controlSaveList(dp, controlDevicesJson(devices)) == "OK")
    var reload = new Map<String, DeviceInfo>()
    ok = ok && (controlLoadList(dp, reload, null) == "OK")
    ok = ok && (controlDevicesJson(reload) == controlDevicesJson(devices))
    var junk = "check-persist.junk.json"
    File(junk).writeText("nope")
    ok = ok && controlLoadList(junk, new Map<String, DeviceInfo>(), null).startsWith("REG009:")
    persistClean(junk)
    persistClean(dp)
    persistClean(op)
    return ok
}

void persistClean(String path) {
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
}

Boolean registryLeg() {
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    var ok = controlRegister(devices, DeviceInfo("d1", "alpha", "192.168.1.10:8021")) == "OK"
    ok = ok && (controlRegister(devices, DeviceInfo("", "x", "1.2.3.4:1")) == "REG001: empty device id")
    var d1 = controlResolve(devices, "d1")
    ok = ok && (d1 != null && d1.name == "alpha")
    var dig = crypto.sha256("/srv/a.bin")
    ok = ok && (controlOffer(offers, devices, OfferInfo("o1", "d1", "/srv/a.bin", 2048, dig, 1789000000000)) == "OK")
    var back = controlResolveOffer(offers, "o1")
    ok = ok && (back != null && back.size == 2048 && back.deviceId == "d1")
    ok = ok && (controlRevoke(offers, "o1") == "OK")
    ok = ok && (controlResolveOffer(offers, "o1") == null)
    return ok
}

// `--check` leg 2 — the plain transfer core (resume@100000, real kof.net
// loopback), byte-for-byte + session Done.
Boolean plainLeg() {
    var src = "cli-check-src.bin"
    var dst = "cli-check-dst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, checkResumePlain()))
    var l = net.listen(checkPortPlain())
    var worker = spawn {
        var s = l.accept()
        serveFile(s, src, checkResumePlain(), "k0")
        s.close()
    }
    var c = net.connect("127.0.0.1", checkPortPlain())
    var t = fetchFile(c, dst, checkResumePlain(), "check-plain", "devA", "k0")
    c.close()
    await worker
    l.close()
    var a = File(src).readBytes()
    var b = File(dst).readBytes()
    var ok = (t.state == SessionState.Done) && (a.size == b.size) && (firstMismatch(a, b) < 0)
    File(src).delete()
    File(dst).delete()
    return ok
}

// `--check` leg 3 — the secure envelope (resume@123456): X25519 + HKDF
// direction keys, encrypt-then-MAC, byte-for-byte + session Done.
Boolean secureLeg() {
    var src = "cli-check-sec-src.bin"
    var dst = "cli-check-sec-dst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, checkResumeSecure()))
    var l = net.listen(checkPortSecure())
    var worker = spawn {
        var sv = l.accept()
        var privS = keyExchange.privateKey()
        serveFileSecure(sv, src, checkResumeSecure(), privS, security.randomHex(16))
        sv.close()
    }
    var c = net.connect("127.0.0.1", checkPortSecure())
    var privC = keyExchange.privateKey()
    var hs = fetchHandshake(c, privC)
    var t = fetchFileSecure(c, dst, checkResumeSecure(), "check-sec", "devB", hs.get(4), hs.get(5))
    c.close()
    var out = File(dst).readBytes()
    var ok = (t.state == SessionState.Done) && (out.size == data.size) && (firstMismatch(out, data) < 0)
    // directions must be distinct: encTx != encRx and macTx != macRx
    ok = ok && (hs.get(2) != hs.get(4)) && (hs.get(3) != hs.get(5))
    await worker
    l.close()
    File(src).delete()
    File(dst).delete()
    return ok
}

// `--check` — the one command that shows the whole product green.
Int runCheck() {
    var reg = registryLeg()
    var plain = plainLeg()
    var secure = secureLeg()
    var persist = persistLeg()
    println("registry=" + reg)
    println("persist=" + persist)
    println("plain=" + plain)
    println("secure=" + secure)
    var share = shareLeg()
    println("share=" + share)
    var auth = authLeg()
    println("auth=" + auth)
    var resume = resumeLeg()
    println("resume=" + resume)
    if (reg && persist && plain && secure && share && auth && resume) {
        println("CHECK-OK")
        return 0
    }
    println("CHECK-FAIL")
    return 1
}

// `--check` leg 4 — the C2 share model (pure domain + C1 signature face).
// issue/touch/exhaust/revoke/expired/purge + sign/verify/tamper, all by NAME.
Bool shareLeg() {
    var now = 1000
    var sk = keyExchange.privateKey("Ed25519")
    var pub = keyExchange.publicKey(sk)
    var shares = new Map<String, ShareInfo>()
    var ok = true
    ok = ok && (shareIssue(shares, ShareInfo("s1", tokenOf("11"), "d1", "o1", "read", now, now + 10, 1, 0, "active", "", "")) == "OK")
    var core = shareResolve(shares, tokenOf("11"))
    if (core == null) {
        return false
    }
    var st = shareSign(sk, core)
    var signed = ShareInfo(core.id, core.token, core.deviceId, core.offerId, core.permissions, core.createdAt, core.expiresAt, core.maxUses, core.used, core.status, core.revocation, st)
    shares.put("s1", signed)
    ok = ok && shareVerify(secrets.of(pub), signed)
    ok = ok && shareTouch(shares, signed.token, now) == "OK"
    ok = ok && shareTouch(shares, signed.token, now + 1) == "REG038: share exhausted"
    ok = ok && shareRevoke(shares, "s1", "check") == "OK"
    ok = ok && shareTouch(shares, signed.token, now + 2) == "REG036: share revoked"
    ok = ok && shareResolve(shares, tokenOf("ff")) == null
    ok = ok && sharesPurgeExpired(shares, now + 999) == 1
    return ok
}


Int runAccount(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("ACCOUNT-ERR: usage: account <host> <port> list | account <host> <port> add <id> <label> | account <host> <port> revoke <id>")
        return 1
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    var sub = rest.get(2)
    var bearer = "Authorization: Bearer " + bearerArg(rest, 3)
    if (sub == "list") {
        var body = http.get(base + "/accounts", bearer)
        if (body == null) {
            println("ACCOUNT-ERR: control plane unreachable")
            return 1
        }
        println(body)
        return 0
    }
    if (sub == "add" && args.size >= 5) {
        var resp = http.post(base + "/accounts", json.encode(AccountRequest(rest.get(3), rest.get(4), 0)), bearer)
        if (resp == null) {
            println("ACCOUNT-ERR: control plane unreachable")
            return 1
        }
        println(resp)
        return 0
    }
    if (sub == "revoke" && args.size >= 4) {
        var resp = http.post(base + "/accounts/" + rest.get(3) + "/revoke", "", bearer)
        if (resp == null) {
            println("ACCOUNT-ERR: control plane unreachable")
            return 1
        }
        println(resp)
        return 0
    }
    println("ACCOUNT-ERR: unknown subcommand " + sub)
    return 1
}

String tokenOf(String seed) {
    var s = seed
    while (s.length < 64) {
        s = s + "0"
    }
    return s.substring(0, 64)
}

// `--check` leg 5 — the C3 bearer model (pure): issue/identity/revocation
// matrix + JWT mint/verify/parse round-trip (jwt over the control secret);
// corrupt load refuses by name. The wire-level gate is httpcheck's job.
// `--check` leg 7 — A3 resume negotiation, pure matrix (Script-safe; the
// wire refusal cases live in `resumecheck/checkresume.kf`, JVM goldens).
Bool resumeLeg() {
    var ok = true
    ok = ok && (resumeVerify(0, 5000) == "OK")
    ok = ok && (resumeVerify(2000, 5000) == "OK")
    ok = ok && (resumeVerify(5000, 5000) == "OK")
    ok = ok && (resumeVerify(6000, 5000) == "RESUME-ERR: server file shorter than requested offset")
    ok = ok && (resumeVerify(0 - 1, 5000) == "RESUME-ERR: negative offset")
    ok = ok && (helloIndex() == 1073741822)
    ok = ok && (resumeErrIndex() == 1073741821)
    return ok
}

Bool authLeg() {
    var accounts = new Map<String, Account>()
    var ok = true
    ok = ok && (authIssue(accounts, "a1", "alpha", 1) == "OK")
    ok = ok && (authIssue(accounts, "a1", "dup", 2) == "AUTH005: duplicate account id a1")
    ok = ok && (authIssue(accounts, "", "x", 2) == "AUTH005: empty account id")
    ok = ok && (authIssue(accounts, "a2", "", 2) == "AUTH004: empty account label")
    var secret = security.apiKeyGenerate()
    var token = authMint(secret, "a1", "alpha", 60)
    ok = ok && (token.length() > 0)
    var verified = jwt.verify(token, secret)
    ok = ok && (verified.length() > 0)
    var sub = authParseSub(verified)
    ok = ok && (sub == "a1")
    ok = ok && (authActive(accounts, sub) == "OK")
    ok = ok && (authActive(accounts, "ghost") == "AUTH006: unknown account ghost")
    ok = ok && (authActive(accounts, "") == "AUTH002: bearer has no identity")
    ok = ok && (authRevoke(accounts, "a1") == "OK")
    ok = ok && (authActive(accounts, "a1") == "AUTH003: revoked")
    ok = ok && (authParseSub("not json") == "")
    var apath = "check-auth.accounts.json"
    var f0 = File(apath)
    if (f0.exists()) {
        f0.delete()
    }
    ok = ok && (controlSaveList(apath, authAccountsJson(accounts)) == "OK")
    var acc2 = new Map<String, Account>()
    ok = ok && (authLoadList(acc2, apath) == "OK")
    ok = ok && (authAccountsJson(acc2) == authAccountsJson(accounts))
    if (f0.exists()) {
        f0.delete()
    }
    var jf = File("check-auth.junk.json")
    jf.writeText("{ not json")
    var acc3 = new Map<String, Account>()
    ok = ok && (authLoadList(acc3, "check-auth.junk.json").indexOf("AUTH043") == 0)
    jf.delete()
    return ok
}

// `--dry` — print the resolved product plan, no IO. Deterministic.
Int runDry() {
    println("DRY-PLAN commands:")
    println("  server [port] [--key <hex>]  -> control plane web.app() on port " + defaultControlPort())
    println("  offer <file>                 -> OfferInfo JSON (sha256Bytes over the file)")
    println("  fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>] -> kof.net pull")
    println("  relay <port> <peerHost> <peerPort> [--tamper] -> ciphertext-only relay")
    println("  share <host> <port> <offerId> [--once] [--read-only] [--ttl <ms>] -> mint grant")
    println("  revoke <host> <port> <shareId> [reason] | shares <host> <port>")
    println("  authorize <host> <port> <token> -> GET /s/<token> (grant JSON or REG refusal)")
    println("  --check                      -> registry + plain port=" + checkPortPlain()
        + " resume=" + checkResumePlain() + " + secure port=" + checkPortSecure()
        + " resume=" + checkResumeSecure())
    println("DRY-OK")
    return 0
}

// `fetch` — real transfer from a serving peer. `--resume <n>` appends to a
// partial file; `--key <hex>` must match the peer's key; `--secure` uses the
// X25519/HKDF envelope; `--relay <host> <port>` routes through the
// ciphertext-only relay (slice 5). Without `--relay` the client connects
// directly to the peer.
Int runFetch(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("FETCH-ERR: usage: fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>]")
        return 1
    }
    var host = argAt(rest, 0)
    var port = math.parseInt(argAt(rest, 1))
    var dest = argAt(rest, 2)
    var resume = 0
    var key = defaultKey()
    var secure = false
    var relayed = false
    var relayHost = ""
    var relayPort = 0
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--resume") {
            var nxt = argAt(rest, i + 1)
            if (isDigits(nxt)) {
                resume = math.parseInt(nxt)
                i = i + 2
            } else {
                // bare --resume: continue from what the .part already holds
                if (File(dest).exists()) {
                    resume = File(dest).size() as Int
                }
                i = i + 1
            }
        } else {
            if (a == "--key") {
                key = argAt(rest, i + 1)
                i = i + 2
            } else {
                if (a == "--secure") {
                    secure = true
                    i = i + 1
                } else {
                    if (a == "--relay") {
                        relayed = true
                        relayHost = argAt(rest, i + 1)
                        relayPort = math.parseInt(argAt(rest, i + 2))
                        i = i + 3
                    } else {
                        i = i + 1
                    }
                }
            }
        }
    }
    var hostToUse = host
    var portToUse = port
    if (relayed) {
        hostToUse = relayHost
        portToUse = relayPort
    }
    var c = net.connect(hostToUse, portToUse)
    var t: Transfer
    if (secure) {
        var privC = keyExchange.privateKey()
        var hs = fetchHandshake(c, privC)
        t = fetchFileSecure(c, dest, resume, "cli-fetch", "peer", hs.get(4), hs.get(5))
    } else {
        t = fetchFile(c, dest, resume, "cli-fetch", "peer", key)
    }
    c.close()
    println("FETCH-DONE state=" + t.state + " offset=" + t.offset + "/" + t.totalBytes
        + " relay=" + relayed + " secure=" + secure)
    if (t.state == SessionState.Done) {
        println("FETCH-OK")
        return 0
    }
    return 1
}

// `relay <port> <peerHost> <peerPort> [--tamper]` — serve one ciphertext-only
// relayed session. `--tamper` flips one ciphertext byte (probe only).
Int runRelay(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("RELAY-ERR: usage: relay <port> <peerHost> <peerPort> [--tamper]")
        return 1
    }
    var port = math.parseInt(argAt(rest, 0))
    var peerHost = argAt(rest, 1)
    var peerPort = math.parseInt(argAt(rest, 2))
    var tamper = argAt(rest, 3) == "--tamper"
    println("RELAY-READY port=" + port + " peer=" + peerHost + ":" + peerPort + " tamper=" + tamper)
    if (tamper) {
        var l = net.listen(port)
        relayServeTamperOn(l, peerHost, peerPort)
    } else {
        relayServe(port, peerHost, peerPort)
    }
    return 0
}

// `server` — the control plane daemon (listen blocks; stop = process).
Int runServer(List<String> args) {
    var rest = tail(args, 1)
    var port = defaultControlPort()
    var key = defaultKey()
    var i = 0
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--key") {
            key = argAt(rest, i + 1)
            i = i + 2
        } else {
            port = math.parseInt(a)
            i = i + 1
        }
    }
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    controlLoadList("server-registry.devices.json", devices, null)
    controlLoadList("server-registry.offers.json", null, offers)
    var shares = new Map<String, ShareInfo>()
    var spath = "server-registry.shares.json"
    var load = shareLoadList(shares, spath)
    if (load.indexOf("REG041") == 0) {
        println(load)
        return 1
    }
    sharesPurgeExpired(shares, time.now())
    var controlKey = loadControlKey("server-control.ed25519")
    var accounts = new Map<String, Account>()
    var apath = "server-registry.accounts.json"
    var aload = authLoadList(accounts, apath)
    if (aload.indexOf("AUTH043") == 0) {
        println(aload)
        return 1
    }
    var controlSecret = loadControlSecret()
    bootstrapAdmin(accounts, apath, controlSecret)
    println("SERVER-READY port=" + port + " key=" + key + " devices=" + devices.size() + " offers=" + offers.size() + " shares=" + shares.size() + " accounts=" + accounts.size())
    controlServe(port, devices, offers,
        "server-registry.devices.json", "server-registry.offers.json",
        shares, spath, controlKey, accounts, apath, controlSecret)
    return 0
}

String loadControlSecret() {
    var f = File("server-control.apikey")
    if (f.exists()) {
        var txt = f.readText()
        if (txt != null && txt.length() >= 32) {
            var ok = auth.secret(txt)
            if (!ok) {
                println("SERVER-ERR: control secret rejected")
                return ""
            }
            return txt
        }
    }
    var fresh = security.apiKeyGenerate()
    if (!f.writeText(fresh)) {
        println("SERVER-ERR: cannot persist control secret")
        return ""
    }
    if (!auth.secret(fresh)) {
        println("SERVER-ERR: control secret rejected")
        return ""
    }
    return fresh
}

// C3 bootstrap (same law as server.kf): empty table mints an admin bearer,
// plaintext key lives in server-control.apikey (never printed, never logged).
void bootstrapAdmin(Map<String, Account> accounts, String apath, String controlSecret) {
    var hasActive = false
    var ids = accounts.keys()
    ids.sort()
    for (var id in ids) {
        var a: Account? = accounts.get(id)
        if (a != null && a.status == "active") {
            hasActive = true
        }
    }
    if (hasActive) {
        return
    }
    var r = authIssue(accounts, "admin", "owner", 1)
    if (r != "OK") {
        println("SERVER-ERR: admin bootstrap refused: " + r)
        return
    }
    controlSaveList(apath, authAccountsJson(accounts))
    var bearer = File("server-control.bearer")
    if (!bearer.writeText(authMint(controlSecret, "admin", "owner", 86400))) {
        println("SERVER-ERR: cannot persist admin bearer")
    }
}

Secret loadControlKey(String kpath) {
    var kf = File(kpath)
    if (kf.exists()) {
        var txt = kf.readText()
        if (txt == null) {
            throw "kofshare: unreadable control key " + kpath
        }
        return secrets.of(txt)
    }
    var fresh = keyExchange.privateKey("Ed25519")
    if (!kf.writeText(fresh.reveal())) {
        throw "kofshare: cannot persist control key " + kpath
    }
    return fresh
}


String localBearer() {
    var f = File("server-control.bearer")
    if (!f.exists()) {
        return ""
    }
    var t = f.readText()
    if (t == null) {
        return ""
    }
    return t
}

String bearerArg(List<String> rest, Int start) {
    var i = start
    while (i < rest.size) {
        if (rest.get(i) == "--bearer") {
            return argAt(rest, i + 1)
        }
        i = i + 1
    }
    return localBearer()
}

// C2 commands (vote D2=A): share/revoke/shares/authorize talk to the control
// plane over kof.http — the token never leaves the link; the GRANT response
// of /s/<token> is what the recipient feeds into `fetch` unchanged.
Int runShare(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("SHARE-ERR: usage: share <host> <port> <offerId> [--once] [--read-only] [--ttl <ms>]")
        return 1
    }
    var req = ShareRequest(rest.get(2), 0, 0, false)
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--once") {
            req = ShareRequest(req.offerId, req.ttlMs, 1, req.readOnly)
            i = i + 1
        } else if (a == "--read-only") {
            req = ShareRequest(req.offerId, req.ttlMs, req.maxUses, true)
            i = i + 1
        } else if (a == "--ttl") {
            req = ShareRequest(req.offerId, req.ttlMs + ttlOf(argAt(rest, i + 1)), req.maxUses, req.readOnly)
            i = i + 2
        } else {
            i = i + 1
        }
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    var bearer = "Authorization: Bearer " + bearerArg(rest, 3)
    var resp = http.post(base + "/shares", json.encode(req), bearer)
    if (resp == null) {
        println("SHARE-ERR: control plane unreachable")
        return 1
    }
    if (resp.indexOf("SHARED ") != 0) {
        println(resp)
        return 1
    }
    var parts = resp.split(" ")
    println("SHARE-LINK " + base + "/s/" + parts[2])
    println("SHARE-ID " + parts[1])
    return 0
}

Long ttlOf(String s) {
    return math.parseLong(s)
}

Int runRevoke(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("REVOKE-ERR: usage: revoke <host> <port> <shareId> [reason]")
        return 1
    }
    var base = "http://" + rest.get(0) + ":" + rest.get(1)
    var reason = "manual"
    if (rest.size > 3) {
        reason = rest.get(3)
    }
    var rb = "Authorization: Bearer " + bearerArg(rest, 4)
    var resp = http.post(base + "/shares/" + rest.get(2) + "/revoke?reason=" + reason, "", rb)
    if (resp == null) {
        println("REVOKE-ERR: control plane unreachable")
        return 1
    }
    println(resp)
    if (resp.indexOf("SHARE-REVOKED") == 0) {
        return 0
    }
    return 1
}

Int runShares(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 2) {
        println("SHARES-ERR: usage: shares <host> <port>")
        return 1
    }
    var sb = "Authorization: Bearer " + bearerArg(rest, 2)
    var body = http.get("http://" + rest.get(0) + ":" + rest.get(1) + "/shares", sb)
    if (body == null) {
        println("SHARES-ERR: control plane unreachable")
        return 1
    }
    println(body)
    return 0
}

Int runAuthorize(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("AUTH-ERR: usage: authorize <host> <port> <token>")
        return 1
    }
    var body = http.get("http://" + rest.get(0) + ":" + rest.get(1) + "/s/" + rest.get(2))
    if (body == null) {
        println("AUTH-ERR: control plane unreachable")
        return 1
    }
    println(body)
    if (body.indexOf("REG") == 0) {
        return 1
    }
    return 0
}

Int runOffer(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 1) {
        println("OFFER-ERR: usage: offer <file>")
        return 1
    }
    var out = offerJson(argAt(rest, 0))
    println(out)
    if (out.startsWith("OFFER-ERR")) {
        return 1
    }
    return 0
}

// ── tiny List helpers (no new stdlib face) ──

List<String> tail(List<String> xs, Int from) {
    var out = listOf()
    var i = from
    while (i < xs.size) {
        out.add(xs.get(i))
        i = i + 1
    }
    return out
}

String argAt(List<String> xs, Int i) {
    if (i < 0 || i >= xs.size) {
        return ""
    }
    return xs.get(i)
}

Boolean isDigits(String s) {
    if (s.length == 0) {
        return false
    }
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < '0' || c > '9') {
            return false
        }
        i = i + 1
    }
    return true
}

main(args: List<String>) {
    // Accept both `run cli.kf --target jvm --check` and the explicit
    // `run cli.kf --target jvm -- --check` (the latter yields a leading "--").
    var start = 0
    if (args.size > 0 && args.get(0) == "--") {
        start = 1
    }
    if (args.size <= start) {
        println("USAGE: kofshare server [port] [--key <hex>] | offer <file> | fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>] | relay <port> <peerHost> <peerPort> [--tamper] | --check | --dry")
        return
    }
    var cmd = args.get(start)
    if (cmd == "--check") {
        var rc = runCheck()
        if (rc != 0) {
            throw "kofshare: CHECK-FAIL"
        }
        return
    }
    if (cmd == "--dry") {
        runDry()
        return
    }
    if (cmd == "server") {
        runServer(tail(args, start))
        return
    }
    if (cmd == "offer") {
        var rc = runOffer(tail(args, start))
        if (rc != 0) {
            throw "kofshare: OFFER-ERR"
        }
        return
    }
    if (cmd == "fetch") {
        var rc = runFetch(tail(args, start))
        if (rc != 0) {
            throw "kofshare: FETCH-ERR"
        }
        return
    }
    if (cmd == "account") {
        var rc = runAccount(tail(args, start))
        if (rc != 0) {
            throw "kofshare: CMD-ERR account"
        }
        return
    }
    if (cmd == "share" || cmd == "revoke" || cmd == "shares" || cmd == "authorize") {
        var rc = 1
        if (cmd == "share") {
            rc = runShare(tail(args, start))
        } else if (cmd == "revoke") {
            rc = runRevoke(tail(args, start))
        } else if (cmd == "shares") {
            rc = runShares(tail(args, start))
        } else {
            rc = runAuthorize(tail(args, start))
        }
        if (rc != 0) {
            throw "kofshare: CMD-ERR " + cmd
        }
        return
    }
    if (cmd == "relay") {
        var rc = runRelay(tail(args, start))
        if (rc != 0) {
            throw "kofshare: RELAY-ERR"
        }
        return
    }
    println("UNKNOWN-COMMAND: " + cmd)
}
