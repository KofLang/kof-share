package kofshare.cli

import kofshare.transfer
import kofshare.domain
import kofshare.control.registry
import kofshare.control.app
import kofshare.session
import kofshare.relay
import kof.json
import kof.crypto
import kof.keyExchange
import kof.secrets
import kof.security

// KofShare product entry (implementation-plan.md §2 slice 3). Commands:
//   server [port] [--key <hex>]  control plane: serves offers over web.app()
//   offer <file>                 digest a file into an OfferInfo JSON record
//   fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure]
//                                [--relay <rhost> <rport>]
//                                pull an offer over kof.net into <dest>
//   relay <port> <peerHost> <peerPort> [--tamper]
//                                ciphertext-only relay for one session
//   --check                      full product golden (registry + plain +
//                                secure envelope legs), prints CHECK-OK
//   --dry                        resolve the transfer PLAN only, no sockets
//
// The registry verbs are the slice-1 pure domain; the transport is the
// slice-2 control surface; the transfer is the measured kof.net core. No
// new stdlib face is invented here (D-KOFSHARE-100KOF).

Int defaultControlPort() {
    return 18322
}

Int checkPortPlain() {
    return 19321
}

Int checkPortSecure() {
    return 19322
}

Int checkResumePlain() {
    return 100000
}

Int checkResumeSecure() {
    return 123456
}

String defaultKey() {
    return "kofshare-cli-key"
}

// File bytes (Int[] 0..255) → the wire Byte[] the digest/net faces take.
Byte[] toBytes(Int[] src) {
    var out = new Byte[src.size]
    var i = 0
    while (i < src.size) {
        var v = src[i]
        if (v < 0) {
            v = v + 256
        }
        out[i] = v
        i = i + 1
    }
    return out
}

// Deterministic 200000-byte source for the `--check` legs (same generator as
// the e2e oracle, kept local so the product entry owns no e2e main()).
Int[] makeSource() {
    var n = 200000
    var a = new Int[n]
    var i = 0
    while (i < n) {
        a[i] = (i * 7 + 3) % 256
        i = i + 1
    }
    return a
}

Int[] prefix(Int[] src, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = src[i]
        i = i + 1
    }
    return out
}

// `offer <file>` — real content digest (sha256Bytes over the file bytes).
String offerJson(String path) {
    if (!File(path).exists()) {
        return "OFFER-ERR: file not found: " + path
    }
    var data = File(path).readBytes()
    if (data.size == 0) {
        return "OFFER-ERR: empty file: " + path
    }
    var digest = crypto.sha256Bytes(toBytes(data))
    var o = OfferInfo("o-" + digest.substring(0, 12), "local", path, data.size, digest)
    return json.encode(o)
}

// `--check` leg 1 — the pure registry golden (no IO).
Boolean persistLeg() {
    var dp = "check-persist.devices.json"
    var op = "check-persist.offers.json"
    persistClean(dp)
    persistClean(op)
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    var ok = controlRegister(devices, DeviceInfo("d9", "persist", "127.0.0.1:8021")) == "OK"
    ok = ok && (controlSaveList(dp, controlDevicesJson(devices)) == "OK")
    var reload = new Map<String, DeviceInfo>()
    ok = ok && (controlLoadList(dp, reload, null) == "OK")
    ok = ok && (controlDevicesJson(reload) == controlDevicesJson(devices))
    var junk = "check-persist.junk.json"
    File(junk).writeText("nope")
    ok = ok && controlLoadList(junk, new Map<String, DeviceInfo>(), null).startsWith("REG009:")
    persistClean(junk)
    persistClean(dp)
    persistClean(op)
    return ok
}

void persistClean(String path) {
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
}

Boolean registryLeg() {
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    var ok = controlRegister(devices, DeviceInfo("d1", "alpha", "192.168.1.10:8021")) == "OK"
    ok = ok && (controlRegister(devices, DeviceInfo("", "x", "1.2.3.4:1")) == "REG001: empty device id")
    var d1 = controlResolve(devices, "d1")
    ok = ok && (d1 != null && d1.name == "alpha")
    var dig = crypto.sha256("/srv/a.bin")
    ok = ok && (controlOffer(offers, devices, OfferInfo("o1", "d1", "/srv/a.bin", 2048, dig)) == "OK")
    var back = controlResolveOffer(offers, "o1")
    ok = ok && (back != null && back.size == 2048 && back.deviceId == "d1")
    ok = ok && (controlRevoke(offers, "o1") == "OK")
    ok = ok && (controlResolveOffer(offers, "o1") == null)
    return ok
}

// `--check` leg 2 — the plain transfer core (resume@100000, real kof.net
// loopback), byte-for-byte + session Done.
Boolean plainLeg() {
    var src = "cli-check-src.bin"
    var dst = "cli-check-dst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, checkResumePlain()))
    var l = net.listen(checkPortPlain())
    var worker = spawn {
        var s = l.accept()
        serveFile(s, src, checkResumePlain(), "k0")
        s.close()
    }
    var c = net.connect("127.0.0.1", checkPortPlain())
    var t = fetchFile(c, dst, checkResumePlain(), "check-plain", "devA", "k0")
    c.close()
    await worker
    l.close()
    var a = File(src).readBytes()
    var b = File(dst).readBytes()
    var ok = (t.state == SessionState.Done) && (a.size == b.size) && (firstMismatch(a, b) < 0)
    File(src).delete()
    File(dst).delete()
    return ok
}

// `--check` leg 3 — the secure envelope (resume@123456): X25519 + HKDF
// direction keys, encrypt-then-MAC, byte-for-byte + session Done.
Boolean secureLeg() {
    var src = "cli-check-sec-src.bin"
    var dst = "cli-check-sec-dst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, checkResumeSecure()))
    var l = net.listen(checkPortSecure())
    var worker = spawn {
        var sv = l.accept()
        var privS = keyExchange.privateKey()
        serveFileSecure(sv, src, checkResumeSecure(), privS, security.randomHex(16))
        sv.close()
    }
    var c = net.connect("127.0.0.1", checkPortSecure())
    var privC = keyExchange.privateKey()
    var hs = fetchHandshake(c, privC)
    var t = fetchFileSecure(c, dst, checkResumeSecure(), "check-sec", "devB", hs.get(4), hs.get(5))
    c.close()
    var out = File(dst).readBytes()
    var ok = (t.state == SessionState.Done) && (out.size == data.size) && (firstMismatch(out, data) < 0)
    // directions must be distinct: encTx != encRx and macTx != macRx
    ok = ok && (hs.get(2) != hs.get(4)) && (hs.get(3) != hs.get(5))
    await worker
    l.close()
    File(src).delete()
    File(dst).delete()
    return ok
}

// `--check` — the one command that shows the whole product green.
Int runCheck() {
    var reg = registryLeg()
    var plain = plainLeg()
    var secure = secureLeg()
    println("registry=" + reg)
    println("persist=" + persistLeg())
    println("plain=" + plain)
    println("secure=" + secure)
    if (reg && plain && secure) {
        println("CHECK-OK")
        return 0
    }
    println("CHECK-FAIL")
    return 1
}

// `--dry` — print the resolved product plan, no IO. Deterministic.
Int runDry() {
    println("DRY-PLAN commands:")
    println("  server [port] [--key <hex>]  -> control plane web.app() on port " + defaultControlPort())
    println("  offer <file>                 -> OfferInfo JSON (sha256Bytes over the file)")
    println("  fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>] -> kof.net pull")
    println("  relay <port> <peerHost> <peerPort> [--tamper] -> ciphertext-only relay")
    println("  --check                      -> registry + plain port=" + checkPortPlain()
        + " resume=" + checkResumePlain() + " + secure port=" + checkPortSecure()
        + " resume=" + checkResumeSecure())
    println("DRY-OK")
    return 0
}

// `fetch` — real transfer from a serving peer. `--resume <n>` appends to a
// partial file; `--key <hex>` must match the peer's key; `--secure` uses the
// X25519/HKDF envelope; `--relay <host> <port>` routes through the
// ciphertext-only relay (slice 5). Without `--relay` the client connects
// directly to the peer.
Int runFetch(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("FETCH-ERR: usage: fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>]")
        return 1
    }
    var host = argAt(rest, 0)
    var port = math.parseInt(argAt(rest, 1))
    var dest = argAt(rest, 2)
    var resume = 0
    var key = defaultKey()
    var secure = false
    var relayed = false
    var relayHost = ""
    var relayPort = 0
    var i = 3
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--resume") {
            var nxt = argAt(rest, i + 1)
            if (isDigits(nxt)) {
                resume = math.parseInt(nxt)
                i = i + 2
            } else {
                // bare --resume: continue from what the .part already holds
                if (File(dest).exists()) {
                    resume = File(dest).size() as Int
                }
                i = i + 1
            }
        } else {
            if (a == "--key") {
                key = argAt(rest, i + 1)
                i = i + 2
            } else {
                if (a == "--secure") {
                    secure = true
                    i = i + 1
                } else {
                    if (a == "--relay") {
                        relayed = true
                        relayHost = argAt(rest, i + 1)
                        relayPort = math.parseInt(argAt(rest, i + 2))
                        i = i + 3
                    } else {
                        i = i + 1
                    }
                }
            }
        }
    }
    var hostToUse = host
    var portToUse = port
    if (relayed) {
        hostToUse = relayHost
        portToUse = relayPort
    }
    var c = net.connect(hostToUse, portToUse)
    var t: Transfer
    if (secure) {
        var privC = keyExchange.privateKey()
        var hs = fetchHandshake(c, privC)
        t = fetchFileSecure(c, dest, resume, "cli-fetch", "peer", hs.get(4), hs.get(5))
    } else {
        t = fetchFile(c, dest, resume, "cli-fetch", "peer", key)
    }
    c.close()
    println("FETCH-DONE state=" + t.state + " offset=" + t.offset + "/" + t.totalBytes
        + " relay=" + relayed + " secure=" + secure)
    if (t.state == SessionState.Done) {
        println("FETCH-OK")
        return 0
    }
    return 1
}

// `relay <port> <peerHost> <peerPort> [--tamper]` — serve one ciphertext-only
// relayed session. `--tamper` flips one ciphertext byte (probe only).
Int runRelay(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 3) {
        println("RELAY-ERR: usage: relay <port> <peerHost> <peerPort> [--tamper]")
        return 1
    }
    var port = math.parseInt(argAt(rest, 0))
    var peerHost = argAt(rest, 1)
    var peerPort = math.parseInt(argAt(rest, 2))
    var tamper = argAt(rest, 3) == "--tamper"
    println("RELAY-READY port=" + port + " peer=" + peerHost + ":" + peerPort + " tamper=" + tamper)
    if (tamper) {
        var l = net.listen(port)
        relayServeTamperOn(l, peerHost, peerPort)
    } else {
        relayServe(port, peerHost, peerPort)
    }
    return 0
}

// `server` — the control plane daemon (listen blocks; stop = process).
Int runServer(List<String> args) {
    var rest = tail(args, 1)
    var port = defaultControlPort()
    var key = defaultKey()
    var i = 0
    while (i < rest.size) {
        var a = argAt(rest, i)
        if (a == "--key") {
            key = argAt(rest, i + 1)
            i = i + 2
        } else {
            port = math.parseInt(a)
            i = i + 1
        }
    }
    var devices = new Map<String, DeviceInfo>()
    var offers = new Map<String, OfferInfo>()
    controlLoadList("server-registry.devices.json", devices, null)
    controlLoadList("server-registry.offers.json", null, offers)
    println("SERVER-READY port=" + port + " key=" + key + " devices=" + devices.size() + " offers=" + offers.size())
    controlServe(port, devices, offers,
        "server-registry.devices.json", "server-registry.offers.json")
    return 0
}

Int runOffer(List<String> args) {
    var rest = tail(args, 1)
    if (rest.size < 1) {
        println("OFFER-ERR: usage: offer <file>")
        return 1
    }
    var out = offerJson(argAt(rest, 0))
    println(out)
    if (out.startsWith("OFFER-ERR")) {
        return 1
    }
    return 0
}

// ── tiny List helpers (no new stdlib face) ──

List<String> tail(List<String> xs, Int from) {
    var out = listOf()
    var i = from
    while (i < xs.size) {
        out.add(xs.get(i))
        i = i + 1
    }
    return out
}

String argAt(List<String> xs, Int i) {
    if (i < 0 || i >= xs.size) {
        return ""
    }
    return xs.get(i)
}

Boolean isDigits(String s) {
    if (s.length == 0) {
        return false
    }
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < '0' || c > '9') {
            return false
        }
        i = i + 1
    }
    return true
}

main(args: List<String>) {
    // Accept both `run cli.kf --target jvm --check` and the explicit
    // `run cli.kf --target jvm -- --check` (the latter yields a leading "--").
    var start = 0
    if (args.size > 0 && args.get(0) == "--") {
        start = 1
    }
    if (args.size <= start) {
        println("USAGE: kofshare server [port] [--key <hex>] | offer <file> | fetch <host> <port> <dest> [--resume <n>] [--key <hex>] [--secure] [--relay <rhost> <rport>] | relay <port> <peerHost> <peerPort> [--tamper] | --check | --dry")
        return
    }
    var cmd = args.get(start)
    if (cmd == "--check") {
        var rc = runCheck()
        if (rc != 0) {
            throw "kofshare: CHECK-FAIL"
        }
        return
    }
    if (cmd == "--dry") {
        runDry()
        return
    }
    if (cmd == "server") {
        runServer(tail(args, start))
        return
    }
    if (cmd == "offer") {
        var rc = runOffer(tail(args, start))
        if (rc != 0) {
            throw "kofshare: OFFER-ERR"
        }
        return
    }
    if (cmd == "fetch") {
        var rc = runFetch(tail(args, start))
        if (rc != 0) {
            throw "kofshare: FETCH-ERR"
        }
        return
    }
    if (cmd == "relay") {
        var rc = runRelay(tail(args, start))
        if (rc != 0) {
            throw "kofshare: RELAY-ERR"
        }
        return
    }
    println("UNKNOWN-COMMAND: " + cmd)
}
