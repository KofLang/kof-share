package kofshare.control

import kofshare.control.registry
import kofshare.directory
import kofshare.control.share
import kofshare.control.grant
import kofshare.control.auth
import kofshare.control.session
import kofshare.control.presence
import kof.json
import kof.security
import kof.time
import kof.auth

// Control-plane HTTP surface (architecture.md §4, implementation-plan slice 2).
// The app owns NOTHING: the registries are passed in, so the pure registry
// slice 1 stays the domain authority and this file is transport sugar.
// listen() blocks — the server main runs it; stop = process lifecycle
// (v1 is a LAN daemon). NOTE: lambdas here capture ONLY the registry maps —
// capture of the app handle became LEGAL on JVM after Kof4j §575 was fixed
// (JvmTypeMapper erases the phantom descriptor); we still choose NOT to
// capture — daemon lifecycle = process lifecycle.
// C2 (vote D2=A): /shares mints bearer grants over offers — token =
// security.randomHex(32), signed with the control Ed25519 key (C1 face);
// /s/<token> is the authorization gate (shareTouch decides; only "OK"
// serves offer metadata). The SECRET stays a Secret handle end to end.

// callerSub is the authenticated recipient identity ("" if the request carried
// no valid bearer). For a possession grant it is unused; for an identity grant
// grantAuthorize refuses ANY non-matching caller with the opaque REG035 BEFORE
// any offer/device/presence lookup, so a wrong-holder learns nothing about the
// resource or that the recipient account exists (prompt §3 rules 3/4/8/9).
String handleGetShare(String token, String? childQuery, Map<String, ShareInfo> shares,
                     Map<String, GrantInfo> grants, String gpath, String callerSub,
                     Map<String, OfferInfo> offers, Map<String, DeviceInfo> devices,
                     Map<String, DeviceKey> devkeys, Map<String, PresenceInfo> presences,
                     String spath) {
    var now = time.now()
    var ga = grantAuthorize(grants, token, callerSub, now)
    if (ga != "OK") {
        return ga
    }
    var r = shareTouch(shares, token, now)
    if (r != "OK") {
        return r
    }
    var gt = grantTouch(grants, token, now)
    if (gt != "OK") {
        return gt
    }
    var s = shareResolve(shares, token)
    if (s == null) {
        return "REG035: unknown share token"
    }
    // narrowing of the nullable SHARE then passed to the grant helpers — the
    // direct `s.permissions`-as-argument read crashed the JVM backend with a
    // COMP002 frame error (Kof4j bug, to be filed); binding the field after
    // the null guard is the same idiom the working handlers use.
    var perms = s.permissions
    var cq = ""
    if (childQuery != null) {
        cq = childQuery
    }
    var o: OfferInfo? = controlResolveOffer(offers, s.offerId)
    if (o == null) {
        return "REG034: offer vanished " + s.offerId
    }
    var d: DeviceInfo? = controlResolve(devices, o.deviceId)
    if (d == null) {
        return "REG032: unknown device " + o.deviceId
    }
    var k: DeviceKey? = devkeys.get(o.deviceId)
    if (k != null && k.status == "revoked") {
        return "DEV003: device revoked " + o.deviceId
    }
    var pg = presenceGate(presences, o.deviceId, now)
    if (pg != "OK") {
        return pg
    }
    if (spath.length() > 0) {
        controlSaveList(spath, sharesJson(shares))
    }
    if (gpath.length() > 0) {
        controlSaveList(gpath, grantsJson(grants))
    }
    if (o.type == "DIRECTORY") {
        var out3 = dirGrantBody(o, cq, d.address, perms)
        return out3
    }
    var out2 = fileGrantJson(o, perms, d.address)
    return out2
}

// childQuery "" means "no selector" — the caller COALESCES the nullable
// query up front; threading a narrowed Nullable-type parameter through the
// branch crashed the JVM backend (COMP002 frame error — Kof4j bug being
// filed; plain-String parameters have compiled since Track C).
String dirGrantBody(OfferInfo o, String childQuery, String addr, String perms) {
    if (childQuery.length() == 0) {
        return json.encode(dirGrantJson(o, perms, addr))
    }
    var ci = math.parseInt(childQuery)
    var entriesG = dirEntriesFromJson(o.entriesJson)
    // THE CONTRACT: the child index is the ordinal among FILE entries of the
    // SORTED manifest (directories carry no bytes — they are not selectable).
    // The device face counts the same ordinals over the same sorted list.
    var filesG = new List<DirEntry>()
    var gi = 0
    while (gi < entriesG.size) {
        if (entriesG.get(gi).type == "FILE") {
            filesG.add(entriesG.get(gi))
        }
        gi = gi + 1
    }
    if (ci < 0 || ci >= filesG.size) {
        return "REG015: directory child index out of range"
    }
    var ce = filesG.get(ci)
    var out1 = childGrantJson(ce, addr, perms)
    return out1
}

String fileGrantJson(OfferInfo o, String perms, String addr) {
    return json.encode(ShareGrant(o.id, o.path, o.size, o.sha256Hex, addr,
        perms, o.resourceId, o.name, "FILE", "", "", ""))
}

String childGrantJson(DirEntry ce, String addr, String perms) {
    return json.encode(ShareGrant(ce.resourceId, dirBaseName(ce.logicalPath), ce.size,
        ce.hash, addr, perms, ce.resourceId, dirBaseName(ce.logicalPath),
        "FILE", "", ce.logicalPath, ""))
}

ShareGrant dirGrantJson(OfferInfo o, String perms, String addr) {
    return ShareGrant(o.id, o.name, o.size, o.sha256Hex, addr,
        perms, o.resourceId, o.name, "DIRECTORY", o.entriesJson, "", "")
}

// Abuse protection at the sensitive control endpoints (gigaprompt §6):
// deterministic caps, named refusals, no silent eviction. Defaults are
// generous for a personal plane; kofshare.max* in the config lowers/raises.
// The device-owner answer used by every mint/delete gate: "" means NO owner
// record (keyless legacy lane — allowed, documented); otherwise the bound
// account sub. The control admin lane ("admin") passes by design.
String controlDeviceOwnerOf(Map<String, DeviceKey> devkeys, String deviceId) {
    var k: DeviceKey? = devkeys.get(deviceId)
    if (k == null) {
        return ""
    }
    return k.owner
}

String controlOwnerGate(Map<String, DeviceKey> devkeys, String deviceId, String who) {
    var owner = controlDeviceOwnerOf(devkeys, deviceId)
    if (owner.length() == 0 || owner == who || who == "admin") {
        return ""
    }
    return "AUTH004: not the owner of device " + deviceId
}

String controlBodyCap() {
    var cap = config.int("kofshare.maxBody", 65536)
    if (body().length() > cap) {
        return "REG042: payload exceeds control cap"
    }
    return ""
}

String controlCapShares(Map<String, ShareInfo> shares) {
    var cap = config.int("kofshare.maxShares", 20000)
    if (shares.size() >= cap) {
        return "REG043: share table at capacity"
    }
    return ""
}

String controlCapGrants(Map<String, GrantInfo> grants) {
    var cap = config.int("kofshare.maxGrants", 20000)
    if (grants.size() >= cap) {
        return "GRANT042: grant table at capacity"
    }
    return ""
}

String controlCapDevices(Map<String, DeviceInfo> devices) {
    var cap = config.int("kofshare.maxDevices", 10000)
    if (devices.size() >= cap) {
        return "REG044: device table at capacity"
    }
    return ""
}

void controlServe(Int port, Map<String, DeviceInfo> devices, Map<String, OfferInfo> offers, String dpath, String opath, Map<String, ShareInfo> shares, String spath, Secret controlKey, Map<String, Account> accounts, String apath, String controlSecret, Map<String, DeviceKey> devkeys, String kpath, Map<String, SessionInfo> sessions, String npath, Map<String, PresenceInfo> presences, String ppath) {
    var app = web.app()

    // GATE 3 grants table — OWNED inside controlServe so the giant positional
    // signature stays frozen (fragile to widen). Its file is the shares path
    // with the segment swapped (.shares.json → .grants.json); absent path =
    // no persistence (pure unit/in-memory callers, e.g. checks). v2 registries
    // load unchanged: the bearer share file is untouched, a missing grants
    // file is simply "no identity grants" (possession-only, exact v2 behavior).
    var grants = new Map<String, GrantInfo>()
    var gpath = ""
    if (spath.length() > 0) {
        gpath = spath.replace(".shares.", ".grants.")
        var gload = grantLoadList(grants, gpath)
        // FAIL CLOSED (gigaprompt §6): an EXISTING grants file that will not
        // load must NEVER boot into possession-only semantics — that would
        // silently open every restricted link. The v2 "no file yet" case is
        // grantLoadList's own OK path. Corruption stops the plane by name.
        if (gload != "OK") {
            throw gload
        }
        grantsPurgeExpired(grants, time.now())
    }

    app.get("/devices") {
        return controlDevicesJson(devices)
    }

    app.get("/devices/:id") {
        var d: DeviceInfo? = controlResolve(devices, param("id"))
        if (d == null) {
            return "DEVICE-NOT-FOUND: " + param("id")
        }
        return json.encode(d)
    }

    app.post("/devices") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var bcd = controlBodyCap()
        if (bcd.length() > 0) {
            return bcd
        }
        var cd = controlCapDevices(devices)
        if (cd.length() > 0) {
            return cd
        }
        var d = json.decode<DeviceInfo>(body())
        var r = controlRegister(devices, d)
        if (r != "OK") {
            return r
        }
        if (dpath.length() > 0) {
            controlSaveList(dpath, controlDevicesJson(devices))
        }
        return "REGISTERED: " + d.id()
    }

    // TRACK A enrollment lane (product evolution 05/10). The v1 route above
    // is UNCHANGED (Track M): keyless DeviceInfo bodies still register. Here
    // the device proves it HOLDS the private half over a canonical
    // registration string; the plane stores ONLY the public 64-hex (TOFU:
    // first enrollment trusts the self-signature, later ops verify against
    // the stored key). Same persistence discipline as devices (quasi-atomic
    // save after every mutation).
    app.post("/devices/register") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = json.decode<DeviceRegister>(body())
        var v = controlEnroll(devices, devkeys, r)
        if (v != "OK") {
            return v
        }
        // GATE 4 owner binding (TOFU): the ENROLLING authenticated account
        // owns the device from here on. A re-enroll of the same pub by
        // another account does NOT move ownership silently — transfer is a
        // deliberate admin lane, not a race. Keyless v1 devices (POST
        // /devices) have no DeviceKey row at all: owner "" = the documented
        // single-host legacy lane (Track M law, no silent reinterpretation).
        var ek: DeviceKey? = devkeys.get(r.id)
        if (ek != null && ek.owner.length() == 0) {
            devkeys.put(r.id, new DeviceKey(ek.deviceId, ek.pub, ek.status,
                authParseSub(auth.claims())))
        }
        if (dpath.length() > 0) {
            controlSaveList(dpath, controlDevicesJson(devices))
        }
        if (kpath.length() > 0) {
            controlSaveList(kpath, controlDevkeysJson(devkeys))
        }
        return "REGISTERED: " + r.id()
    }

    app.get("/device-keys/:id") {
        var k: DeviceKey? = devkeys.get(param("id"))
        if (k == null) {
            return "DEV001: no public key for device " + param("id")
        }
        return "PUB: " + k.pub + " STATUS: " + k.status
    }

    app.post("/devices/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var v = controlDeviceRevoke(devkeys, param("id"))
        if (v != "OK") {
            return v
        }
        if (kpath.length() > 0) {
            controlSaveList(kpath, controlDevkeysJson(devkeys))
        }
        return "DEVICE-REVOKED: " + param("id")
    }

    app.get("/offers") {
        var dv: String? = query("device")
        var filter = ""
        if (dv != null) {
            filter = dv
        }
        return controlOffersJson(offers, filter)
    }

    app.post("/offers") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var q = json.decode<OfferRequest>(body())
        // TRACK A gate FIRST (measured before landing: the naive order ran
        // controlOffer — which INSERTS — before the signature check, leaving
        // a refused offer half-present in the registry): a device that
        // ENROLLED a key signs its offers. Contextual rule (Track I:
        // "token válido ≠ acesso ilimitado") — keyless v1 devices pass.
        // IDENTITY FENCE FIRST: a non-owner never reaches signature checks
        // (and no oracle about which sigs would validate leaks to them).
        var og = controlOwnerGate(devkeys, q.deviceId, authParseSub(auth.claims()))
        if (og.length() > 0) {
            return og
        }
        var ig = controlOfferChecked(devkeys, q)
        if (ig != "OK") {
            return ig
        }
        // A4: the SERVER stamps freshness — the client cannot fake createdAt
        // or resurrect an expired id from the wire.
        var o = OfferInfo(q.id, q.deviceId, q.path, q.size, q.sha256Hex, time.now(),
            q.resourceId, q.name, q.modifiedAt, q.type, q.entriesJson)
        var r = controlOffer(offers, devices, o)
        if (r != "OK") {
            return r
        }
        if (opath.length() > 0) {
            controlSaveList(opath, controlOffersJson(offers, ""))
        }
        return "OFFERED: " + o.id()
    }

    app.delete("/offers/:id") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var goneOffer: OfferInfo? = offers.get(param("id"))
        if (goneOffer != null) {
            var dg = controlOwnerGate(devkeys, goneOffer.deviceId, authParseSub(auth.claims()))
            if (dg.length() > 0) {
                return dg
            }
        }
        var r = controlRevoke(offers, param("id"))
        if (r != "OK") {
            return r
        }
        if (opath.length() > 0) {
            controlSaveList(opath, controlOffersJson(offers, ""))
        }
        return "REVOKED: " + param("id")
    }

    app.get("/health") {
        return "OK"
    }

    // C3 (vote D3=B): mutations and sensitive listings require a bearer key.
    // Bootstrap law (documented, measured): the FIRST account on an EMPTY
    // table is open enrollment — the owner mints their own admin key; once
    // the table has an active account everything else needs it.
    app.post("/accounts") {
        // Bootstrap law (documented, measured): the FIRST account on an EMPTY
        // table is open enrollment — the owner mints their own bearer; once an
        // active account exists everything else needs one.
        if (activeAccounts(accounts) > 0) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        var req = json.decode<AccountRequest>(body())
        var r = authIssue(accounts, req.id, req.label, time.now())
        if (r != "OK") {
            return r
        }
        if (apath.length() > 0) {
            controlSaveList(apath, authAccountsJson(accounts))
        }
        var ttl = 0
        if (req.ttlSec > 0) {
            ttl = req.ttlSec
        } else {
            ttl = 86400
        }
        return "APIKEY " + authMint(controlSecret, req.id, req.label, ttl)
    }

    app.get("/accounts") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return authAccountsJson(accounts)
    }

    app.post("/accounts/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = authRevoke(accounts, param("id"))
        if (r != "OK") {
            return r
        }
        if (apath.length() > 0) {
            controlSaveList(apath, authAccountsJson(accounts))
        }
        return "ACCOUNT-REVOKED: " + param("id")
    }

    app.post("/shares") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var bc = controlBodyCap()
        if (bc.length() > 0) {
            return bc
        }
        var cc = controlCapShares(shares)
        if (cc.length() > 0) {
            return cc
        }
        var req = json.decode<ShareRequest>(body())
        var o: OfferInfo? = controlResolveOffer(offers, req.offerId)
        if (o == null) {
            return "REG033: unknown offer " + req.offerId
        }
        if (controlResolve(devices, o.deviceId) == null) {
            return "REG032: unknown device " + o.deviceId
        }
        var mg = controlOwnerGate(devkeys, o.deviceId, authParseSub(auth.claims()))
        if (mg.length() > 0) {
            return mg
        }
        var now = time.now()
        var id = "sh" + security.randomHex(8)
        var token = security.randomHex(32)
        var perms = "read-write"
        if (req.readOnly) {
            perms = "read"
        }
        // HONEST type from the start: the slot is Long (assigning a widened
        // Long over an Int-inferred local inside a route lambda hits Kof4j
        // §583 — recorded, not hidden: the typed declaration is the correct
        // Kof form, the emitter bug is the ledger's).
        var expires: Long = 0
        if (req.ttlMs > 0) {
            expires = now + req.ttlMs
        }
        var core = ShareInfo(id, token, o.deviceId, req.offerId, perms, now, expires, req.maxUses, 0, "active", "", "", "")
        var signed = ShareInfo(core.id, core.token, core.deviceId, core.offerId, core.permissions, core.createdAt, core.expiresAt, core.maxUses, core.used, core.status, core.revocation, shareSign(controlKey, core), "")
        var r = shareIssue(shares, signed)
        if (r != "OK") {
            return r
        }
        // v2-Track G DIRECTORY gate: a dir share may ONLY be minted over a
        // DIRECTORY offer — the parent token becomes the capability for the
        // whole tree (children resolve through /s/<token>?child=N). NO child
        // share-minting exists: the tree is data, the capability is one.
        if (req.dirShare && o.type != "DIRECTORY") {
            return "REG016: dirShare requested on a non-directory offer"
        }
        if (!req.dirShare && o.type == "DIRECTORY") {
            return "REG016: directory offers require dirShare"
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return "SHARED " + id + " " + token
    }

    // GATE 3 — recipient-bound share. The bearer share token is minted
    // possession-style underneath (so the existing /s + /sessions machinery
    // stays byte-compatible), but a signed GRANT binds that token to ONE
    // recipient account + policy. Redemption of an identity grant by anyone
    // else is the opaque REG035 (see handleGetShare / grantAuthorize). The
    // sender MUST be authenticated (owner law, same as POST /shares).
    app.post("/shares/identity") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var senderSub = authParseSub(auth.claims())
        var bcg = controlBodyCap()
        if (bcg.length() > 0) {
            return bcg
        }
        var cg = controlCapGrants(grants)
        if (cg.length() > 0) {
            return cg
        }
        var req = json.decode<GrantRequest>(body())
        var o: OfferInfo? = controlResolveOffer(offers, req.offerId)
        if (o == null) {
            return "REG033: unknown offer " + req.offerId
        }
        if (controlResolve(devices, o.deviceId) == null) {
            return "REG032: unknown device " + o.deviceId
        }
        var mg2 = controlOwnerGate(devkeys, o.deviceId, senderSub)
        if (mg2.length() > 0) {
            return mg2
        }
        if (req.identity && req.recipient.length() == 0) {
            return "GRANT014: identity grant needs a recipient"
        }
        if (req.recipient == senderSub) {
            return "GRANT016: sender cannot self-authorize a restricted grant"
        }
        // The RECIPIENT must be a real, active account (gigaprompt §2 flow 2:
        // "destinatários identificados no sistema"). A typo must refuse at
        // MINT time, not silently create an unusable link. This existence
        // answer goes only to the AUTHENTICATED SENDER who just named the
        // recipient — outsiders never reach this line.
        if (authActive(accounts, req.recipient) != "OK") {
            return "GRANT017: recipient account not active: " + req.recipient
        }
        if (req.dirShare && o.type != "DIRECTORY") {
            return "REG016: dirShare requested on a non-directory offer"
        }
        if (!req.dirShare && o.type == "DIRECTORY") {
            return "REG016: directory offers require dirShare"
        }
        var now = time.now()
        var sid = "sh" + security.randomHex(8)
        var token = security.randomHex(32)
        var gid = "gr" + security.randomHex(8)
        var perms = "read-write"
        if (req.readOnly) {
            perms = "read"
        }
        var expires: Long = 0
        if (req.ttlMs > 0) {
            expires = now + req.ttlMs
        }
        var pol = "possession"
        if (req.identity) {
            pol = "identity"
        }
        // bearer base (identical shape to POST /shares — old clients/registries
        // are unaffected; the grant is what restricts it).
        var sc = ShareInfo(sid, token, o.deviceId, req.offerId, perms, now, expires,
            req.maxUses, 0, "active", "", "", "")
        var signedShare = ShareInfo(sc.id, sc.token, sc.deviceId, sc.offerId, sc.permissions,
            sc.createdAt, sc.expiresAt, sc.maxUses, sc.used, sc.status, sc.revocation,
            shareSign(controlKey, sc), "")
        var sr = shareIssue(shares, signedShare)
        if (sr != "OK") {
            return sr
        }
        var gc = GrantInfo(gid, token, req.offerId, senderSub, req.recipient, perms, pol,
            now, expires, req.maxUses, 0, "active", "", "")
        var signedGrant = new GrantInfo(gc.id, gc.token, gc.offerId, gc.senderAccount,
            gc.recipientAccount, gc.permissions, gc.policy, gc.createdAt, gc.expiresAt,
            gc.maxUses, gc.used, gc.status, gc.revocation, grantSign(controlKey, gc))
        var gr = grantIssue(grants, signedGrant)
        if (gr != "OK") {
            shares.remove(sid)
            return gr
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        if (gpath.length() > 0) {
            controlSaveList(gpath, grantsJson(grants))
        }
        return "GRANTED " + gid + " " + token + " " + req.recipient
    }

    // Revoke a grant by id (owner bearer). Revoking the grant closes the
    // identity authorization; the bearer base is revoked too so neither path
    // serves further (§3 rule 10: new claims prevented).
    app.post("/grants/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var ggr: GrantInfo? = grants.get(param("id"))
        if (ggr == null) {
            return "REG039: unknown grant " + param("id")
        }
        var rsn: String? = query("reason")
        var reason = ""
        if (rsn != null) {
            reason = rsn
        }
        var rr = grantRevoke(grants, param("id"), reason)
        if (rr != "OK") {
            return rr
        }
        var sh: ShareInfo? = shareResolve(shares, ggr.token)
        if (sh != null) {
            shareRevoke(shares, sh.id, "grant-revoked")
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        if (gpath.length() > 0) {
            controlSaveList(gpath, grantsJson(grants))
        }
        return "GRANT-REVOKED: " + param("id")
    }

    app.get("/shares") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return sharesJson(shares)
    }

    // GATE 3 (multi-user evolution): the caller's verified identity, for the
    // desktop's whoami. The gate above already checked signature + ACTIVE.
    app.get("/whoami") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return "WHOAMI " + authParseSub(auth.claims())
    }

    app.get("/s/:token") {
        // Best-effort caller identity: a VALID bearer whose account is ACTIVE
        // yields its sub; anything else (no bearer, bad sig, revoked account)
        // yields "" so an identity grant opaque-refuses it (REG035) WITHOUT
        // revealing whether the account exists or is revoked (§3 rule 8).
        var callerSub = ""
        if (auth.authenticated()) {
            var cs = authParseSub(auth.claims())
            if (authActive(accounts, cs) == "OK") {
                callerSub = cs
            }
        }
        return handleGetShare(param("token"), query("child"), shares, grants, gpath,
            callerSub, offers, devices, devkeys, presences, spath)
    }

    app.post("/shares/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var rs: String? = query("reason")
        var reason = ""
        if (rs != null) {
            reason = rs
        }
        // GATE 3 owner law: a share bound to a GRANT is revoked only by the
        // account that minted it (or the control-key admin lane below). A
        // different authenticated identity gets AUTH005 — by name, without
        // revealing anything about the share. v1/v2 possession shares carry
        // NO owner record; the migration law (§10) says we do NOT invent one
        // silently — the single-host bootstrap admin keeps that lane.
        var who = authParseSub(auth.claims())
        var targetShare: ShareInfo? = shares.get(param("id"))
        if (targetShare != null) {
            var bound = grantForToken(grants, targetShare.token)
            if (bound != null) {
                if (bound.senderAccount != who && who != "admin") {
                    return "AUTH005: not the owner of this share"
                }
            } else {
                // possession share: owner derives from the serving device
                // when that device carries an owner record (signed lane).
                var pog = controlOwnerGate(devkeys, targetShare.deviceId, who)
                if (pog.length() > 0) {
                    return "AUTH005: not the owner of this share"
                }
            }
        }
        var r = shareRevoke(shares, param("id"), reason)
        if (r != "OK") {
            return r
        }
        // Propagate to a bound grant (rule 10): revoking the bearer share
        // also revokes the identity grant that references the same token, so
        // neither the possession path nor the identity path can serve again.
        var rvShare: ShareInfo? = shares.get(param("id"))
        if (rvShare != null) {
            var bgrant = grantForToken(grants, rvShare.token)
            if (bgrant != null) {
                grantRevoke(grants, bgrant.id, "share-revoked")
            }
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        if (gpath.length() > 0) {
            controlSaveList(gpath, grantsJson(grants))
        }
        return "SHARE-REVOKED: " + param("id")
    }

    // ── TRACK C — session signaling (the plane COORDINATES, never carries
    // bytes). POST /sessions: recipient (bearer-gated — the same account law
    // as every mutation) opens the rendezvous with the share TOKEN plus its
    // own device identity; the owner learns about it ONLY through
    // GET/sessions?device=self&state=CREATED (pull — the runtime web face has
    // no server-push yet, honest v1 signaling; SSE is a Kof4j face already
    // available server-side for Track E's page). Role matrix enforced below:
    // CLAIMED is owner-only (bearer); the token holder may drive
    // NEGOTIATING/CONNECTED/TRANSFERRING/FAILED/CANCELLED; COMPLETED belongs
    // to whoever holds proof (either face); persistence after every mutation.
    app.post("/sessions") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var req = json.decode<SessionRequest>(body())
        // GATE 3: an identity grant's session may only be opened by the
        // recipient account (controlAuthGate above already proved the bearer
        // is signed + the account ACTIVE; here the identity must also MATCH
        // the grant — a different authenticated identity gets the opaque
        // REG035, test #3). A session is not created on a revoked/expired
        // grant (grantAuthorize refuses by name).
        var csub = authParseSub(auth.claims())
        var ga = grantAuthorize(grants, req.token, csub, time.now())
        if (ga != "OK") {
            return ga
        }
        var sid = "se" + security.randomHex(8)
        // v2-Track F: stamp the LOGICAL resource id onto the session, read
        // transitively (token→share→offer). No session state changed — the
        // record grew a field, the machine did not (§8).
        var resid = ""
        var shr: ShareInfo? = shareResolve(shares, req.token)
        if (shr != null) {
            var ors: OfferInfo? = offers.get(shr.offerId)
            if (ors != null) {
                resid = ors.resourceId
            }
        }
        var r = sessionCreate(sessions, shares, resid, sid, req, time.now())
        if (r != "OK") {
            return r
        }
        if (npath.length() > 0) {
            controlSaveList(npath, sessionsJson(sessions, "", ""))
        }
        return "SESSION-CREATED: " + sid
    }

    app.get("/sessions") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var dv: String? = query("device")
        var st: String? = query("state")
        var device = ""
        if (dv != null) {
            device = dv
        }
        var state = ""
        if (st != null) {
            state = st
        }
        return sessionsJson(sessions, device, state)
    }

    app.get("/sessions/:id") {
        var e: SessionInfo? = sessionResolve(sessions, param("id"))
        if (e == null) {
            return "SES001: unknown session " + param("id")
        }
        var tk: String? = query("token")
        var holdsToken = tk != null && tk == e.token
        if (!holdsToken) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        return json.encode(e)
    }

    app.post("/sessions/:id/claim") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = sessionClaim(sessions, devices, param("id"), time.now())
        if (r != "OK") {
            return r
        }
        if (npath.length() > 0) {
            controlSaveList(npath, sessionsJson(sessions, "", ""))
        }
        var e: SessionInfo? = sessionResolve(sessions, param("id"))
        if (e == null) {
            return "SES001: unknown session " + param("id")
        }
        return "SESSION-STATE: CLAIMED"
    }

    // Advance: token-holder (recipient client) OR account bearer (owner) —
    // SES003/SES002 refusals ride the pure matrix, never re-decided here.
    app.post("/sessions/:id/advance") {
        var e: SessionInfo? = sessionResolve(sessions, param("id"))
        if (e == null) {
            return "SES001: unknown session " + param("id")
        }
        var tk: String? = query("token")
        var holdsToken = tk != null && tk == e.token
        if (!holdsToken) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        var a = json.decode<AdvanceRequest>(body())
        var to = a.to
        if (to == "CLAIMED") {
            // CLAIMED has its own door ONLY (sessionClaim stamps the owner
            // address from the registry) — never the generic advance, not
            // even for a bearer, and DEFINITELY not for the token holder:
            // the recipient cannot pick up its own request (measured 05/10:
            // the first guard was !holdsToken, which let exactly that pass
            // whenever the recipient's POST also carried an account).
            return "SES002: use /claim to pick up a session"
        }
        var r = sessionAdvance(sessions, param("id"), to, a.transport, time.now())
        if (r != "OK") {
            return r
        }
        if (npath.length() > 0) {
            controlSaveList(npath, sessionsJson(sessions, "", ""))
        }
        return "SESSION-STATE: " + to
    }

    // ── TRACK D presence ── a beat says "this device can serve NOW" (the
    // serve process beats on LISTEN; a cron daemon may beat via `cli
    // heartbeat`). Unknown devices (never beat, legacy) are NOT refused —
    // Track M. OFFLINE blocks the GRANT only (the share stays valid: the
    // prompt's law — "não transformar em erro de share").
    app.post("/devices/:id/heartbeat") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = presenceBeat(presences, param("id"), time.now())
        if (r != "OK") {
            return r
        }
        if (ppath.length() > 0) {
            controlSaveList(ppath, presenceJson(presences))
        }
        return "HEARTBEAT-OK: " + param("id")
    }

    app.get("/presence/:id") {
        return presenceStatus(presences, param("id"), time.now())
    }

    app.listen(port)
}

// Gate: runtime verifies the JWT signature (auth.authenticated reads the
// Authorization bearer of the current request); AUTH001 = absent or bad
// signature; then the IDENTITY check against the table (revocation). A
// malformed-but-present Authorization is rejected by the runtime itself
// (step 6 of the web security dispatch: {"error":"unauthorized"}), which is
// the measured, documented behavior — the handler never sees it.
String controlAuthGate(Map<String, Account> accounts) {
    if (!auth.authenticated()) {
        return "AUTH001: missing bearer"
    }
    var sub = authParseSub(auth.claims())
    return authActive(accounts, sub)
}

Int activeAccounts(Map<String, Account> accounts) {
    var n = 0
    var ids = accounts.keys()
    ids.sort()
    for (var id in ids) {
        var a: Account? = accounts.get(id)
        if (a != null && a.status == "active") {
            n = n + 1
        }
    }
    return n
}
