package kofshare.control

import kofshare.control.registry
import kofshare.control.share
import kofshare.control.auth
import kof.json
import kof.security
import kof.time
import kof.auth

// Control-plane HTTP surface (architecture.md §4, implementation-plan slice 2).
// The app owns NOTHING: the registries are passed in, so the pure registry
// slice 1 stays the domain authority and this file is transport sugar.
// listen() blocks — the server main runs it; stop = process lifecycle
// (v1 is a LAN daemon). NOTE: lambdas here capture ONLY the registry maps —
// capture of the app handle became LEGAL on JVM after Kof4j §575 was fixed
// (JvmTypeMapper erases the phantom descriptor); we still choose NOT to
// capture — daemon lifecycle = process lifecycle.
// C2 (vote D2=A): /shares mints bearer grants over offers — token =
// security.randomHex(32), signed with the control Ed25519 key (C1 face);
// /s/<token> is the authorization gate (shareTouch decides; only "OK"
// serves offer metadata). The SECRET stays a Secret handle end to end.

void controlServe(Int port, Map<String, DeviceInfo> devices, Map<String, OfferInfo> offers, String dpath, String opath, Map<String, ShareInfo> shares, String spath, Secret controlKey, Map<String, Account> accounts, String apath, String controlSecret) {
    var app = web.app()

    app.get("/devices") {
        return controlDevicesJson(devices)
    }

    app.get("/devices/:id") {
        var d: DeviceInfo? = controlResolve(devices, param("id"))
        if (d == null) {
            return "DEVICE-NOT-FOUND: " + param("id")
        }
        return json.encode(d)
    }

    app.post("/devices") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var d = json.decode<DeviceInfo>(body())
        var r = controlRegister(devices, d)
        if (r != "OK") {
            return r
        }
        if (dpath.length() > 0) {
            controlSaveList(dpath, controlDevicesJson(devices))
        }
        return "REGISTERED: " + d.id()
    }

    app.get("/offers") {
        var dv: String? = query("device")
        var filter = ""
        if (dv != null) {
            filter = dv
        }
        return controlOffersJson(offers, filter)
    }

    app.post("/offers") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var q = json.decode<OfferRequest>(body())
        // A4: the SERVER stamps freshness — the client cannot fake createdAt
        // or resurrect an expired id from the wire.
        var o = OfferInfo(q.id, q.deviceId, q.path, q.size, q.sha256Hex, time.now())
        var r = controlOffer(offers, devices, o)
        if (r != "OK") {
            return r
        }
        if (opath.length() > 0) {
            controlSaveList(opath, controlOffersJson(offers, ""))
        }
        return "OFFERED: " + o.id()
    }

    app.delete("/offers/:id") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = controlRevoke(offers, param("id"))
        if (r != "OK") {
            return r
        }
        if (opath.length() > 0) {
            controlSaveList(opath, controlOffersJson(offers, ""))
        }
        return "REVOKED: " + param("id")
    }

    app.get("/health") {
        return "OK"
    }

    // C3 (vote D3=B): mutations and sensitive listings require a bearer key.
    // Bootstrap law (documented, measured): the FIRST account on an EMPTY
    // table is open enrollment — the owner mints their own admin key; once
    // the table has an active account everything else needs it.
    app.post("/accounts") {
        // Bootstrap law (documented, measured): the FIRST account on an EMPTY
        // table is open enrollment — the owner mints their own bearer; once an
        // active account exists everything else needs one.
        if (activeAccounts(accounts) > 0) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        var req = json.decode<AccountRequest>(body())
        var r = authIssue(accounts, req.id, req.label, time.now())
        if (r != "OK") {
            return r
        }
        if (apath.length() > 0) {
            controlSaveList(apath, authAccountsJson(accounts))
        }
        var ttl = 0
        if (req.ttlSec > 0) {
            ttl = req.ttlSec
        } else {
            ttl = 86400
        }
        return "APIKEY " + authMint(controlSecret, req.id, req.label, ttl)
    }

    app.get("/accounts") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return authAccountsJson(accounts)
    }

    app.post("/accounts/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = authRevoke(accounts, param("id"))
        if (r != "OK") {
            return r
        }
        if (apath.length() > 0) {
            controlSaveList(apath, authAccountsJson(accounts))
        }
        return "ACCOUNT-REVOKED: " + param("id")
    }

    app.post("/shares") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var req = json.decode<ShareRequest>(body())
        var o: OfferInfo? = controlResolveOffer(offers, req.offerId)
        if (o == null) {
            return "REG033: unknown offer " + req.offerId
        }
        if (controlResolve(devices, o.deviceId) == null) {
            return "REG032: unknown device " + o.deviceId
        }
        var now = time.now()
        var id = "sh" + security.randomHex(8)
        var token = security.randomHex(32)
        var perms = "read-write"
        if (req.readOnly) {
            perms = "read"
        }
        // HONEST type from the start: the slot is Long (assigning a widened
        // Long over an Int-inferred local inside a route lambda hits Kof4j
        // §583 — recorded, not hidden: the typed declaration is the correct
        // Kof form, the emitter bug is the ledger's).
        var expires: Long = 0
        if (req.ttlMs > 0) {
            expires = now + req.ttlMs
        }
        var core = ShareInfo(id, token, o.deviceId, req.offerId, perms, now, expires, req.maxUses, 0, "active", "", "")
        var signed = ShareInfo(core.id, core.token, core.deviceId, core.offerId, core.permissions, core.createdAt, core.expiresAt, core.maxUses, core.used, core.status, core.revocation, shareSign(controlKey, core))
        var r = shareIssue(shares, signed)
        if (r != "OK") {
            return r
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return "SHARED " + id + " " + token
    }

    app.get("/shares") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return sharesJson(shares)
    }

    app.get("/s/:token") {
        var now = time.now()
        var r = shareTouch(shares, param("token"), now)
        if (r != "OK") {
            return r
        }
        var s = shareResolve(shares, param("token"))
        if (s == null) {
            return "REG035: unknown share token"
        }
        var o: OfferInfo? = controlResolveOffer(offers, s.offerId)
        if (o == null) {
            return "REG034: offer vanished " + s.offerId
        }
        var d: DeviceInfo? = controlResolve(devices, o.deviceId)
        if (d == null) {
            return "REG032: unknown device " + o.deviceId
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return json.encode(ShareGrant(o.id, o.path, o.size, o.sha256Hex, d.address, s.permissions))
    }

    app.post("/shares/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var rs: String? = query("reason")
        var reason = ""
        if (rs != null) {
            reason = rs
        }
        var r = shareRevoke(shares, param("id"), reason)
        if (r != "OK") {
            return r
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return "SHARE-REVOKED: " + param("id")
    }

    app.listen(port)
}

// Gate: runtime verifies the JWT signature (auth.authenticated reads the
// Authorization bearer of the current request); AUTH001 = absent or bad
// signature; then the IDENTITY check against the table (revocation). A
// malformed-but-present Authorization is rejected by the runtime itself
// (step 6 of the web security dispatch: {"error":"unauthorized"}), which is
// the measured, documented behavior — the handler never sees it.
String controlAuthGate(Map<String, Account> accounts) {
    if (!auth.authenticated()) {
        return "AUTH001: missing bearer"
    }
    var sub = authParseSub(auth.claims())
    return authActive(accounts, sub)
}

Int activeAccounts(Map<String, Account> accounts) {
    var n = 0
    var ids = accounts.keys()
    ids.sort()
    for (var id in ids) {
        var a: Account? = accounts.get(id)
        if (a != null && a.status == "active") {
            n = n + 1
        }
    }
    return n
}
