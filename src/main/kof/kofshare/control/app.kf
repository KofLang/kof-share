package kofshare.control

import kofshare.control.registry
import kofshare.control.share
import kofshare.control.auth
import kofshare.control.session
import kofshare.control.presence
import kof.json
import kof.security
import kof.time
import kof.auth

// Control-plane HTTP surface (architecture.md §4, implementation-plan slice 2).
// The app owns NOTHING: the registries are passed in, so the pure registry
// slice 1 stays the domain authority and this file is transport sugar.
// listen() blocks — the server main runs it; stop = process lifecycle
// (v1 is a LAN daemon). NOTE: lambdas here capture ONLY the registry maps —
// capture of the app handle became LEGAL on JVM after Kof4j §575 was fixed
// (JvmTypeMapper erases the phantom descriptor); we still choose NOT to
// capture — daemon lifecycle = process lifecycle.
// C2 (vote D2=A): /shares mints bearer grants over offers — token =
// security.randomHex(32), signed with the control Ed25519 key (C1 face);
// /s/<token> is the authorization gate (shareTouch decides; only "OK"
// serves offer metadata). The SECRET stays a Secret handle end to end.

void controlServe(Int port, Map<String, DeviceInfo> devices, Map<String, OfferInfo> offers, String dpath, String opath, Map<String, ShareInfo> shares, String spath, Secret controlKey, Map<String, Account> accounts, String apath, String controlSecret, Map<String, DeviceKey> devkeys, String kpath, Map<String, SessionInfo> sessions, String npath, Map<String, PresenceInfo> presences, String ppath) {
    var app = web.app()

    app.get("/devices") {
        return controlDevicesJson(devices)
    }

    app.get("/devices/:id") {
        var d: DeviceInfo? = controlResolve(devices, param("id"))
        if (d == null) {
            return "DEVICE-NOT-FOUND: " + param("id")
        }
        return json.encode(d)
    }

    app.post("/devices") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var d = json.decode<DeviceInfo>(body())
        var r = controlRegister(devices, d)
        if (r != "OK") {
            return r
        }
        if (dpath.length() > 0) {
            controlSaveList(dpath, controlDevicesJson(devices))
        }
        return "REGISTERED: " + d.id()
    }

    // TRACK A enrollment lane (product evolution 05/10). The v1 route above
    // is UNCHANGED (Track M): keyless DeviceInfo bodies still register. Here
    // the device proves it HOLDS the private half over a canonical
    // registration string; the plane stores ONLY the public 64-hex (TOFU:
    // first enrollment trusts the self-signature, later ops verify against
    // the stored key). Same persistence discipline as devices (quasi-atomic
    // save after every mutation).
    app.post("/devices/register") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = json.decode<DeviceRegister>(body())
        var v = controlEnroll(devices, devkeys, r)
        if (v != "OK") {
            return v
        }
        if (dpath.length() > 0) {
            controlSaveList(dpath, controlDevicesJson(devices))
        }
        if (kpath.length() > 0) {
            controlSaveList(kpath, controlDevkeysJson(devkeys))
        }
        return "REGISTERED: " + r.id()
    }

    app.get("/device-keys/:id") {
        var k: DeviceKey? = devkeys.get(param("id"))
        if (k == null) {
            return "DEV001: no public key for device " + param("id")
        }
        return "PUB: " + k.pub + " STATUS: " + k.status
    }

    app.post("/devices/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var v = controlDeviceRevoke(devkeys, param("id"))
        if (v != "OK") {
            return v
        }
        if (kpath.length() > 0) {
            controlSaveList(kpath, controlDevkeysJson(devkeys))
        }
        return "DEVICE-REVOKED: " + param("id")
    }

    app.get("/offers") {
        var dv: String? = query("device")
        var filter = ""
        if (dv != null) {
            filter = dv
        }
        return controlOffersJson(offers, filter)
    }

    app.post("/offers") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var q = json.decode<OfferRequest>(body())
        // TRACK A gate FIRST (measured before landing: the naive order ran
        // controlOffer — which INSERTS — before the signature check, leaving
        // a refused offer half-present in the registry): a device that
        // ENROLLED a key signs its offers. Contextual rule (Track I:
        // "token válido ≠ acesso ilimitado") — keyless v1 devices pass.
        var ig = controlOfferChecked(devkeys, q)
        if (ig != "OK") {
            return ig
        }
        // A4: the SERVER stamps freshness — the client cannot fake createdAt
        // or resurrect an expired id from the wire.
        var o = OfferInfo(q.id, q.deviceId, q.path, q.size, q.sha256Hex, time.now())
        var r = controlOffer(offers, devices, o)
        if (r != "OK") {
            return r
        }
        if (opath.length() > 0) {
            controlSaveList(opath, controlOffersJson(offers, ""))
        }
        return "OFFERED: " + o.id()
    }

    app.delete("/offers/:id") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = controlRevoke(offers, param("id"))
        if (r != "OK") {
            return r
        }
        if (opath.length() > 0) {
            controlSaveList(opath, controlOffersJson(offers, ""))
        }
        return "REVOKED: " + param("id")
    }

    app.get("/health") {
        return "OK"
    }

    // C3 (vote D3=B): mutations and sensitive listings require a bearer key.
    // Bootstrap law (documented, measured): the FIRST account on an EMPTY
    // table is open enrollment — the owner mints their own admin key; once
    // the table has an active account everything else needs it.
    app.post("/accounts") {
        // Bootstrap law (documented, measured): the FIRST account on an EMPTY
        // table is open enrollment — the owner mints their own bearer; once an
        // active account exists everything else needs one.
        if (activeAccounts(accounts) > 0) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        var req = json.decode<AccountRequest>(body())
        var r = authIssue(accounts, req.id, req.label, time.now())
        if (r != "OK") {
            return r
        }
        if (apath.length() > 0) {
            controlSaveList(apath, authAccountsJson(accounts))
        }
        var ttl = 0
        if (req.ttlSec > 0) {
            ttl = req.ttlSec
        } else {
            ttl = 86400
        }
        return "APIKEY " + authMint(controlSecret, req.id, req.label, ttl)
    }

    app.get("/accounts") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return authAccountsJson(accounts)
    }

    app.post("/accounts/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = authRevoke(accounts, param("id"))
        if (r != "OK") {
            return r
        }
        if (apath.length() > 0) {
            controlSaveList(apath, authAccountsJson(accounts))
        }
        return "ACCOUNT-REVOKED: " + param("id")
    }

    app.post("/shares") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var req = json.decode<ShareRequest>(body())
        var o: OfferInfo? = controlResolveOffer(offers, req.offerId)
        if (o == null) {
            return "REG033: unknown offer " + req.offerId
        }
        if (controlResolve(devices, o.deviceId) == null) {
            return "REG032: unknown device " + o.deviceId
        }
        var now = time.now()
        var id = "sh" + security.randomHex(8)
        var token = security.randomHex(32)
        var perms = "read-write"
        if (req.readOnly) {
            perms = "read"
        }
        // HONEST type from the start: the slot is Long (assigning a widened
        // Long over an Int-inferred local inside a route lambda hits Kof4j
        // §583 — recorded, not hidden: the typed declaration is the correct
        // Kof form, the emitter bug is the ledger's).
        var expires: Long = 0
        if (req.ttlMs > 0) {
            expires = now + req.ttlMs
        }
        var core = ShareInfo(id, token, o.deviceId, req.offerId, perms, now, expires, req.maxUses, 0, "active", "", "")
        var signed = ShareInfo(core.id, core.token, core.deviceId, core.offerId, core.permissions, core.createdAt, core.expiresAt, core.maxUses, core.used, core.status, core.revocation, shareSign(controlKey, core))
        var r = shareIssue(shares, signed)
        if (r != "OK") {
            return r
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return "SHARED " + id + " " + token
    }

    app.get("/shares") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        return sharesJson(shares)
    }

    app.get("/s/:token") {
        var now = time.now()
        var r = shareTouch(shares, param("token"), now)
        if (r != "OK") {
            return r
        }
        var s = shareResolve(shares, param("token"))
        if (s == null) {
            return "REG035: unknown share token"
        }
        var o: OfferInfo? = controlResolveOffer(offers, s.offerId)
        if (o == null) {
            return "REG034: offer vanished " + s.offerId
        }
        var d: DeviceInfo? = controlResolve(devices, o.deviceId)
        if (d == null) {
            return "REG032: unknown device " + o.deviceId
        }
        // TRACK A revocation reaches the DATA path here (not only future
        // enrollments): the grant names a device; if that device's key is
        // revoked, the authorization it carries is dead — by name.
        var k: DeviceKey? = devkeys.get(o.deviceId)
        if (k != null && k.status == "revoked") {
            return "DEV003: device revoked " + o.deviceId
        }
        // TRACK D: an ENROLLED-or-known device that is explicitly OFFLINE
        // refuses the grant BY NAME — never a fake success, never a lie of
        // availability (the file is NOT storable here; the owner must be up).
        var pg = presenceGate(presences, o.deviceId, time.now())
        if (pg != "OK") {
            return pg
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return json.encode(ShareGrant(o.id, o.path, o.size, o.sha256Hex, d.address, s.permissions))
    }

    app.post("/shares/:id/revoke") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var rs: String? = query("reason")
        var reason = ""
        if (rs != null) {
            reason = rs
        }
        var r = shareRevoke(shares, param("id"), reason)
        if (r != "OK") {
            return r
        }
        if (spath.length() > 0) {
            controlSaveList(spath, sharesJson(shares))
        }
        return "SHARE-REVOKED: " + param("id")
    }

    // ── TRACK C — session signaling (the plane COORDINATES, never carries
    // bytes). POST /sessions: recipient (bearer-gated — the same account law
    // as every mutation) opens the rendezvous with the share TOKEN plus its
    // own device identity; the owner learns about it ONLY through
    // GET/sessions?device=self&state=CREATED (pull — the runtime web face has
    // no server-push yet, honest v1 signaling; SSE is a Kof4j face already
    // available server-side for Track E's page). Role matrix enforced below:
    // CLAIMED is owner-only (bearer); the token holder may drive
    // NEGOTIATING/CONNECTED/TRANSFERRING/FAILED/CANCELLED; COMPLETED belongs
    // to whoever holds proof (either face); persistence after every mutation.
    app.post("/sessions") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var req = json.decode<SessionRequest>(body())
        var sid = "se" + security.randomHex(8)
        var r = sessionCreate(sessions, shares, sid, req, time.now())
        if (r != "OK") {
            return r
        }
        if (npath.length() > 0) {
            controlSaveList(npath, sessionsJson(sessions, "", ""))
        }
        return "SESSION-CREATED: " + sid
    }

    app.get("/sessions") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var dv: String? = query("device")
        var st: String? = query("state")
        var device = ""
        if (dv != null) {
            device = dv
        }
        var state = ""
        if (st != null) {
            state = st
        }
        return sessionsJson(sessions, device, state)
    }

    app.get("/sessions/:id") {
        var e: SessionInfo? = sessionResolve(sessions, param("id"))
        if (e == null) {
            return "SES001: unknown session " + param("id")
        }
        var tk: String? = query("token")
        var holdsToken = tk != null && tk == e.token
        if (!holdsToken) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        return json.encode(e)
    }

    app.post("/sessions/:id/claim") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = sessionClaim(sessions, devices, param("id"), time.now())
        if (r != "OK") {
            return r
        }
        if (npath.length() > 0) {
            controlSaveList(npath, sessionsJson(sessions, "", ""))
        }
        var e: SessionInfo? = sessionResolve(sessions, param("id"))
        if (e == null) {
            return "SES001: unknown session " + param("id")
        }
        return "SESSION-STATE: CLAIMED"
    }

    // Advance: token-holder (recipient client) OR account bearer (owner) —
    // SES003/SES002 refusals ride the pure matrix, never re-decided here.
    app.post("/sessions/:id/advance") {
        var e: SessionInfo? = sessionResolve(sessions, param("id"))
        if (e == null) {
            return "SES001: unknown session " + param("id")
        }
        var tk: String? = query("token")
        var holdsToken = tk != null && tk == e.token
        if (!holdsToken) {
            var g = controlAuthGate(accounts)
            if (g != "OK") {
                return g
            }
        }
        var a = json.decode<AdvanceRequest>(body())
        var to = a.to
        if (to == "CLAIMED") {
            // CLAIMED has its own door ONLY (sessionClaim stamps the owner
            // address from the registry) — never the generic advance, not
            // even for a bearer, and DEFINITELY not for the token holder:
            // the recipient cannot pick up its own request (measured 05/10:
            // the first guard was !holdsToken, which let exactly that pass
            // whenever the recipient's POST also carried an account).
            return "SES002: use /claim to pick up a session"
        }
        var r = sessionAdvance(sessions, param("id"), to, a.transport, time.now())
        if (r != "OK") {
            return r
        }
        if (npath.length() > 0) {
            controlSaveList(npath, sessionsJson(sessions, "", ""))
        }
        return "SESSION-STATE: " + to
    }

    // ── TRACK D presence ── a beat says "this device can serve NOW" (the
    // serve process beats on LISTEN; a cron daemon may beat via `cli
    // heartbeat`). Unknown devices (never beat, legacy) are NOT refused —
    // Track M. OFFLINE blocks the GRANT only (the share stays valid: the
    // prompt's law — "não transformar em erro de share").
    app.post("/devices/:id/heartbeat") {
        var g = controlAuthGate(accounts)
        if (g != "OK") {
            return g
        }
        var r = presenceBeat(presences, param("id"), time.now())
        if (r != "OK") {
            return r
        }
        if (ppath.length() > 0) {
            controlSaveList(ppath, presenceJson(presences))
        }
        return "HEARTBEAT-OK: " + param("id")
    }

    app.get("/presence/:id") {
        return presenceStatus(presences, param("id"), time.now())
    }

    app.listen(port)
}

// Gate: runtime verifies the JWT signature (auth.authenticated reads the
// Authorization bearer of the current request); AUTH001 = absent or bad
// signature; then the IDENTITY check against the table (revocation). A
// malformed-but-present Authorization is rejected by the runtime itself
// (step 6 of the web security dispatch: {"error":"unauthorized"}), which is
// the measured, documented behavior — the handler never sees it.
String controlAuthGate(Map<String, Account> accounts) {
    if (!auth.authenticated()) {
        return "AUTH001: missing bearer"
    }
    var sub = authParseSub(auth.claims())
    return authActive(accounts, sub)
}

Int activeAccounts(Map<String, Account> accounts) {
    var n = 0
    var ids = accounts.keys()
    ids.sort()
    for (var id in ids) {
        var a: Account? = accounts.get(id)
        if (a != null && a.status == "active") {
            n = n + 1
        }
    }
    return n
}
