package kofshare.control

import kof.json
import kofshare.identity

// Control-plane registry (implementation-plan.md §2 Fatia 1). PURE domain:
// the maps are passed in and mutated in place (no IO, no time, no randomness
// — ids and addresses are arguments, which is what makes the golden stable).
// HTTP handlers (fatia 2) wrap exactly these verbs; CLI (fatia 3) drives them.

record DeviceInfo(String id, String name, String address)
record OfferInfo(String id, String deviceId, String path, Int size, String sha256Hex, Long createdAt)

// A4 wire contract: what the CLIENT may send. The server stamps createdAt
// itself — a client cannot fake freshness or resurrect expired ids.
record OfferRequest(String id, String deviceId, String path, Int size, String sha256Hex, String offerSig)

Long offerTtlMs() {
    return 86400000
}

String controlRegister(Map<String, DeviceInfo> devices, DeviceInfo d) {
    if (d.id.length() == 0) {
        return "REG001: empty device id"
    }
    if (d.address.length() == 0) {
        return "REG002: empty device address"
    }
    devices.put(d.id, d)
    return "OK"
}

DeviceInfo? controlResolve(Map<String, DeviceInfo> devices, String id) {
    return devices.get(id)
}

String controlDevicesJson(Map<String, DeviceInfo> devices) {
    var out = new List<DeviceInfo>()
    var ids = devices.keys()
    ids.sort()  // golden-stable: map order is not a contract
    for (var id in ids) {
        var d: DeviceInfo? = devices.get(id)
        if (d != null) {
            out.add(d)
        }
    }
    return json.encode(out)
}

String controlOffer(Map<String, OfferInfo> offers, Map<String, DeviceInfo> devices, OfferInfo o) {
    if (o.id.length() == 0) {
        return "REG003: empty offer id"
    }
    var dev: DeviceInfo? = devices.get(o.deviceId)
    if (dev == null) {
        return "REG004: unknown device " + o.deviceId
    }
    if (o.path.length() == 0) {
        return "REG005: empty offer path"
    }
    if (o.size <= 0) {
        return "REG006: non-positive offer size"
    }
    if (o.sha256Hex.length() != 64) {
        return "REG007: digest must be 64 hex chars"
    }
    if (o.createdAt <= 0) {
        return "REG010: offer has no registration timestamp"
    }
    offers.put(o.id, o)
    return "OK"
}

// A4 registry hygiene (pure over the passed table): drop offers older than
// `ttlMs` AND offers pointing at unknown devices. Returns how many were
// dropped — the caller logs it; behavior is never silent.
Int controlPurgeExpired(Map<String, OfferInfo> offers, Map<String, DeviceInfo> devices, Long now, Long ttlMs) {
    var dropped = 0
    var ids = offers.keys()
    ids.sort()
    for (var id in ids) {
        var o: OfferInfo? = offers.get(id)
        if (o != null) {
        if (now - o.createdAt > ttlMs || devices.get(o.deviceId) == null) {
            offers.remove(id)
            dropped = dropped + 1
        }
        }
    }
    return dropped
}

OfferInfo? controlResolveOffer(Map<String, OfferInfo> offers, String id) {
    return offers.get(id)
}

String controlOffersJson(Map<String, OfferInfo> offers, String deviceId) {
    var out = new List<OfferInfo>()
    var ids = offers.keys()
    ids.sort()  // golden-stable: map order is not a contract
    for (var id in ids) {
        var o: OfferInfo? = offers.get(id)
        if (o != null && (deviceId.length() == 0 || o.deviceId == deviceId)) {
            out.add(o)
        }
    }
    return json.encode(out)
}

String controlRevoke(Map<String, OfferInfo> offers, String id) {
    var o: OfferInfo? = offers.get(id)
    if (o == null) {
        return "REG008: unknown offer " + id
    }
    offers.remove(id)
    return "OK"
}

// Malformed JSON must die by NAME (R6), never silently half-decode.
String controlDecodeDevice(String body) {
    var d = json.decode<DeviceInfo>(body)
    return "decoded=" + d.id()
}

// A1 (next-plan §1): registry persistence. Two files (devices + offers), each a
// sorted JSON list — the SAME format the HTTP routes serve, so save/load and
// the wire agree by construction. Quasi-atomic write: temp + moveTo (rename).
// Corrupt JSON refuses by name (REG009), never a silent empty load.

String controlSaveList(String path, String text) {
    var tmp = path + ".tmp"
    var f = File(tmp)
    if (!f.writeText(text)) {
        return "REG011: cannot write " + tmp
    }
    var old = File(path)
    if (old.exists()) {
        old.delete()
    }
    if (!f.moveTo(path)) {
        return "REG011: cannot finalize " + path
    }
    return "OK"
}

String controlLoadList(String path, Map<String, DeviceInfo> devices, Map<String, OfferInfo> offers) {
    var f = File(path)
    if (!f.exists()) {
        return "OK"  // fresh registry, not an error
    }
    var txt = f.readText()
    if (txt == null) {
        return "REG009: unreadable registry " + path
    }
    var dlist = new List<DeviceInfo>()
    var olist = new List<OfferInfo>()
    try {
        if (devices != null) {
            var ds: List<DeviceInfo> = json.decode<List<DeviceInfo>>(txt)
            for (var d in ds) {
                devices.put(d.id, d)
            }
        } else {
            var os: List<OfferInfo> = json.decode<List<OfferInfo>>(txt)
            for (var o in os) {
                offers.put(o.id, o)
            }
        }
    } catch (String e) {
        return "REG009: corrupt registry " + path + ": " + e
    }
    return "OK"
}

// ── TRACK A — device identity binding (product evolution 05/10) ──────────
// The v1 surfaces above stay EXACTLY as they are (Track M): DeviceInfo's wire
// does not change, POST /devices with a v1 body still registers without a
// key. The identity story lives in a PARALLEL binding table: deviceId ->
// DeviceKey{pub,status}. Enrollment is TOFU (first enrollment trusts the
// self-signed proof; every later op must verify against the stored PUBLIC
// half only). Named refusals (R6): DEV001 no key bound · DEV002 signature
// invalid · DEV003 device revoked · DEV004 signature required ·
// DEV005 deviceId does not match public key.

record DeviceKey(String deviceId, String pub, String status)

// What the NEW client posts on /devices (superset of DeviceInfo; a v1 body
// decodes with null pub/regSig — the app route treats that as the LEGACY
// path. Missing fields decode as null, measured 05/10 — normalize first).
record DeviceRegister(String id, String name, String address, String pub, String regSig)


String controlEnroll(Map<String, DeviceInfo> devices, Map<String, DeviceKey> devkeys, DeviceRegister r) {
    var id = r.id
    var name = r.name
    var address = r.address
    var pub = r.pub
    var sig = r.regSig
    if (id == null) {
        id = ""
    }
    if (name == null) {
        name = ""
    }
    if (address == null) {
        address = ""
    }
    if (pub == null) {
        pub = ""
    }
    if (sig == null) {
        sig = ""
    }
    if (id.length() == 0) {
        return "REG001: empty device id"
    }
    if (address.length() == 0) {
        return "REG002: empty device address"
    }
    if (pub.length() != 64) {
        return "DEV005: public key must be 64 hex chars"
    }
    if (identityDeviceId(pub) != id) {
        return "DEV005: deviceId " + id + " does not match public key"
    }
    var existing: DeviceKey? = devkeys.get(id)
    if (existing != null && existing.status == "revoked") {
        return "DEV003: device revoked " + id
    }
    if (sig.length() == 0) {
        return "DEV004: enrollment requires a signature over the registration"
    }
    if (!verifyReg(pub, id, name, address, sig)) {
        return "DEV002: enrollment signature invalid"
    }
    if (existing != null && existing.pub != pub) {
        return "DEV005: device id already bound to a different public key"
    }
    devices.put(id, DeviceInfo(id, name, address))
    devkeys.put(id, DeviceKey(id, pub, "active"))
    return "OK"
}

// The TRACK A identity gate for offers — ONE pure function, used by the HTTP
// route BEFORE insertion (a refused signature must never half-insert). Keyless
// v1 devices are untouched (Track M); an ENROLLED device must present a valid
// signature over the canonical offer string. offerSig arrives null from v1
// bodies (missing field decodes as null — measured 05/10), normalized here.
String controlOfferChecked(Map<String, DeviceKey> devkeys, OfferRequest q) {
    var key: DeviceKey? = devkeys.get(q.deviceId)
    if (key == null) {
        return "OK"
    }
    if (key.status == "revoked") {
        return "DEV003: device revoked " + q.deviceId
    }
    var sig = q.offerSig
    if (sig == null) {
        sig = ""
    }
    if (sig.length() == 0) {
        return "DEV004: signed offer requires a signature"
    }
    if (!verifyOffer(key.pub, q.id, q.deviceId, q.path, q.size, q.sha256Hex, sig)) {
        return "DEV002: offer signature invalid"
    }
    return "OK"
}

String controlDeviceRevoke(Map<String, DeviceKey> devkeys, String id) {
    var key: DeviceKey? = devkeys.get(id)
    if (key == null) {
        return "DEV001: no public key for device " + id
    }
    devkeys.put(id, DeviceKey(key.deviceId, key.pub, "revoked"))
    return "OK"
}

String controlDevkeysJson(Map<String, DeviceKey> devkeys) {
    var out = new List<DeviceKey>()
    var ids = devkeys.keys()
    ids.sort()
    for (var id in ids) {
        var k: DeviceKey? = devkeys.get(id)
        if (k != null) {
            out.add(k)
        }
    }
    return json.encode(out)
}

String controlLoadDevkeys(Map<String, DeviceKey> devkeys, String path) {
    var f = File(path)
    if (!f.exists()) {
        return "OK"
    }
    var txt = f.readText()
    if (txt == null) {
        return "REG009: unreadable devkeys registry " + path
    }
    try {
        var list: List<DeviceKey> = json.decode<List<DeviceKey>>(txt)
        for (var k in list) {
            devkeys.put(k.deviceId, k)
        }
    } catch (String e) {
        return "REG009: corrupt devkeys registry " + path + ": " + e
    }
    return "OK"
}
