package kofshare.control

import kof.json

// Control-plane registry (implementation-plan.md §2 Fatia 1). PURE domain:
// the maps are passed in and mutated in place (no IO, no time, no randomness
// — ids and addresses are arguments, which is what makes the golden stable).
// HTTP handlers (fatia 2) wrap exactly these verbs; CLI (fatia 3) drives them.

record DeviceInfo(String id, String name, String address)
record OfferInfo(String id, String deviceId, String path, Int size, String sha256Hex, Long createdAt)

// A4 wire contract: what the CLIENT may send. The server stamps createdAt
// itself — a client cannot fake freshness or resurrect expired ids.
record OfferRequest(String id, String deviceId, String path, Int size, String sha256Hex)

Long offerTtlMs() {
    return 86400000
}

String controlRegister(Map<String, DeviceInfo> devices, DeviceInfo d) {
    if (d.id.length() == 0) {
        return "REG001: empty device id"
    }
    if (d.address.length() == 0) {
        return "REG002: empty device address"
    }
    devices.put(d.id, d)
    return "OK"
}

DeviceInfo? controlResolve(Map<String, DeviceInfo> devices, String id) {
    return devices.get(id)
}

String controlDevicesJson(Map<String, DeviceInfo> devices) {
    var out = new List<DeviceInfo>()
    var ids = devices.keys()
    ids.sort()  // golden-stable: map order is not a contract
    for (var id in ids) {
        var d: DeviceInfo? = devices.get(id)
        if (d != null) {
            out.add(d)
        }
    }
    return json.encode(out)
}

String controlOffer(Map<String, OfferInfo> offers, Map<String, DeviceInfo> devices, OfferInfo o) {
    if (o.id.length() == 0) {
        return "REG003: empty offer id"
    }
    var dev: DeviceInfo? = devices.get(o.deviceId)
    if (dev == null) {
        return "REG004: unknown device " + o.deviceId
    }
    if (o.path.length() == 0) {
        return "REG005: empty offer path"
    }
    if (o.size <= 0) {
        return "REG006: non-positive offer size"
    }
    if (o.sha256Hex.length() != 64) {
        return "REG007: digest must be 64 hex chars"
    }
    if (o.createdAt <= 0) {
        return "REG010: offer has no registration timestamp"
    }
    offers.put(o.id, o)
    return "OK"
}

// A4 registry hygiene (pure over the passed table): drop offers older than
// `ttlMs` AND offers pointing at unknown devices. Returns how many were
// dropped — the caller logs it; behavior is never silent.
Int controlPurgeExpired(Map<String, OfferInfo> offers, Map<String, DeviceInfo> devices, Long now, Long ttlMs) {
    var dropped = 0
    var ids = offers.keys()
    ids.sort()
    for (var id in ids) {
        var o: OfferInfo? = offers.get(id)
        if (o != null) {
        if (now - o.createdAt > ttlMs || devices.get(o.deviceId) == null) {
            offers.remove(id)
            dropped = dropped + 1
        }
        }
    }
    return dropped
}

OfferInfo? controlResolveOffer(Map<String, OfferInfo> offers, String id) {
    return offers.get(id)
}

String controlOffersJson(Map<String, OfferInfo> offers, String deviceId) {
    var out = new List<OfferInfo>()
    var ids = offers.keys()
    ids.sort()  // golden-stable: map order is not a contract
    for (var id in ids) {
        var o: OfferInfo? = offers.get(id)
        if (o != null && (deviceId.length() == 0 || o.deviceId == deviceId)) {
            out.add(o)
        }
    }
    return json.encode(out)
}

String controlRevoke(Map<String, OfferInfo> offers, String id) {
    var o: OfferInfo? = offers.get(id)
    if (o == null) {
        return "REG008: unknown offer " + id
    }
    offers.remove(id)
    return "OK"
}

// Malformed JSON must die by NAME (R6), never silently half-decode.
String controlDecodeDevice(String body) {
    var d = json.decode<DeviceInfo>(body)
    return "decoded=" + d.id()
}

// A1 (next-plan §1): registry persistence. Two files (devices + offers), each a
// sorted JSON list — the SAME format the HTTP routes serve, so save/load and
// the wire agree by construction. Quasi-atomic write: temp + moveTo (rename).
// Corrupt JSON refuses by name (REG009), never a silent empty load.

String controlSaveList(String path, String text) {
    var tmp = path + ".tmp"
    var f = File(tmp)
    if (!f.writeText(text)) {
        return "REG011: cannot write " + tmp
    }
    var old = File(path)
    if (old.exists()) {
        old.delete()
    }
    if (!f.moveTo(path)) {
        return "REG011: cannot finalize " + path
    }
    return "OK"
}

String controlLoadList(String path, Map<String, DeviceInfo> devices, Map<String, OfferInfo> offers) {
    var f = File(path)
    if (!f.exists()) {
        return "OK"  // fresh registry, not an error
    }
    var txt = f.readText()
    if (txt == null) {
        return "REG009: unreadable registry " + path
    }
    var dlist = new List<DeviceInfo>()
    var olist = new List<OfferInfo>()
    try {
        if (devices != null) {
            var ds: List<DeviceInfo> = json.decode<List<DeviceInfo>>(txt)
            for (var d in ds) {
                devices.put(d.id, d)
            }
        } else {
            var os: List<OfferInfo> = json.decode<List<OfferInfo>>(txt)
            for (var o in os) {
                offers.put(o.id, o)
            }
        }
    } catch (String e) {
        return "REG009: corrupt registry " + path + ": " + e
    }
    return "OK"
}
