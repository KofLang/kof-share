package kofshare.desktop

// KofShare DESKTOP — FASE 1 (docs/desktop/discovery.md §9: desktop shell =
// lifecycle + window + health/state, the §5 F1 subset only: plane config,
// real connection state, process lifecycle. Share/receive/identity screens
// are F3–F5 and are NOT faked here — there are no mock buttons in this file).
//
// Architecture law (§3): the daemon is a THIN lane over the existing core —
// it reuses kofshare.core helpers verbatim (extraction shipped on this
// branch) and the existing product verbs by spawning the SAME cli.kf when a
// product action is needed (no second client with divergent rules, §7
// gigaprompt). The UI (page below) NEVER holds keys or the control bearer:
// it sees only the same metadata view model the browser lane proved
// (client.kf /api/info precedent). Local auth: EVERY /api/v1/* request needs
// the token from kofshare-desktop.token (0600, written at first start);
// mismatch → named DESKTOP-LOCAL-AUTH. The bind is 0.0.0.0 at the pin
// (R1/R2 — discovery §7): token law is the mitigation; the real fix is the
// named core face (§8-A/B), NOT a product hack.

import kof.http
import kof.time
import kof.process
import kof.shell
import kof.security
import kof.web
import kofshare.core
import kofshare.boundary
import kofshare.identity
import kof.fs
import kof.math
import kof.json

// coalesce nullable header (client.kf shape; COMP002-safe pattern).
String headerText(String? h) {
    if (h == null) {
        return ""
    }
    return h
}

String dConf() {
    return "kofshare-desktop.conf"
}

String dTokenFile() {
    return "kofshare-desktop.token"
}

String dPidFile() {
    return "kofshare-desktop.pid"
}

String dLog() {
    return "kofshare-desktop.log"
}

Int dPort() {
    var p = selfConfigField2("port")
    if (p.length() > 0) {
        return math.parseInt(p)
    }
    return 8799
}

String dPlane() {
    var pl = selfConfigField2("plane")
    if (pl.length() > 0) {
        return pl
    }
    return "http://127.0.0.1:9090"
}

// conf = the desktop's OWN file; selfConfigField is the cli.config reader —
// this reads kofshare-desktop.conf with the same loop shape (verbatim
// pattern from core.selfConfigField, only the path differs).
String selfConfigField2(String key) {
    if (!File(dConf()).exists()) {
        return ""
    }
    var t = File(dConf()).readText()
    if (t == null) {
        return ""
    }
    var lines = t.split("\n")
    var i = 0
    while (i < lines.size) {
        var ln = lines[i]
        if (ln.indexOf(key + "=") == 0) {
            return ln.substring(key.length() + 1, ln.length())
        }
        i = i + 1
    }
    return ""
}

String desktopToken() {
    var t = File(dTokenFile()).readText()
    if (t == null) {
        return ""
    }
    var tok = t
    var cut = tok.indexOf("\n")
    if (cut >= 0) {
        tok = tok.substring(0, cut)
    }
    return tok
}

void writeDesktopToken() {
    var tok = security.randomHex(16)
    File(dTokenFile()).writeText(tok)
    shell.run("chmod", listOf("600", dTokenFile()))
}

// request token = header x-kof-token (page JS sends it) — "" when absent.
Bool tokenOk() {
    return headerText(header("x-kof-token")) == desktopToken() && desktopToken().length() > 0
}

String authRefusal() {
    return "DESKTOP-LOCAL-AUTH"
}

String originRefusal() {
    return "DESKTOP-LOCAL-ORIGIN"
}

// The shared boundary gate for every /api/v1/* route: host + origin + token.
// "" means allowed; otherwise the named refusal is the body. Pure logic lives
// in kofshare.desktop.boundary (unit-tested); this wires it to the real
// request context. Order is outermost-first: host, origin, then the secret.
String boundaryOk() {
    if (!isLoopbackHost(strOr(header("host")))) {
        return originRefusal()
    }
    if (!originAllowed(strOr(header("origin")))) {
        return originRefusal()
    }
    if (!tokenOk()) {
        return authRefusal()
    }
    return ""
}

// query() is called in the route closure (proven F1: /page does query("tok"))
// and its nullable result is threaded here. Coalesce + parse live at top
// level (no web-context call in this fn).
Int sinceVal(String? q) {
    if (q == null) {
        return 0
    }
    if (q.length() == 0) {
        return 0
    }
    return math.parseInt(q)
}

// LIVE plane truth probed per call (no cached lie, §8): the TCP probe shape
// core.healthNow proved (raw ConnectException stays inside net's named wrap).
String planeState() {
    if (healthNow(dPlane())) {
        return "ok"
    }
    return "unreachable"
}

// ---- EVENT RING BUFFER (file-backed, client.kf appJobJson precedent) ----
// Events are ONLY the transitions the daemon can OBSERVE truthfully (§4.4
// gigaprompt: "eventos não podem inventar transições"): daemon lifecycle,
// plane presence. Transfer/share events will be emitted when the privileged
// mutating routes exist (Gate 1-priv, §DP). A fixed-size ring (JSONL lines,
// last 64) so state after restart is honest (re-query /state).
String dEventsFile() {
    return "kofshare-desktop.events"
}

// nullable-safe read (readText returns String? — COMP002 coalesce pattern).
String readOr(String path) {
    if (!File(path).exists()) {
        return ""
    }
    var t = File(path).readText()
    if (t == null) {
        return ""
    }
    return t
}

Int readEventsSeq() {
    var last = readOr(dEventsFile())
    if (last.length() == 0) {
        return 0
    }
    var lines = last.split("\n")
    var i = lines.size - 1
    while (i >= 0) {
        var ln = lines[i]
        if (ln.length() > 0) {
            var bar = ln.indexOf("|")
            if (bar > 0) {
                return math.parseInt(ln.substring(0, bar))
            }
        }
        i = i - 1
    }
    return 0
}

// seq|type|ts|payload-json  (JSONL, one per line; last 64 kept)
void recordEvent(String type, String payload) {
    var seq = readEventsSeq() + 1
    var line = "" + seq + "|" + type + "|" + time.now() + "|" + payload + "\n"
    var prev = readOr(dEventsFile())
    var lines = prev.split("\n")
    var keep = ""
    var start = 0
    if (lines.size > 63) {
        start = lines.size - 63
    }
    var i = start
    while (i < lines.size) {
        if (lines[i].length() > 0) {
            keep = keep + lines[i] + "\n"
        }
        i = i + 1
    }
    File(dEventsFile()).writeText(keep + line)
}

// events after seq N, formatted as JSON array of {seq,type,ts,payload}
String eventsJsonSince(Int since) {
    var raw = readOr(dEventsFile())
    var out = "["
    var first = true
    if (raw.length() > 0) {
        var lines = raw.split("\n")
        var i = 0
        while (i < lines.size) {
            var ln = lines[i]
            if (ln.length() > 0) {
                var p1 = ln.indexOf("|")
                var p2 = ln.indexOf("|", p1 + 1)
                var p3 = ln.indexOf("|", p2 + 1)
                if (p1 > 0 && p2 > p1 && p3 > p2) {
                    var s = math.parseInt(ln.substring(0, p1))
                    var ty = ln.substring(p1 + 1, p2)
                    var ts = ln.substring(p2 + 1, p3)
                    var pl = ln.substring(p3 + 1, ln.length())
                    if (s > since) {
                        if (!first) {
                            out = out + ","
                        }
                        out = out + "{\"seq\":" + s + ",\"type\":\"" + ty
                            + "\",\"ts\":" + ts + ",\"payload\":" + pl + "}"
                        first = false
                    }
                }
            }
            i = i + 1
        }
    }
    return out + "]"
}

// Background presence poller — records ONLY when the OBSERVED value flips
// (a transition, not a snapshot). The daemon owns the thread; shutdown kills
// the JVM (stop law) so no orphan.
void startPresenceEventLoop() {
    var last = planeState()
    recordEvent("PLANE_PRESENCE", "{\"state\":\"" + last + "\"}")
    spawn {
        while (true) {
            time.sleep(2000)
            var cur = planeState()
            if (cur != last) {
                recordEvent("PLANE_PRESENCE", "{\"state\":\"" + cur + "\"}")
                last = cur
            }
        }
    }
}

// Metadata-only view model (client.kf /api/info law): phase, plane, ports,
// version — NEVER keys, NEVER the control bearer, NEVER file contents.
String stateJson() {
    var pid = ""
    var raw = File(dPidFile()).readText()
    if (raw != null) {
        pid = raw
    }
    var cut = pid.indexOf("\n")
    if (cut >= 0) {
        pid = pid.substring(0, cut)
    }
    return "{\"phase\":\"READY\",\"plane\":\"" + planeState() + "\",\"planeAddr\":\""
        + dPlane() + "\",\"localPort\":" + dPort() + ",\"pid\":\"" + pid
        + "\",\"api\":\"v1\",\"product\":\"kofshare-desktop-f1\"}"
}


// ═════════════════════════════════════════════════════════════════════════
// GATE 1-PRIVILEGED (unlocked by the §DP OPTION A decision, 09/10/2026):
// the mutating local surface. Every route here rides the SAME boundary gate
// as the read subset (token + Host + Origin), and the account credential is
// stored 0600 device-local, passed to workers only via the bearer `file:`
// lane so it never lands in argv/process-table/logs. The plane remains the
// authorizer for every remote effect (whoami/owner-law/revocation).
// ═════════════════════════════════════════════════════════════════════════

record JobRow(String id, String kind, String state, String details, Long created)

String dCredFile() {
    return "kofshare-desktop.credential"
}

String dJobsFile() {
    return "kofshare-desktop.jobs"
}

List<JobRow> jobsRead() {
    var out = new List<JobRow>()
    var t = readOr(dJobsFile())
    if (t.length() == 0) {
        return out
    }
    var parsed = json.decode<List<JobRow>>(t)
    return parsed
}

void jobsWrite(List<JobRow> rows) {
    File(dJobsFile()).writeText(json.encode(rows))
}

// state-only transition: keeps the row's details (a transfer's dest is its
// progress anchor — the worker's marker text would erase the readable path).
void jobStateKeep(String jid, String state) {
    jobState(jid, state, "")
}

void jobState(String jid, String state, String details) {
    var rows = jobsRead()
    var i = 0
    while (i < rows.size) {
        var r = rows.get(i)
        if (r.id == jid) {
            var keep = details
            if (keep.length() == 0 && (state == "RUNNING" || state == "DONE")) {
                keep = r.details
            }
            rows.set(i, new JobRow(r.id, r.kind, state, keep, r.created))
        }
        i = i + 1
    }
    jobsWrite(rows)
}

String newJobId() {
    return "jb" + security.randomHex(4)
}

// share-id for a token, parsed from the plane's table text (quoted seg that
// starts with "sh", immediately-before the token value).
String sidForToken(String table, String token) {
    var idx = table.indexOf(token)
    if (idx < 0) {
        return ""
    }
    var back = table.substring(0, idx)
    var i = back.length() - 1
    while (i >= 0) {
        if (back.charAt(i) == '"') {
            var j = i - 1
            while (j >= 0 && back.charAt(j) != '"') {
                j = j - 1
            }
            if (j >= 0) {
                var seg = back.substring(j + 1, i)
                if (seg.indexOf("sh") == 0 && seg.length() >= 10) {
                    return seg
                }
            }
        }
        i = i - 1
    }
    return ""
}

String planeHostPort() {
    var pl = dPlane()
    var cut = pl.indexOf("://")
    if (cut >= 0) {
        return pl.substring(cut + 3, pl.length())
    }
    return pl
}

String shellField(String text, String marker) {
    var lines = text.split("\n")
    var i = 0
    while (i < lines.size) {
        if (lines[i].indexOf(marker) >= 0) {
            var rest = lines[i].substring(lines[i].indexOf(marker) + marker.length(), lines[i].length())
            return rest.split(" ")[0].split("\n")[0]
        }
        i = i + 1
    }
    return ""
}

Bool safeWord(String v) {
    if (v.length() == 0 || v.length() > 512) {
        return false
    }
    if (v.indexOf("..") >= 0) {
        return false
    }
    var pool = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/:"
    var i = 0
    while (i < v.length()) {
        if (pool.indexOf("" + v.charAt(i)) < 0) {
            return false
        }
        i = i + 1
    }
    return true
}

// detached worker: the SAME cli.kf product lane, bearer by file reference.
void launchJob(String jid, String kind, List<String> verbArgs, String okMarker) {
    jobState(jid, "RUNNING", "")
    recordEvent(kind + "_QUEUED", "{\"job\":\"" + jid + "\"}")
    var pidfile = "kofshare-desktop-job-" + jid + ".pid"
    var logfile = "kofshare-desktop-job-" + jid + ".log"
    var sp = spawnDetachedEntry(logfile, verbArgs, pidfile, "src/main/kof/kofshare/cli/cli.kf")
    if (sp < 0) {
        jobState(jid, "FAILED", "DESKTOP-WORKER-UNSPAWNABLE")
        recordEvent(kind + "_FAILED", "{\"job\":\"" + jid + "\",\"code\":\"DESKTOP-WORKER-UNSPAWNABLE\"}")
        return
    }
    spawn {
        var finalState = ""
        var finalDetails = ""
        var t = 0
        while (t < 600 && finalState.length() == 0) {
            t = t + 1
            var log = readOr(logfile)
            if (log.indexOf(okMarker) >= 0) {
                finalState = "DONE"
                finalDetails = shellField(log, okMarker)
                break
            }
            var code = refusalIn(log)
            if (code.length() > 0) {
                finalState = "FAILED"
                finalDetails = code
                break
            }
            if (!File("/proc/" + sp).exists()) {
                finalState = "FAILED"
                finalDetails = "DESKTOP-WORKER-DIED"
                break
            }
            time.sleep(500)
        }
        if (finalState.length() == 0) {
            stopHelper(pidfile)
            finalState = "FAILED"
            finalDetails = "DESKTOP-JOB-TIMEOUT"
        }
        jobState(jid, finalState, finalDetails)
        recordEvent(kind + "_" + finalState, "{\"job\":\"" + jid + "\",\"details\":\"" + finalDetails + "\"}")
    }
}

// the first named refusal inside a worker log (codes, never stack noise).
String refusalIn(String log) {
    var marks = new List<String>()
    marks.add("REG0")
    marks.add("GRANT0")
    marks.add("AUTH0")
    marks.add("DEV0")
    marks.add("SES")
    marks.add("DOWN-ERR")
    marks.add("RECEIVE-ERR")
    marks.add("CONNECTIVITY_FAILED")
    var i = 0
    while (i < marks.size) {
        var m = marks.get(i)
        var idx = log.indexOf(m)
        if (idx >= 0) {
            var rest = log.substring(idx, log.length())
            var nl = rest.indexOf("\n")
            if (nl > 0) {
                rest = rest.substring(0, nl)
            }
            var q = rest.indexOf("\"")
            if (q > 0) {
                rest = rest.substring(0, q)
            }
            return rest
        }
        i = i + 1
    }
    return ""
}

String jobsJsonFor(String kind) {
    var rows = jobsRead()
    var out = "["
    var first = true
    var i = 0
    while (i < rows.size) {
        var r = rows.get(i)
        if (kind.length() == 0 || r.kind == kind) {
            if (!first) {
                out = out + ","
            }
            out = out + "{\"id\":\"" + r.id + "\",\"kind\":\"" + r.kind
                + "\",\"state\":\"" + r.state + "\",\"details\":\"" + r.details
                + "\",\"created\":" + r.created + "}"
            first = false
        }
        i = i + 1
    }
    return out + "]"
}

String desktopPage() {
    var lines = new List<String>()
    lines.add("<!doctype html>")
    lines.add("<html lang=\"en\"><head><meta charset=\"utf-8\">")
    lines.add("<title>kofshare desktop</title>")
    lines.add("<style>body{font-family:system-ui,sans-serif;max-width:40rem;margin:2rem auto;" +
        "padding:0 1rem}code{background:#eee;padding:0 .3rem}" +
        ".ok{color:#070}.bad{color:#b00}</style></head>")
    lines.add("<body>")
    lines.add("<h1>kofshare desktop</h1>")
    lines.add("<p>Phase-1 shell: daemon lifecycle + live state. " +
        "Share/receive screens arrive in F4–F5 — nothing here is faked.</p>")
    lines.add("<div>daemon: <span id=\"phase\" class=\"ok\">…</span></div>")
    lines.add("<div>plane: <span id=\"plane\">…</span></div>")
    lines.add("<div id=\"err\" class=\"bad\"></div>")
    lines.add("<p>Last line of real state below is live data from the local " +
        "daemon over loopback, never stored centrally.</p>")
    lines.add("<pre id=\"raw\"></pre>")
    lines.add("<script>(function(){")
    lines.add("var tok=new URLSearchParams(location.search).get('tok')||'';")
    lines.add("function tick(){")
    lines.add("  fetch('/api/v1/state',{headers:{'X-Kof-Token':tok}})")
    lines.add("  .then(function(r){return r.text()}).then(function(t){")
    lines.add("    var ph='READY'; var pl='?';")
    lines.add("    try{var j=JSON.parse(t); ph=j.phase||'?'; pl=j.plane||'?';}catch(e){}")
    lines.add("    document.getElementById('phase').textContent=ph;")
    lines.add("    var pe=document.getElementById('plane'); pe.textContent=pl;")
    lines.add("    pe.className=(pl=='ok')?'ok':'bad';")
    lines.add("    document.getElementById('raw').textContent=t;")
    lines.add("    document.getElementById('err').textContent=")
    lines.add("      (t.indexOf('DESKTOP-LOCAL-AUTH')>=0)?'local token mismatch':'';")
    lines.add("  });")
    lines.add("}")
    lines.add("tick(); setInterval(tick,2000);")
    lines.add("})();</script></body></html>")
    var html = ""
    for (var l in lines) {
        html = html + l + "\n"
    }
    return html
}

// The page URL carries the token in the QUERY (/page?tok=) — the same shape
// the browser lane proved (client.kf query("token")); page JS then sends it
// as the X-Kof-Token header for the API. URL history is device-local;
// nothing about this reaches the plane.

record LoginReqD(String bearer)

record ShareReqD(String path, String to, String ttl, Bool once, Bool readOnly)

record TransferReqD(String link, String dest)

Int daemonServe() {
    if (File(dTokenFile()).exists() == false) {
        writeDesktopToken()
    }
    var app = web.app()
    app.get("/api/v1/health") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        return "HEALTH-OK"
    }
    app.get("/api/v1/state") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        return stateJson()
    }
    app.get("/api/v1/events") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        return eventsJsonSince(sinceVal(query("since")))
    }

    // ── PRIVILEGED MUTATING SURFACE (§DP Option A; every line rides boundaryOk) ──

    app.post("/api/v1/login") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var req = json.decode<LoginReqD>(body())
        if (!safeWord(req.bearer)) {
            return "DESKTOP-LOGIN-REFUSED: malformed bearer"
        }
        var who = http.get(dPlane() + "/whoami", "Authorization: Bearer " + req.bearer)
        if (who.indexOf("WHOAMI ") != 0) {
            return "DESKTOP-LOGIN-REFUSED: " + who
        }
        var sub = who.substring(7, who.length())
        File(dCredFile()).writeText(req.bearer)
        shell.run("chmod", listOf("600", dCredFile()))
        recordEvent("IDENTITY_LOGIN", "{\"sub\":\"" + sub + "\"}")
        return "{\"sub\":\"" + sub + "\"}"
    }

    app.post("/api/v1/logout") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        if (File(dCredFile()).exists()) {
            File(dCredFile()).delete()
        }
        recordEvent("IDENTITY_LOGOUT", "{}")
        return "DESKTOP-LOGOUT-OK"
    }

    app.get("/api/v1/accounts") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var cred = readOr(dCredFile())
        if (cred.length() == 0) {
            return "DESKTOP-NO-CREDENTIAL"
        }
        var who = http.get(dPlane() + "/whoami", "Authorization: Bearer " + cred)
        if (who.indexOf("WHOAMI ") != 0) {
            return who
        }
        return "{\"sub\":\"" + who.substring(7, who.length()) + "\"}"
    }

    app.get("/api/v1/device") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var cred = readOr(dCredFile())
        if (cred.length() == 0) {
            return "DESKTOP-NO-CREDENTIAL"
        }
        var sk = identityBoot("kofshare-device.ed25519")
        var pub = identityPub(sk)
        var did = identityDeviceId(pub)
        var enroll = http.get(dPlane() + "/device-keys/" + did,
            "Authorization: Bearer " + cred)
        var enrolled = enroll.indexOf("PUB: ") == 0
        return "{\"deviceId\":\"" + did + "\",\"pubkey\":\"" + pub
            + "\",\"enrolled\":" + enrolled + "}"
    }

    app.post("/api/v1/shares") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var cred = readOr(dCredFile())
        if (cred.length() == 0) {
            return "DESKTOP-NO-CREDENTIAL"
        }
        var req = json.decode<ShareReqD>(body())
        if (!safeWord(req.path) || !File(req.path).exists()) {
            return "PATH-NOT-FOUND"
        }
        if (req.to.length() > 0 && !safeWord(req.to)) {
            return "DESKTOP-BAD-REQUEST: malformed recipient"
        }
        if (req.ttl.length() > 0 && !safeWord(req.ttl)) {
            return "DESKTOP-BAD-REQUEST: malformed ttl"
        }
        var jid = newJobId()
        var rows = jobsRead()
        rows.add(new JobRow(jid, "share", "QUEUED", "", time.now()))
        jobsWrite(rows)
        var args = new List<String>()
        args.add("share")
        args.add(req.path)
        args.add("--server")
        args.add(planeHostPort())
        args.add("--raw")
        args.add("--bearer")
        args.add("file:" + dCredFile())
        if (req.to.length() > 0) {
            args.add("--to")
            args.add(req.to)
        }
        if (req.once) {
            args.add("--once")
        }
        if (req.readOnly) {
            args.add("--read-only")
        }
        if (req.ttl.length() > 0) {
            args.add("--ttl")
            args.add(req.ttl)
        }
        launchJob(jid, "SHARE", args, "SHARE-LINK ")
        return "{\"job\":\"" + jid + "\",\"state\":\"QUEUED\"}"
    }

    app.get("/api/v1/shares") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        return jobsJsonFor("share")
    }

    app.post("/api/v1/shares/:id/revoke") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var cred = readOr(dCredFile())
        if (cred.length() == 0) {
            return "DESKTOP-NO-CREDENTIAL"
        }
        var rows = jobsRead()
        var idx = -1
        var i = 0
        while (i < rows.size) {
            var r = rows.get(i)
            if (r.id == param("id") && r.kind == "share") {
                idx = i
            }
            i = i + 1
        }
        if (idx < 0) {
            return "TRANSFER-NOT-FOUND: " + param("id")
        }
        var hit = rows.get(idx)
        var det = hit.details
        var lcut = det.indexOf("/s/")
        if (det.length() == 0 || lcut < 0) {
            return "DESKTOP-REVOKE-PENDING: share not minted yet (" + hit.state + ")"
        }
        // details carries the full minted LINK; the plane's own table (read
        // with the owner credential) resolves token -> share id. The OWNER
        // LAW is imposed by the PLANE (AUTH005 for non-owners), never here.
        var token = det.substring(lcut + 3, det.length()).split(" ")[0]
        var table = http.get(dPlane() + "/shares", "Authorization: Bearer " + cred)
        var rid = sidForToken(table, token)
        if (rid.length() == 0) {
            return "DESKTOP-REVOKE-ERR: token not in plane table"
        }
        var resp = http.post(dPlane() + "/shares/" + rid + "/revoke?reason=desktop", "",
            "Authorization: Bearer " + cred)
        if (resp.indexOf("SHARE-REVOKED") != 0 && resp.indexOf("GRANT-REVOKED") != 0) {
            return resp
        }
        jobState(hit.id, "REVOKED", hit.details)
        recordEvent("SHARE_REVOKED", "{\"job\":\"" + hit.id + "\"}")
        return "{\"status\":\"REVOKED\",\"id\":\"" + rid + "\"}"
    }

    app.post("/api/v1/transfers") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var cred = readOr(dCredFile())
        if (cred.length() == 0) {
            return "DESKTOP-NO-CREDENTIAL"
        }
        var req = json.decode<TransferReqD>(body())
        if (!safeWord(req.link) || req.link.indexOf("/s/") < 0) {
            return "DESKTOP-BAD-REQUEST: not a kofshare link"
        }
        if (!safeWord(req.dest) || req.dest.indexOf("/") == 0 || req.dest.indexOf("..") >= 0) {
            return "DEST-INVALID"
        }
        var jid = newJobId()
        var rows = jobsRead()
        rows.add(new JobRow(jid, "transfer", "QUEUED", req.dest, time.now()))
        jobsWrite(rows)
        var args = new List<String>()
        args.add("receive")
        args.add(req.link)
        args.add(req.dest)
        args.add("--bearer")
        args.add("file:" + dCredFile())
        launchJob(jid, "TRANSFER", args, "DOWN-AUTO-OK")
        return "{\"job\":\"" + jid + "\",\"state\":\"QUEUED\",\"dest\":\"" + req.dest + "\"}"
    }

    app.get("/api/v1/transfers") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        return jobsJsonFor("transfer")
    }

    app.get("/api/v1/transfers/:id") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var rows = jobsRead()
        var i = 0
        while (i < rows.size) {
            var r = rows.get(i)
            if (r.id == param("id") && r.kind == "transfer") {
                var done = 0
                if (File(r.details).exists()) {
                    done = File(r.details).size() as Int
                }
                return "{\"id\":\"" + r.id + "\",\"state\":\"" + r.state
                    + "\",\"dest\":\"" + r.details + "\",\"bytesDone\":" + done + "}"
            }
            i = i + 1
        }
        return "TRANSFER-NOT-FOUND: " + param("id")
    }

    app.post("/api/v1/transfers/:id/cancel") {
        var g = boundaryOk()
        if (g.length() > 0) {
            return g
        }
        var rows = jobsRead()
        var idx = -1
        var i = 0
        while (i < rows.size) {
            var r = rows.get(i)
            if (r.id == param("id") && r.kind == "transfer") {
                idx = i
            }
            i = i + 1
        }
        if (idx < 0) {
            return "TRANSFER-NOT-FOUND: " + param("id")
        }
        var hit = rows.get(idx)
        if (hit.state != "QUEUED" && hit.state != "RUNNING") {
            return "TRANSFER-NOT-CANCELLABLE: " + hit.state
        }
        stopHelper("kofshare-desktop-job-" + hit.id + ".pid")
        jobState(hit.id, "CANCELLED", hit.details)
        recordEvent("TRANSFER_CANCELLED", "{\"job\":\"" + hit.id + "\"}")
        return "{\"status\":\"CANCELLED\",\"id\":\"" + hit.id + "\"}"
    }

    app.get("/page") {
        if (query("tok") != desktopToken() || desktopToken().length() == 0) {
            return authRefusal()
        }
        return desktopPage()
    }
    recordEvent("DAEMON_STATE", "{\"phase\":\"READY\"}")
    startPresenceEventLoop()
    app.listen(dPort())
    return 0
}

Int desktopStart() {
    if (healthNow("http://127.0.0.1:" + dPort())) {
        println("DESKTOP-START already=true port=" + dPort())
        return 0
    }
    if (!File(dConf()).exists()) {
        File(dConf()).writeText("plane=http://127.0.0.1:9090\n")
        println("DESKTOP-CONF-WRITTEN default-plane")
    }
    if (!File(dTokenFile()).exists()) {
        writeDesktopToken()
    }
    var r = spawnDetachedEntry(dLog(), listOf("daemon"), dPidFile(),
        "src/main/kof/kofshare/desktop/desktopd.kf")
    if (r < 0) {
        println("DESKTOP-START-ERR: no jar in kofshare-cli.config (run kofshare install path first)")
        return 1
    }
    if (waitHealth("http://127.0.0.1:" + dPort())) {
        println("DESKTOP-START ok=true port=" + dPort())
        return 0
    }
    println("DESKTOP-START-ERR: daemon did not become healthable on " + dPort())
    return 1
}

// The wrapper pid (nohup/sh) and the REAL listener JVM are different pids
// under `run` mode (measured this session: pidfile=$! = wrapper; listener =
// its re-launch child whose cmdline NO LONGER contains the .kf entry — a
// cmdline-scoped kill is therefore impossible in run mode). The desktop's
// stop law is the SAME port-ownership sweep the CLI applies to helper ports
// it owns (core.freePort: bind-poll + ss-pid diagnosis + kill): this device
// owns dPort() by the kofshare-desktop.conf convention. Documented shape,
// not a new invention.
Int desktopStop() {
    stopHelper(dPidFile())
    freePort(dPort())
    File(dEventsFile()).delete()
    if (healthNow("http://127.0.0.1:" + dPort())) {
        println("DESKTOP-STOP-ERR: still answering on " + dPort())
        return 1
    }
    println("DESKTOP-STOP ok=true")
    return 0
}

Int desktopStatus() {
    if (healthNow("http://127.0.0.1:" + dPort())) {
        println("DESKTOP-STATUS up=true port=" + dPort())
        return 0
    }
    println("DESKTOP-STATUS up=false port=" + dPort())
    return 0
}

Int desktopWindow() {
    if (!healthNow("http://127.0.0.1:" + dPort())) {
        var s = desktopStart()
        if (s != 0) {
            println("DESKTOP-WINDOW-ERR: daemon start failed")
            return s
        }
    }
    var url = "http://127.0.0.1:" + dPort() + "/page?tok=" + desktopToken()
    process.spawn("xdg-open", url)
    println("DESKTOP-WINDOW url=http://127.0.0.1:" + dPort() + "/page?tok=<token>")
    return 0
}

main(args: List<String>) {
    if (args.size == 0) {
        println("usage: kofshare-desktop --start|--stop|--status|--window|daemon")
        return
    }
    var v = args.get(0)
    if (v == "daemon") {
        daemonServe()
        return
    }
    if (v == "--start") {
        desktopStart()
        return
    }
    if (v == "--stop") {
        desktopStop()
        return
    }
    if (v == "--status") {
        desktopStatus()
        return
    }
    if (v == "--window") {
        desktopWindow()
        return
    }
    println("DESKTOP-ERR: unknown verb '" + v + "'")
}
