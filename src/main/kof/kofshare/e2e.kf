package kofshare

import kofshare.transfer
import kofshare.session
import kofshare.domain
import kof.keyExchange
import kof.secrets
import kof.security

// E2E oracle for the transfer core: 200000 deterministic bytes, real TCP
// over loopback (D-KOF-NET), RESUME simulates a partial download — only
// the tail must cross the wire. Green means: len + byte-sum + per-byte
// compare agree AND the session finished in Done.

Int portOf() {
    return 19321
}

Int resumeOffsetOf() {
    return 100000
}

Int securePortOf() {
    return 19322
}

Int[] prefix(Int[] src, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = src[i]
        i = i + 1
    }
    return out
}

Int[] makeSource() {
    var n = 200000
    var a = new Int[n]
    var i = 0
    while (i < n) {
        a[i] = (i * 7 + 3) % 256
        i = i + 1
    }
    return a
}

main() {
    var src = "tsrc.bin"
    var dst = "tdst.part"
    var data = makeSource()
    File(src).writeBytes(data)
    File(dst).writeBytes(prefix(data, resumeOffsetOf()))
    var l = net.listen(portOf())
    var worker = spawn {
        var s = l.accept()
        serveFile(s, src, resumeOffsetOf(), "k0")
        s.close()
    }
    var c = net.connect("127.0.0.1", portOf())
    var t = fetchFile(c, dst, resumeOffsetOf(), "share-e2e", "devA", "k0")
    c.close()
    await worker
    l.close()

    // ── SECURE leg — D-KOF-X25519 session envelope over the same core ──
    var d2 = "tdst.sec.part"
    var resume2 = 123456
    File(d2).writeBytes(prefix(data, resume2))
    var l2 = net.listen(securePortOf())
    var worker2 = spawn {
        var sv = l2.accept()
        var privS = keyExchange.privateKey()
        serveFileSecure(sv, src, resume2, privS, security.randomHex(16))
        sv.close()
    }
    var c2 = net.connect("127.0.0.1", securePortOf())
    var privC = keyExchange.privateKey()
    var hs = fetchHandshake(c2, privC)
    var t2 = fetchFileSecure(c2, d2, resume2, "share-sec", "devB", hs.get(4), hs.get(5))
    c2.close()
    var out2 = File(d2).readBytes()
    var ok2 = true
    var q2 = 0
    while (q2 < data.size) {
        if (out2[q2] != data[q2]) {
            ok2 = false
            q2 = data.size
        }
        q2 = q2 + 1
    }
    println("sec=" + (hs.get(2) != hs.get(4)) + "/" + (hs.get(3) != hs.get(5)))
    println("secLen=" + out2.size + "/" + data.size + " secDone=" + (t2.state == SessionState.Done))
    if (ok2 & out2.size == data.size & t2.state == SessionState.Done) {
        println("SEC-E2E-OK")
    }
    await worker2
    l2.close()
    File(d2).delete()
    var a = File(src).readBytes()
    var b = File(dst).readBytes()
    println("len=" + a.size + "/" + b.size)
    println("sum=" + byteSum(a) + "/" + byteSum(b))
    println("mismatch=" + firstMismatch(a, b))
    println("done=" + (t.state == SessionState.Done))
    println("offset=" + t.offset + "/" + t.totalBytes)
    File(src).delete()
    File(dst).delete()
    println("E2E-OK")
}
