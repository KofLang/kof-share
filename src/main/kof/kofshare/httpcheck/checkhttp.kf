package kofshare.httpcheck

import kofshare.control.registry
import kofshare.control.share
import kofshare.control.auth
import kof.http
import kof.json
import kof.crypto
import kof.time

// Slice 2 runner (implementation-plan §2): the control-plane HTTP surface over
// the pure registry, REAL sockets on loopback. Target JVM (web listen blocks;
// the server rides spawn). The Script leg was MEASURED 02/10: `web` handlers
// answer HTTP 500 under the interpreter (§574 OPEN) — this golden therefore
// runs on JVM only; the pure registry (check.kf) keeps covering JVM+Script.
main() {
    var ok = true
    var base = "http://127.0.0.1:18322"
    var kf = File("server-control.bearer")
    var keyTxt = kf.readText()
    var key = ""
    if (keyTxt != null) {
        key = keyTxt
    }
    var auth = "Authorization: Bearer " + key

    var up = ""
    var i = 0
    while (i < 100) {
        try {
            up = http.get(base + "/devices")
            i = 100
        } catch (String e) {
            i = i + 1
        }
    }
    var vserverUp = up == "[]"
    ok = ok && vserverUp
    println("serverUp=" + vserverUp)
    var vhealth = http.get(base + "/health") == "OK"
    ok = ok && vhealth
    println("health=" + vhealth)

    var regBody = json.encode(DeviceInfo("d1", "alpha", "192.168.1.10:8021"))
    var regRes = http.post(base + "/devices", regBody, auth)
    var vregister = regRes == "REGISTERED: d1"
    ok = ok && vregister
    println("register=" + vregister)

    var badReg = http.post(base + "/devices", json.encode(DeviceInfo("", "x", "a:1")), auth)
    var vregisterRefused = badReg == "REG001: empty device id"
    ok = ok && vregisterRefused
    println("registerRefused=" + vregisterRefused)

    var one = http.get(base + "/devices/d1")
    var vresolveOne = one.indexOf("\"alpha\"") >= 0 && one.indexOf("\"d1\"") >= 0
    ok = ok && vresolveOne
    println("resolveOne=" + vresolveOne)
    var ghost = http.get(base + "/devices/zz")
    var vresolveGhost = ghost == "DEVICE-NOT-FOUND: zz"
    ok = ok && vresolveGhost
    println("resolveGhost=" + vresolveGhost)

    http.post(base + "/devices", json.encode(DeviceInfo("d2", "beta", "192.168.1.11:8021")), auth)
    var dlist = http.get(base + "/devices")
    var vdevicesBoth = countObjects(dlist) == 2
    ok = ok && vdevicesBoth
    println("devicesBoth=" + vdevicesBoth)

    var dig = cryptoDigest("/srv/a.bin")
    var off = http.post(base + "/offers", json.encode(OfferRequest("o1", "d1", "/srv/a.bin", 2048, dig, "", "", "", 0, "", "")), auth)
    var voffer = off == "OFFERED: o1"
    ok = ok && voffer
    println("offer=" + voffer)
    var offBad = http.post(base + "/offers", json.encode(OfferRequest("oX", "ghost", "/p", 5, dig, "", "", "", 0, "", "")), auth)
    var vofferUnknownDevice = offBad == "REG004: unknown device ghost"
    ok = ok && vofferUnknownDevice
    println("offerUnknownDevice=" + vofferUnknownDevice)

    var allOffers = http.get(base + "/offers")
    var voffersAll = countObjects(allOffers) == 1
    ok = ok && voffersAll
    println("offersAll=" + voffersAll)
    var q = http.get(base + "/offers?device=d2")
    var voffersQueryEmpty = q == "[]"
    ok = ok && voffersQueryEmpty
    println("offersQueryEmpty=" + voffersQueryEmpty)

    var sh = http.post(base + "/shares", json.encode(ShareRequest("o1", 0, 1, false, false)), auth)
    var vshareMint = sh.indexOf("SHARED ") == 0
    ok = ok && vshareMint
    println("shareMint=" + vshareMint)
    var bits = sh.split(" ")
    var sid = bits[1]
    var stok = bits[2]
    var grant = http.get(base + "/s/" + stok)
    var vgrantMeta = grant.indexOf("/srv/a.bin") >= 0 && grant.indexOf("192.168.1.10:8021") >= 0 && grant.indexOf("read-write") >= 0
    ok = ok && vgrantMeta
    println("grantMeta=" + vgrantMeta)
    var again = http.get(base + "/s/" + stok)
    var vgrantExhausted = again == "REG038: share exhausted"
    ok = ok && vgrantExhausted
    println("grantExhausted=" + vgrantExhausted)
    var ghostTok = http.get(base + "/s/" + pad64("ff"))
    var vgrantUnknown = ghostTok == "REG035: unknown share token"
    ok = ok && vgrantUnknown
    println("grantUnknown=" + vgrantUnknown)
    var rvs = http.post(base + "/shares/" + sid + "/revoke?reason=httpcheck", "", auth)
    var vshareRevoke = rvs == "SHARE-REVOKED: " + sid
    ok = ok && vshareRevoke
    println("shareRevoke=" + vshareRevoke)
    var afterRev = http.get(base + "/s/" + stok)
    var vgrantAfterRevoke = afterRev == "REG036: share revoked"
    ok = ok && vgrantAfterRevoke
    println("grantAfterRevoke=" + vgrantAfterRevoke)
    var lst = http.get(base + "/shares", auth)
    var vsharesListed = lst.indexOf(sid) >= 0
    ok = ok && vsharesListed
    println("sharesListed=" + vsharesListed)

    // restart-probe companion: a share with maxUses=0 (unlimited) stays
    // FETCHABLE after this run so the restart golden can assert a REAL
    // grant body across process death. Measured 05/10: every seeded share
    // was single-use or revoked, so the probe's "grantAfterRestart" had
    // never actually checked a served grant — only the absence of an
    // error prefix. Loose assertions rot silently.
    // the persistent share needs its OWN offer: o1 is deleted later by the
    // revoke-offer leg (offersGone), and a grant whose offer vanished is
    // REG034 — measured 05/10, the restart probe's first strict grant check
    // hit exactly that.
    var off2 = http.post(base + "/offers", json.encode(OfferRequest("o2", "d1", "/srv/a.bin", 2048, dig, "", "", "", 0, "", "")), auth)
    var voffer2 = off2 == "OFFERED: o2"
    ok = ok && voffer2
    println("offer2=" + voffer2)

    var sh2 = http.post(base + "/shares", json.encode(ShareRequest("o2", 0, 0, false, false)), auth)
    var vsharePersist = sh2.indexOf("SHARED ") == 0
    ok = ok && vsharePersist
    println("sharePersist=" + vsharePersist)
    var pbits = sh2.split(" ")
    var pgrant = http.get(base + "/s/" + pbits[2])
    var vpersistServed = pgrant.indexOf("/srv/a.bin") >= 0
    ok = ok && vpersistServed
    println("persistServed=" + vpersistServed)

    var noAuth = http.post(base + "/devices", regBody)
    var vgateMissing = noAuth == "AUTH001: missing bearer"
    ok = ok && vgateMissing
    println("gateMissing=" + vgateMissing)
    var wrong = http.post(base + "/devices", regBody, "Authorization: Bearer " + key + "deadbeef")
    var vgateWrong = wrong.indexOf("unauthorized") >= 0
    ok = ok && vgateWrong
    println("gateWrong=" + vgateWrong)
    // idempotent across runs: the tech account may exist (and be revoked) from
    // a previous golden — re-mint after revoking so the row always measures.
    http.post(base + "/accounts/tech/revoke", "", auth)
    var newAccount = http.post(base + "/accounts", json.encode(AccountRequest("tech", "tecla", 0)), auth)
    var vaccountMint = newAccount.indexOf("APIKEY ") == 0
    ok = ok && vaccountMint
    println("accountMint=" + vaccountMint)
    var techKey = ""
    if (newAccount.indexOf("APIKEY ") == 0) {
        techKey = newAccount.substring(7)
    }
    var techCall = http.get(base + "/shares", "Authorization: Bearer " + techKey)
    var vaccountUsable = techCall.indexOf("REG") != 0
    ok = ok && vaccountUsable
    println("accountUsable=" + vaccountUsable)
    var accts = http.get(base + "/accounts", auth)
    var vaccountsListed = accts.indexOf("tecla") >= 0 && accts.indexOf("status") >= 0 && accts.indexOf(techKey) < 0
    ok = ok && vaccountsListed
    println("accountsListed=" + vaccountsListed)
    var revAcct = http.post(base + "/accounts/tech/revoke", "", auth)
    var vaccountRevoked = revAcct == "ACCOUNT-REVOKED: tech"
    ok = ok && vaccountRevoked
    println("accountRevoked=" + vaccountRevoked)
    var deadCall = http.get(base + "/shares", "Authorization: Bearer " + techKey)
    var vrevokedKeyDies = deadCall == "AUTH003: revoked"
    ok = ok && vrevokedKeyDies
    println("revokedKeyDies=" + vrevokedKeyDies)
    // expired JWT (gigaprompt attack #8, expired sub-case): mint with
    // ttlSec=1, outlive it, then use — the runtime signature check must
    // refuse even though the account row is still active.
    var expMint = http.post(base + "/accounts", json.encode(AccountRequest("exp", "expired-probe", 1)), auth)
    var expKey = ""
    if (expMint.indexOf("APIKEY ") == 0) {
        expKey = expMint.substring(7)
    }
    var expFresh = expKey.length() > 20
        && http.get(base + "/shares", "Authorization: Bearer " + expKey).indexOf("REG") != 0
    time.sleep(2500)
    var expDead = http.get(base + "/shares", "Authorization: Bearer " + expKey)
    var vjwtExpiry = expFresh && expDead.indexOf("unauthorized") >= 0
    ok = ok && vjwtExpiry
    println("jwtExpiry=" + vjwtExpiry)
    http.post(base + "/accounts/exp/revoke", "", auth)

    var rev = http.delete(base + "/offers/o1", auth)
    var vrevoke = rev == "REVOKED: o1"
    ok = ok && vrevoke
    println("revoke=" + vrevoke)
    var revGhost = http.delete(base + "/offers/o1", auth)
    var vrevokeGhost = revGhost == "REG008: unknown offer o1"
    ok = ok && vrevokeGhost
    println("revokeGhost=" + vrevokeGhost)

    var after = http.get(base + "/offers")
    // o1-specific: the persistent-share leg keeps o2 alive on purpose, so
    // global "[]" was a state coupling, not a property of the delete.
    var voffersGone = after.indexOf("\"o1\"") < 0 && after.indexOf("\"o2\"") >= 0
    ok = ok && voffersGone
    println("offersGone=" + voffersGone)

    if (!ok) {
        println("HTTPCHECK-FAIL")
        throw "kofshare: HTTPCHECK-FAIL"
    }
    println("HTTPCHECK-OK")
}

String cryptoDigest(String path) {
    return crypto.sha256(path)
}

Int countObjects(String body) {
    var depth = 0
    var count = 0
    var i = 0
    while (i < body.length()) {
        var c = body.substring(i, i + 1)
        if (c == "{") {
            depth = depth + 1
            if (depth == 1) {
                count = count + 1
            }
        }
        if (c == "}") {
            depth = depth - 1
        }
        i = i + 1
    }
    return count
}

String pad64(String seed) {
    var t = seed
    while (t.length < 64) {
        t = t + "0"
    }
    return t.substring(0, 64)
}
