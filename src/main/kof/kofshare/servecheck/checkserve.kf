package kofshare.servecheck

import kofshare.transfer
import kofshare.session
import kofshare.domain
import kof.process
import kof.http
import kof.json
import kof.keyExchange
import kof.math
import kof.net
import kof.shell
import kof.time

// A5 golden — device-side `cli serve` between TWO REAL PROCESSES (JVM only;
// the relay/restart goldens cover their own fronts). Proof lines:
//   plainResume:  fetch --resume 1000 against a 3000-byte file served by a
//                 detached process — the A3 HELLO offset negotiation crossing
//                 the process boundary, tail-only bytes, result identical
//   secureResume: same through the X25519 sealed envelope (handshake first)
//   refuseOversize: offset beyond EOF refused BY NAME on the client, the
//                 server exits rc=2 (SERVE-REFUSED), the .part untouched
// The serve child is detached with `sh -c ... &` and synchronized through
// its SERVE-LISTENING line before any connect. TIMING MEASURED 04/10: the
// whole golden runs ~4-6 min on this host (each detached child re-JITs the
// CLI compilation — cold start dominates, NOT the transfer); the bounded
// waits below use 30 s ceilings (120 x 250 ms). If an interrupted run leaves
// orphan `cli serve` children holding 1934x, kill by port (ss -tlnp | pid)
// before re-running — a held port is refused BY NAME at the phase entry.

Int portOf() {
    return 19341
}

String jar() {
    // absolute: the detached child inherits an unknown cwd — pin the path
    return "/home/mel/tools/kof-pin/kof-cli-f2629e32d.jar"
}

String cliPath() {
    return "src/main/kof/kofshare/cli/cli.kf"
}

Int[] makeData(Int n) {
    var a = new Int[n]
    var i = 0
    while (i < n) {
        a[i] = (i * 11 + 7) % 256
        i = i + 1
    }
    return a
}

Int[] prefix(Int[] src, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = src[i]
        i = i + 1
    }
    return out
}

Bool identical(Int[] a, Int[] b) {
    if (a.size != b.size) {
        return false
    }
    var i = 0
    while (i < a.size) {
        if (a[i] != b[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// Detach `cli serve ...` writing its log to `log`; wait for SERVE-LISTENING.
// Returns true when the child announced SERVE-LISTENING; refuses BY NAME
// (caller aborts before any connect) when the child never came up — measured
// 04/10: an orphan serve from an interrupted run held the port and a blind
// connect rode a foreign socket and hanged the golden.
Bool spawnServe(String log, List<String> serveArgs) {
    // the child inherits whatever cwd the runner set — pin ours too
    var cmd = "cd /home/mel/Documents/kof-share && java -jar " + jar()
        + " run " + cliPath() + " serve"
    for (var a in serveArgs) {
        cmd = cmd + " " + a
    }
    cmd = cmd + " > " + log + " 2>&1 &"
    // Measured 05/10 (connection-refused crash + zombie in ss): a STALE log
    // from a previous run made this wait return TRUE instantly — the golden
    // dialed a port whose NEW serve had not bound yet (and the zombie that
    // eventually took it was the old serve from an interrupted run). Sync on
    // a file that might be stale is no sync: delete first, then wait the
    // CONDITION, and before spawning anything prove the port is bindable.
    if (File(log).exists()) {
        File(log).delete()
    }
    var sport = math.parseInt(serveArgs.get(1))
    var tclear = 0
    var cleared = false
    while (tclear < 80 && !cleared) {
        try {
            var pr = net.listen(sport)
            pr.close()
            cleared = true
        } catch (String e) {
            var res = shell.run("ss", listOf("-tlnp"))
            for (var line in res.stdout.split("\n")) {
                if (line.indexOf("LISTEN") < 0 || line.indexOf(":" + sport) < 0) {
                    continue
                }
                var pi = line.indexOf("pid=")
                if (pi < 0) {
                    continue
                }
                var num = ""
                var i2 = pi + 4
                while (i2 < line.length()) {
                    var ch = line.charAt(i2)
                    if (ch < 48 || ch > 57) {
                        break
                    }
                    num = num + line.substring(i2, i2 + 1)
                    i2 = i2 + 1
                }
                if (num.length() > 0) {
                    shell.run("kill", listOf("-9", num))
                }
            }
            time.sleep(250)
            tclear = tclear + 1
        }
    }
    if (!cleared) {
        return false
    }
    process.spawn("sh", "-c", cmd)
    var t0 = 0
    while (t0 < 120) {
        var f = File(log)
        if (f.exists()) {
            var txt = f.readText()
            if (txt != null && txt.indexOf("SERVE-LISTENING") >= 0) {
                return true
            }
        }
        time.sleep(250)
        t0 = t0 + 1
    }
    return false
}

main() {
    var ok = true
    var total = 3000
    var data = makeData(total)

    // ── plain + resume across processes ──
    var src = "serve-src.bin"
    File(src).writeBytes(data)
    var dst = "serve-plain.part"
    File(dst).writeBytes(prefix(data, 1000))
    var logA = "serve-plain.log"
    if (!spawnServe(logA, listOf(src, "" + portOf(), "--key", "k0"))) {
        println("SERVECHECK-FAIL: plain server did not come up (port held?)")
        throw "kofshare: SERVECHECK-FAIL"
    }
    var cA = net.connect("127.0.0.1", portOf())
    var tA = fetchFile(cA, dst, 1000, "share-serve", "devS", "k0")
    cA.close()
    var outA = File(dst).readBytes()
    var plainResume = identical(outA, data) && tA.offset == total
    println("plainResume=" + plainResume)
    ok = ok && plainResume

    // ── secure + resume across processes ──
    var dst2 = "serve-sec.part"
    File(dst2).writeBytes(prefix(data, 1200))
    var logB = "serve-sec.log"
    if (!spawnServe(logB, listOf(src, "" + (portOf() + 1), "--secure", "--salt", "0a0b0c0d0e0f1011"))) {
        println("SERVECHECK-FAIL: sealed server did not come up (port held?)")
        throw "kofshare: SERVECHECK-FAIL"
    }
    var cB = net.connect("127.0.0.1", portOf() + 1)
    var privC = keyExchange.privateKey()
    var hs = fetchHandshake(cB, privC)
    var tB = fetchFileSecure(cB, dst2, 1200, "share-serve", "devS", hs.get(4), hs.get(5))
    cB.close()
    var outB = File(dst2).readBytes()
    var secureResume = identical(outB, data) && tB.offset == total
    println("secureResume=" + secureResume)
    ok = ok && secureResume

    // ── oversize resume refused BY NAME across processes ──
    var dst3 = "serve-refuse.part"
    File(dst3).writeBytes(prefix(data, 1000))
    var logC = "serve-refuse.log"
    if (!spawnServe(logC, listOf(src, "" + (portOf() + 2), "--key", "k0"))) {
        println("SERVECHECK-FAIL: refuse server did not come up (port held?)")
        throw "kofshare: SERVECHECK-FAIL"
    }
    var refused = ""
    try {
        var cC = net.connect("127.0.0.1", portOf() + 2)
        fetchFile(cC, dst3, 60000, "share-serve", "devS", "k0")
        cC.close()
    } catch (String e) {
        refused = e
    }
    var refuseOversize = refused.indexOf("RESUME-ERR: server file shorter than requested offset") >= 0
    println("refuseOversize=" + refuseOversize)
    ok = ok && refuseOversize
    var partKept = identical(File(dst3).readBytes(), prefix(data, 1000))
    println("refusePartUntouched=" + partKept)
    ok = ok && partKept
    // the refused server saw the rejection too (rc-2 path), by name, in its log
    var t1 = 0
    var serverNamed = false
    while (t1 < 120 && !serverNamed) {
        var f = File(logC)
        if (f.exists()) {
            var txt = f.readText()
            if (txt != null && txt.indexOf("SERVE-REFUSED") >= 0) {
                serverNamed = true
            }
        }
        time.sleep(250)
        t1 = t1 + 1
    }
    println("serverRefusedNamed=" + serverNamed)
    ok = ok && serverNamed

    // served counts in the plain/secure logs close the loop
    var t2 = 0
    var servedPlain = false
    while (t2 < 120 && !servedPlain) {
        var f = File(logA)
        if (f.exists()) {
            var txt = f.readText()
            if (txt != null && txt.indexOf("SERVED 2000") >= 0) {
                servedPlain = true
            }
        }
        time.sleep(250)
        t2 = t2 + 1
    }
    println("servedPlainTail=2000=" + servedPlain)
    ok = ok && servedPlain
    var t3 = 0
    var servedSecure = false
    while (t3 < 120 && !servedSecure) {
        var f = File(logB)
        if (f.exists()) {
            var txt = f.readText()
            if (txt != null && txt.indexOf("SERVED 1800") >= 0) {
                servedSecure = true
            }
        }
        time.sleep(250)
        t3 = t3 + 1
    }
    println("servedSecureTail=1800=" + servedSecure)
    ok = ok && servedSecure

    File(src).delete()
    File(dst).delete()
    File(dst2).delete()
    File(dst3).delete()
    if (!ok) {
        println("SERVECHECK-FAIL")
        throw "kofshare: SERVECHECK-FAIL"
    }
    println("SERVECHECK-OK")
}
