package kofshare

import kofshare.domain

// KofShare transfer core — D-KOFSHARE-100KOF: 100% Kof over the kof.net
// front (D-KOF-NET). Frame = len(4 BE) | index(4 BE) | payload — the
// architecture.md §TRANSFER shape minus the AES-GCM envelope (that face
// rides the SECN005 key-exchange decision, a separate call). Binary-safe
// end to end: files move as Int[] (bytes 0..255, the io face), the wire
// uses Byte[] (the net face), and the wrap/unwrap lives HERE, never in
// the transport. Offset-idempotent: the sender starts at `resumeOffset`,
// the receiver appends; a restart asks only for what is missing.

Int metaIndex() {
    // 0x3FFFFFFF — maior sentinel 32-bit que cabe no Int assinado do Kof
    return 1073741823
}

Int chunkSize() {
    return 65536
}

Byte[] headFrame(Int totalLen, Int index) {
    var h = new Byte[8]
    h[0] = (totalLen / 16777216) % 256
    h[1] = (totalLen / 65536) % 256
    h[2] = (totalLen / 256) % 256
    h[3] = totalLen % 256
    h[4] = (index / 16777216) % 256
    h[5] = (index / 65536) % 256
    h[6] = (index / 256) % 256
    h[7] = index % 256
    return h
}

Int be32(Byte[] b, Int off) {
    return ((b[off] + 256) % 256) * 16777216
        + ((b[off + 1] + 256) % 256) * 65536
        + ((b[off + 2] + 256) % 256) * 256
        + ((b[off + 3] + 256) % 256)
}

Byte[] concatBytes(Byte[] a, Byte[] b) {
    var out = new Byte[a.length + b.length]
    var i = 0
    while (i < a.length) {
        out[i] = a[i]
        i = i + 1
    }
    var j = 0
    while (j < b.length) {
        out[a.length + j] = b[j]
        j = j + 1
    }
    return out
}

Byte[] recvRaw(Conn c, Int n) {
    var acc = new Byte[0]
    while (acc.length < n) {
        var chunk = c.receive(n - acc.length)
        if (chunk.length == 0) {
            throw "kofshare: channel closed mid-frame"
        }
        acc = concatBytes(acc, chunk)
    }
    return acc
}

Int[] bytesToInts(Byte[] src) {
    var out = new Int[src.length]
    var i = 0
    while (i < src.length) {
        var v = src[i]
        if (v < 0) {
            v = v + 256
        }
        out[i] = v
        i = i + 1
    }
    return out
}

// Server side: stream `path` over an accepted conn, starting at
// resumeOffset. META frame carries the total size; payload frames carry
// (index, bytes). In-order by construction — resume is an OFFSET, not a
// chunk table (offset-idempotent rule of the architecture).
Int serveFile(Conn c, String path, Int resumeOffset) {
    var data = File(path).readBytes()
    var total = data.size
    c.send(headFrame(total, metaIndex()))
    var sent = 0
    var index = 0
    var pos = resumeOffset
    while (pos < total) {
        var len = total - pos
        if (len > chunkSize()) {
            len = chunkSize()
        }
        var frame = new Byte[len]
        var i = 0
        while (i < len) {
            frame[i] = data[pos + i]
            i = i + 1
        }
        c.send(headFrame(len, index))
        c.send(frame)
        pos = pos + len
        sent = sent + len
        index = index + 1
    }
    return sent
}

// Client side: pull into `dst` assuming `resumeOffset` bytes are already
// present (append semantics — the .part file of the architecture).
Transfer fetchFile(Conn c, String dst, Int resumeOffset, String shareId, String peerId) {
    var meta = recvRaw(c, 8)
    if (be32(meta, 4) != metaIndex()) {
        throw "kofshare: first frame must be META"
    }
    var total = be32(meta, 0)
    var got = resumeOffset
    var index = 0
    while (got < total) {
        var head = recvRaw(c, 8)
        var len = be32(head, 0)
        var idx = be32(head, 4)
        if (idx != index) {
            throw "kofshare: chunk out of order"
        }
        var payload = bytesToInts(recvRaw(c, len))
        File(dst).appendBytes(payload)
        got = got + len
        index = index + 1
    }
    return Transfer("t" + shareId, shareId, peerId, SessionState.Done, got, total, "")
}

Int byteSum(Int[] bs) {
    var s = 0
    var i = 0
    while (i < bs.size) {
        s = s + bs[i]
        i = i + 1
    }
    return s
}

Int firstMismatch(Int[] a, Int[] b) {
    if (a.size != b.size) {
        return 0 - 1
    }
    var i = 0
    while (i < a.size) {
        if (a[i] != b[i]) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}
