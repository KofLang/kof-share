package kofshare

import kofshare.domain
import kofshare.protocol
import kofshare.session
import kof.security

// KofShare plain transfer — D-KOFSHARE-100KOF: 100% Kof over the kof.net
// front (D-KOF-NET). The framing + codec live in protocol.kf; this file is
// only the plain (unsealed) state machine: the META frame carries the total
// size, every payload frame is followed by its HMAC tag, and resume is an
// OFFSET, not a chunk table (the architecture's offset-idempotent rule).
// The AES-GCM envelope lives in session.kf (SECN005 key exchange).
// Offset-idempotent: the sender starts at `resumeOffset`, the receiver
// appends; a restart asks only for what is missing. A tampered chunk (or a
// chunk delivered out of order) refuses before the bytes reach the file.

// Server side: stream `path` over an accepted conn starting at
// resumeOffset. META frame carries the total size; every payload frame is
// followed by its HMAC tag. In-order by construction.
Int serveFile(Conn c, String path, Int resumeOffset, String key) {
    var data = File(path).readBytes()
    var total = data.size
    var first = recvRaw(c, 8)
    var off = resumeOffset
    if (first.length == 8 && be32(first, 4) == helloIndex()) {
        off = be32(first, 0)
        var v = resumeVerify(off, total)
        if (v != "OK") {
            c.send(headFrame(total, resumeErrIndex()))
            return 0 - 3
        }
    } else {
        var vf = resumeVerify(off, total)
        if (vf != "OK") {
            c.send(headFrame(total, resumeErrIndex()))
            return 0 - 3
        }
    }
    return sendChunks(c, data, off, key)
}

// META + tagged chunks from `off` — shared by the plain serveFile and the
// directory face (Track G), whose HELLO selector is consumed BEFORE the
// stream starts (the face picks the file by ordinal, then streams).
Int sendChunks(Conn c, Int[] data, Int off, String key) {
    var total = data.size
    c.send(headFrame(total, metaIndex()))
    var sent = 0
    var index = 0
    var pos = off
    while (pos < total) {
        var len = total - pos
        if (len > chunkSize()) {
            len = chunkSize()
        }
        var frame = new Byte[len]
        var i = 0
        while (i < len) {
            frame[i] = data[pos + i]
            i = i + 1
        }
        c.send(headFrame(len, index))
        c.send(frame)
        c.send(tagBytes(key, index, frame))
        pos = pos + len
        sent = sent + len
        index = index + 1
    }
    return sent
}

// Client side: pull into `dst` assuming `resumeOffset` bytes are already
// present (append semantics — the .part of the architecture). The tag is
// verified against the digest recomputed from the chunk BEFORE anything
// reaches the file; mismatch refuses by name.
Transfer fetchFile(Conn c, String dst, Int resumeOffset, String shareId, String peerId, String key) {
    c.send(headFrame(resumeOffset, helloIndex()))
    return fetchRest(c, dst, resumeOffset, shareId, peerId, key)
}

// Directory child pull (Track G): HELLO's type field carries the selector
// dirHelloBase()+child — additive wire; plain files keep helloIndex.
Transfer fetchFileDir(Conn c, String dst, Int resumeOffset, Int child, String shareId, String peerId, String key) {
    c.send(headFrame(resumeOffset, dirHelloBase() + child))
    return fetchRest(c, dst, resumeOffset, shareId, peerId, key)
}

Transfer fetchRest(Conn c, String dst, Int resumeOffset, String shareId, String peerId, String key) {
    var meta = recvRaw(c, 8)
    if (be32(meta, 4) == resumeErrIndex()) {
        throw "kofshare: RESUME-ERR: server file shorter than requested offset"
    }
    if (be32(meta, 4) != metaIndex()) {
        throw "kofshare: first frame must be META"
    }
    var total = be32(meta, 0)
    if (resumeOffset > total) {
        throw "kofshare: RESUME-ERR: local part larger than remote file"
    }
    var got = resumeOffset
    var index = 0
    while (got < total) {
        var head = recvRaw(c, 8)
        var len = be32(head, 0)
        var idx = be32(head, 4)
        if (idx != index) {
            throw "kofshare: chunk out of order"
        }
        var payload = recvRaw(c, len)
        var tag = recvRaw(c, tagLen())
        if (asciiOf(tag) != tagHex(key, idx, payload)) {
            throw "kofshare: chunk tag mismatch"
        }
        File(dst).appendBytes(bytesToInts(payload))
        got = got + len
        index = index + 1
    }
    return Transfer("t" + shareId, shareId, peerId, SessionState.Done, got, total, "")
}

// Byte-oracle helpers shared by the e2e/CLI checks (byte-sum and first
// differing index); kept beside the plain transfer they validate.
Int byteSum(Int[] bs) {
    var s = 0
    var i = 0
    while (i < bs.size) {
        s = s + bs[i]
        i = i + 1
    }
    return s
}

Int firstMismatch(Int[] a, Int[] b) {
    if (a.size != b.size) {
        return 0 - 1
    }
    var i = 0
    while (i < a.size) {
        if (a[i] != b[i]) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Selector space: 1073700000..1073700999 — strictly below resumeErrIndex,
// strictly above any chunk index; the directory child HELLO rides it.
Int dirHelloBase() {
    return 1073700000
}
