package kofshare

import kof.http
import kof.json
import kof.crypto
import kof.keyExchange
import kof.secrets
import kof.net
import kofshare.domain
import kofshare.resource
import kofshare.connect
import kofshare.transfer
import kofshare.control.registry
import kofshare.control.share
import kofshare.control.session

// A6 user flow — the last mile between the pieces and the person.
// `upPublish` registers device + offer in the CONTROL PLANE over real HTTP
// (the plane stamps offer freshness itself — A4 wire); `downFetch` takes the
// SHARE TOKEN, resolves the grant through the public GET /s/<token> (the
// token IS the possession authorization — C3), learns WHERE the file lives
// (deviceAddress shipped inside the grant since C2), resumes from a local
// .part through A3 negotiation, and REFUSES BY NAME if the bytes disagree
// with the offer digest (v1 trust hole closed: content identity, not
// transport luck). Same-package access: fetchFile/Transfer/SessionState are
// kofshare's own; no duplication of the wire machine.

Int indexOfChar(String s, Int from, Int ch) {
    var i = from
    while (i < s.length()) {
        if (s.charAt(i) == ch) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// "host:port" — the ONE address grammar of the plane (DeviceInfo.address).
String hostOfAddress(String address) {
    var c = indexOfChar(address, 0, 58)
    if (c <= 0) {
        throw "UF-ERR: malformed device address (want host:port): " + address
    }
    return address.substring(0, c)
}

Int portOfAddress(String address) {
    var c = indexOfChar(address, 0, 58)
    if (c <= 0 || c == address.length() - 1) {
        throw "UF-ERR: malformed device address (want host:port): " + address
    }
    var port = 0
    var i = c + 1
    while (i < address.length()) {
        var d = address.charAt(i)
        if (d < 48 || d > 57) {
            throw "UF-ERR: malformed device address (want host:port): " + address
        }
        port = port * 10 + (d - 48)
        i = i + 1
    }
    if (port < 1 || port > 65535) {
        throw "UF-ERR: malformed device address (want host:port): " + address
    }
    return port
}

// Publisher side, part 1. POSTs device then offer (OfferRequest wire — the
// SERVER stamps createdAt; A4). `controlBase` = "http://host:port". Refusals
// come back BY NAME (AUTH/REG bodies are surfaced, never swallowed).
String upPublish(String controlBase, String deviceId, String name, String address,
                 String filePath, String authHeader) {
    if (!File(filePath).exists()) {
        throw "UP-ERR: file not found: " + filePath
    }
    var data = File(filePath).readBytes()
    if (data.size == 0) {
        throw "UP-ERR: empty file: " + filePath
    }
    var digest = crypto.sha256Bytes(toBytes(data))
    var offerId = "o-" + digest.substring(0, 12)
    var reg = http.post(controlBase + "/devices",
        json.encode(DeviceInfo(deviceId, name, address)), authHeader)
    if (reg.indexOf("REGISTERED:") != 0) {
        throw "UP-ERR: device registration refused: " + reg
    }
    var off = http.post(controlBase + "/offers",
        json.encode(OfferRequest(offerId, deviceId, filePath, data.size, digest, "", "", "", 0, "", "")), authHeader)
    if (off.indexOf("OFFERED:") != 0) {
        throw "UP-ERR: offer registration refused: " + off
    }
    return "UP-OK offer=" + offerId + " size=" + data.size + " sha256=" + digest
}

// TRACK A publisher lane (product evolution 05/10). Same story, real
// identity: the device id is DERIVED from the public key (no hand-picked
// names on the wire), enrollment carries the self-signature, and the offer
// is signed over the canonical string so the plane can refuse a lie by name
// (DEV002/DEV003/DEV004 — surfaced as UP-ERR like every other refusal).
String upPublishSigned(String controlBase, Secret sk, String name, String address,
                       String filePath, String authHeader) {
    if (!File(filePath).exists()) {
        throw "UP-ERR: file not found: " + filePath
    }
    var data = File(filePath).readBytes()
    if (data.size == 0) {
        throw "UP-ERR: empty file: " + filePath
    }
    var pub = identityPub(sk)
    var deviceId = identityDeviceId(pub)
    var digest = crypto.sha256Bytes(toBytes(data))
    // v2-Track F lane: the resource is LOGICAL (device-scoped id over
    // basename+size+digest); the OFFER slot is derived from the resource, so
    // two devices publishing the SAME bytes occupy DIFFERENT slots — the
    // content-collision truth measured in Track A and Track D goldens, now
    // closed by construction. The WIRE path becomes the NAME (basename);
    // the binding resource→local path stays on THIS device.
    var res = fileResource(deviceId, filePath, data.size, digest, File(filePath).modifiedTime())
    var offerId = offerIdFor(deviceId, res.id)
    var regSig = signReg(sk, deviceId, name, address, pub)
    var reg = http.post(controlBase + "/devices/register",
        json.encode(DeviceRegister(deviceId, name, address, pub, regSig)), authHeader)
    if (reg.indexOf("REGISTERED:") != 0) {
        throw "UP-ERR: device enrollment refused: " + reg
    }
    var offerSig = signOffer(sk, offerId, deviceId, res.name, data.size, digest)
    var off = http.post(controlBase + "/offers",
        json.encode(OfferRequest(offerId, deviceId, res.name, data.size, digest, offerSig,
            res.id, res.name, res.modifiedAt, "", "")), authHeader)
    if (off.indexOf("OFFERED:") != 0) {
        throw "UP-ERR: offer registration refused: " + off
    }
    // presence beat (Track D): the device JUST talked to the plane, so it
    // says "I can serve now" — OPERATIONAL, never authorization: a failed
    // beat (legacy plane without the route) does not undo the publish; the
    // outcome is SURFACED in the message, never silent.
    var beat = http.post(controlBase + "/devices/" + deviceId + "/heartbeat", "{}", authHeader)
    var beatTag = "presence=ok"
    if (beat.indexOf("HEARTBEAT-OK") != 0) {
        beatTag = "presence=skipped(" + beat + ")"
    }
    bindingPut("kofshare-resources.json", ResourceBinding(res.id, filePath))
    return "UP-OK id=" + deviceId + " offer=" + offerId + " resource=" + res.id +
        " size=" + data.size + " sha256=" + digest + " " + beatTag
}

// Recipient side. GET /s/<token> (public — possession of the token IS the
// authorization), decode the grant, resume from any local .part (bare
// --resume semantics: the .part size IS the announced offset, A3 verifies it
// server-side), transfer, then VERIFY THE DIGEST the offer promised.
// Returns "DOWN-OK ..." on success; throws BY NAME otherwise.
String downFetch(String controlBase, String token, String dest, String key) {
    return downFetch(controlBase, token, dest, key, "", 0)
}

// Relay leg (D4=A — manual by vote, the SAME path `fetch --relay` takes):
// dial the RELAY instead of the grant address; the A3 HELLO negotiation and
// the tag checks ride through the byte pump untouched (ciphertext-only relay
// — it never sees the content). relayHost empty == direct dial.
String downFetch(String controlBase, String token, String dest, String key,
                 String relayHost, Int relayPort) {
    var g = grantDecode(controlBase, token)
    var host = hostOfAddress(g.deviceAddress)
    var port = portOfAddress(g.deviceAddress)
    if (relayHost.length() > 0) {
        host = relayHost
        port = relayPort
    }
    var c = net.connect(host, port)
    var t = takeAndVerify(c, g, dest, key)
    return "DOWN-OK offset=" + t.offset + "/" + t.totalBytes + " digest verified"
}

// Grant resolution shared by every DOWN lane: ANY non-JSON body is a refusal
// by name (REG*, DEV*, DEV-OFFLINE since Track D — never start with "{").
// Checking only "REG" would let a lie fall through into a bogus decode.
ShareGrant grantDecode(String controlBase, String token) {
    var body = http.get(controlBase + "/s/" + token)
    if (body.indexOf("{") != 0) {
        throw "DOWN-ERR: grant refused: " + body
    }
    return json.decode<ShareGrant>(body)
}

// The pump + the two VERIFICATIONS (size against the grant, digest against
// the offer) — ONE implementation shared by the manual lanes and the
// automatic Track D runner (transport selection never forks transfer logic).
Transfer takeAndVerify(Conn c, ShareGrant g, String dest, String key) {
    var resume = 0
    if (File(dest).exists()) {
        resume = File(dest).size() as Int
    }
    var host = hostOfAddress(g.deviceAddress)
    var t = pumpOn(c, dest, resume, g.offerId, host, key)
    if (t.totalBytes != g.size) {
        throw "DOWN-ERR: size mismatch: grant says " + g.size + " transport saw " + t.totalBytes
    }
    var got = crypto.sha256Bytes(toBytes(File(dest).readBytes()))
    if (got != g.sha256Hex) {
        throw "DOWN-ERR: content digest mismatch: offer says " + g.sha256Hex + " got " + got
    }
    return t
}

// TRACK D — the automatic recipient story (the prompt's endgame): resolve
// the grant, create the session (owner announces the recipient), PICK THE
// TRANSPORT BY TRYING IT (DIRECT → RELAY, honest refusals recorded), drive
// the session through its lifecycle with the CHOSEN transport stamped at
// CONNECTED, pump the bytes, verify, and COMPLETED. Session coordination is
// BYPASSABLE on purpose (sessionSid empty == v1 recipient with no account
// story) — the DATA law (digest verified or DOWN-ERR) is never bypassable.
// Returns "DOWN-AUTO-OK transport=<x> attempts=<n> offset=… digest verified".
String downAuto(String controlBase, String token, String dest, String key,
                String sessionAuth, String recipientDevice, String relayHost, Int relayPort) {
    var g = grantDecode(controlBase, token)
    return downAutoWithGrant(controlBase, token, g, dest, key, sessionAuth, recipientDevice, relayHost, relayPort)
}

// v2-Track I: the grant may ALREADY be resolved (the product `receive`
// preflight needs its metadata for the destination name). Resolving /s twice
// would consume `--once` TWICE — the capability is spent ONCE per resolve
// law (shareTouch), so every consumer takes the pre-resolved route.
String downAutoWithGrant(String controlBase, String token, ShareGrant g, String dest, String key,
                String sessionAuth, String recipientDevice, String relayHost, Int relayPort) {
    var host = hostOfAddress(g.deviceAddress)
    var port = portOfAddress(g.deviceAddress)
    var sid = ""
    if (recipientDevice.length() > 0) {
        var created = http.post(controlBase + "/sessions",
            json.encode(SessionRequest(token, recipientDevice, "")), sessionAuth)
        if (created.indexOf("SESSION-CREATED: ") == 0) {
            sid = created.substring(17)
            // CLAIMED has its own door (owner-side, stamps ownerAddr from the
            // registry); the generic advance refuses it by name — downAuto
            // speaks the SAME role matrix as the golden.
            var cl = http.post(controlBase + "/sessions/" + sid + "/claim", "{}", sessionAuth)
            if (cl.indexOf("SESSION-STATE") != 0) {
                throw "UF-ERR: session claim refused: " + cl
            }
            var ng = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
                json.encode(AdvanceRequest("NEGOTIATING", "")), sessionAuth)
            if (ng.indexOf("SESSION-STATE") != 0) {
                throw "UF-ERR: session negotiation refused: " + ng
            }
        } else {
            throw "UF-ERR: session create refused: " + created
        }
    }
    var picked = pickAndDial(host, port, relayHost, relayPort)
    if (sid.length() > 0) {
        var cn = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
            json.encode(AdvanceRequest("CONNECTED", picked.transport)), sessionAuth)
        if (cn.indexOf("SESSION-STATE") != 0) {
            throw "UF-ERR: session connect refused: " + cn
        }
        var tr = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
            json.encode(AdvanceRequest("TRANSFERRING", "")), sessionAuth)
        if (tr.indexOf("SESSION-STATE") != 0) {
            throw "UF-ERR: session transfer stamp refused: " + tr
        }
    }
    var t = takeAndVerify(picked.c, g, dest, key)
    if (sid.length() > 0) {
        http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
            json.encode(AdvanceRequest("COMPLETED", "")), sessionAuth)
    }
    return "DOWN-AUTO-OK transport=" + picked.transport + " sid=" + sid +
        " offset=" + t.offset + "/" + t.totalBytes + " digest verified"
}

// ─── v2-Track G: directories as logical collections ───────────────────────
// The tree is DOMAIN data (dir.kf model): one DIRECTORY offer carries the
// SORTED manifest; each child stays an individual Resource with its own
// digest. NOTHING IS PACKED on the wire — per-file transfer, per-file
// resume, per-file verification (the golden proves mid-child resume).

List<DirEntry> dirWalk(String deviceId, String rootPath) {
    var out = new List<DirEntry>()
    var rootName = resourceName(rootPath)
    out.add(DirEntry("r-" + crypto.sha256("dirself|" + deviceId + "|" + rootName).substring(0, 16),
        rootName, "DIRECTORY", 0, "", File(rootPath).modifiedTime()))
    dirWalkInto(deviceId, rootPath, rootName, out)
    return out
}

dirWalkInto(String deviceId, String dir, String logicalPrefix, List<DirEntry> out) {
    var names = Directory(dir).list()
    var i = 0
    while (i < names.size) {
        var seg = names.get(i)
        var full = dir + "/" + seg
        var lpath = seg
        if (logicalPrefix.length() > 0) {
            lpath = logicalPrefix + "/" + seg
        }
        if (File(full).isDirectory()) {
            out.add(DirEntry(resourceIdFor(deviceId, lpath, 0, ""), lpath, "DIRECTORY", 0, "",
                File(full).modifiedTime()))
            dirWalkInto(deviceId, full, lpath, out)
        } else {
            var data = File(full).readBytes()
            var h = crypto.sha256Bytes(toBytes(data))
            var sz = data.size
            out.add(DirEntry(resourceIdFor(deviceId, lpath, sz, h), lpath, "FILE", sz, h,
                File(full).modifiedTime()))
        }
        i = i + 1
    }
}

String upPublishDir(String controlBase, Secret sk, String address, String rootPath, String authHeader) {
    if (!Directory(rootPath).exists()) {
        throw "UP-ERR: directory not found: " + rootPath
    }
    var pub = identityPub(sk)
    var deviceId = identityDeviceId(pub)
    var raw = dirWalk(deviceId, rootPath)
    var entries = sortEntries(raw)
    var files = 0
    var i = 0
    while (i < entries.size) {
        if (entries.get(i).type == "FILE") {
            files = files + 1
        }
        i = i + 1
    }
    if (files == 0) {
        throw "UP-ERR: directory has no files: " + rootPath
    }
    var rootName = resourceName(rootPath)
    var dirHash = directoryDigest(rootName, entries)
    var rootId = resourceIdFor(deviceId, rootName, entries.size, dirHash)
    // rewrite the root self-row with its REAL derived id (dirWalk emitted a
    // placeholder; the digest never covered it, so this changes nothing).
    var finalEntries = new List<DirEntry>()
    var w = 0
    while (w < entries.size) {
        var ew = entries.get(w)
        if (ew.logicalPath == rootName) {
            finalEntries.add(DirEntry(rootId, ew.logicalPath, ew.type, ew.size, ew.hash, ew.modifiedAt))
        } else {
            finalEntries.add(ew)
        }
        w = w + 1
    }
    entries = finalEntries
    var offerId = offerIdFor(deviceId, rootId)
    var regSig = signReg(sk, deviceId, rootName, address, pub)
    var reg = http.post(controlBase + "/devices/register",
        json.encode(DeviceRegister(deviceId, rootName, address, pub, regSig)), authHeader)
    if (reg.indexOf("REGISTERED:") != 0) {
        throw "UP-ERR: device enrollment refused: " + reg
    }
    var offerSig = signOffer(sk, offerId, deviceId, rootName, entries.size, dirHash)
    var off = http.post(controlBase + "/offers",
        json.encode(OfferRequest(offerId, deviceId, rootName, entries.size, dirHash, offerSig,
            rootId, rootName, 0, "DIRECTORY", dirEntriesJson(entries))), authHeader)
    if (off.indexOf("OFFERED:") != 0) {
        throw "UP-ERR: directory offer refused: " + off
    }
    var beat = http.post(controlBase + "/devices/" + deviceId + "/heartbeat", "{}", authHeader)
    var beatTag = "presence=ok"
    if (beat.indexOf("HEARTBEAT-OK") != 0) {
        beatTag = "presence=skipped(" + beat + ")"
    }
    dirBindLocal(rootPath, deviceId, rootId, offerId)
    return "UP-OK id=" + deviceId + " offer=" + offerId + " resource=" + rootId +
        " files=" + files + " entries=" + entries.size + " dirhash=" + dirHash.substring(0, 12) + " " + beatTag
}

// The device-side binding for a tree: one row per FILE child plus the root →
// the LOCAL directory path (so `serve --dir` can rebuild any child from the
// folder name alone). The binding file stays LOCAL — §7.
String dirBindLocal(String rootPath, String deviceId, String rootId, String offerId) {
    bindingPut("kofshare-resources.json", ResourceBinding(rootId, rootPath))
    bindingPut("kofshare-resources.json", ResourceBinding("slot-" + offerId, rootPath))
    return "OK"
}

ShareGrant grantDecodeChild(String controlBase, String token, Int child) {
    var body = http.get(controlBase + "/s/" + token + "?child=" + child)
    if (body.indexOf("{") != 0) {
        throw "DOWN-ERR: grant refused: " + body
    }
    return json.decode<ShareGrant>(body)
}

// Device-side DIRECTORY face: one accept per child request; HELLO carries the
// child selector AND the resume offset in the same head (v1 HELLO unchanged
// for single files — a plain 0-offset HELLO keeps meaning "this session's
// only file"). Refusals name themselves on SERVE-REFUSED lines; the listener
// keeps serving.
String serveDirLoop(String rootPath, Int port, String key) {
    var l = net.listen(port)
    println("SERVE-LISTENING port=" + port + " dir=" + resourceName(rootPath))
    var served = 0
    var guard = 0
    while (guard < 64) {
        var c = l.accept()
        var first = recvRaw(c, 8)
        if (first.length < 8) {
            return "" + served
        }
        var typ = be32(first, 4)
        var off = be32(first, 0)
        var sel = 0 - 1
        if (typ == helloIndex()) {
            sel = 0
        }
        if (typ >= dirHelloBase() && typ < dirHelloBase() + 1000000) {
            sel = typ - dirHelloBase()
        }
        var rootName = resourceName(rootPath)
        var rel = pickNthFile(rootPath, rootName, sel)
        if (rel.length() == 0) {
            c.send(headFrame(0, resumeErrIndex()))
        } else {
            var rc = serveFilePicked(c, rootPath + "/" + rel, off, key)
            println("SERVED " + rc + " child=" + sel)
            served = served + 1
        }
        guard = guard + 1
    }
    return "" + served
}

// The device-side truth: rescan + sort yields the SAME order as the manifest
// published at offer time (sorting by logicalPath is the contract); pick the
// sel-th FILE and strip the root prefix from its logical path.
// HELLO already consumed by the loop — stream the picked bytes directly
// (serveFile would wait for a second handshake; v1 files keep that shape).
Int serveFilePicked(Conn c, String path, Int off, String key) {
    var data = File(path).readBytes()
    var total = data.size
    var v = resumeVerify(off, total)
    if (v != "OK") {
        c.send(headFrame(total, resumeErrIndex()))
        return 0 - 3
    }
    return sendChunks(c, data, off, key)
}

String pickNthFile(String rootPath, String rootName, Int sel) {
    if (sel < 0) {
        return ""
    }
    var raws = dirWalk("", rootPath)
    var entries = sortEntries(raws)
    var fi = 0
    var pick = -1
    var k = 0
    while (k < entries.size) {
        if (entries.get(k).type == "FILE") {
            if (fi == sel) {
                pick = k
            }
            fi = fi + 1
        }
        k = k + 1
    }
    if (pick < 0) {
        return ""
    }
    var lp = entries.get(pick).logicalPath
    var pfx = rootName + "/"
    if (lp.indexOf(pfx) != 0) {
        return ""
    }
    return lp.substring(pfx.length(), lp.length())
}

// Recipient side. Parent grant (no selector) = manifest; then ONE dial per
// file child, per-child resume from the destination's own head bytes, per-
// child digest — the directory is a COLLECTION all the way down.
String downDir(String controlBase, String token, String destRoot, String key) {
    var pg = grantDecode(controlBase, token)
    if (pg.type != "DIRECTORY") {
        throw "DOWN-ERR: token is not a directory share"
    }
    var entries = sortEntries(dirEntriesFromJson(pg.entriesJson))
    var host = hostOfAddress(pg.deviceAddress)
    var port = portOfAddress(pg.deviceAddress)
    var total = 0
    var files = 0
    var i = 0
    while (i < entries.size) {
        var e = entries.get(i)
        // selector = ordinal among FILE rows — the same counting law the
        // plane's ?child=N and the device face apply to the sorted manifest
        if (e.type != "FILE") {
            Directory(destRoot + "/" + parentOf(e.logicalPath)).createDirectories()
            i = i + 1
            continue
        }
        var rel = dirBaseName(e.logicalPath)
        var full = destRoot + "/" + e.logicalPath
        var mk = full
        var cut = mk.lastIndexOf("/")
        if (cut > 0) {
            Directory(mk.substring(0, cut)).createDirectories()
        }
        var resume = 0
        if (File(full).exists()) {
            var pb = File(full).readBytes()
            resume = pb.size
        }
        var c = net.connect(host, port)
        fetchFileDir(c, full, resume, files, pg.offerId, host, key)
        var fb = File(full).readBytes()
        var got = crypto.sha256Bytes(toBytes(fb))
        if (got != e.hash) {
            throw "DOWN-ERR: child digest mismatch " + e.logicalPath
        }
        total = total + fb.size
        files = files + 1
        i = i + 1
    }
    return "DOWN-OK dir files=" + files + " bytes=" + total
}

String parentOf(String logicalPath) {
    var cut = logicalPath.lastIndexOf("/")
    if (cut < 0) {
        return ""
    }
    return logicalPath.substring(0, cut)
}

// v2-Track I: the PRODUCT dir download — one SESSION per child (the same
// claim/advance doors the file lane uses; §16: sessions are the contract,
// the tree is just N files), transport stamped by the REAL dial, digest per
// child. relay/sealed over the directory face ride the same per-child dial.
String downDirAuto(String controlBase, String token, String destRoot, String key,
                   String sessionAuth, String recipientDevice, String relayHost, Int relayPort) {
    var pg = grantDecode(controlBase, token)
    return downDirAutoWithGrant(controlBase, token, pg, destRoot, key, sessionAuth, recipientDevice, relayHost, relayPort)
}

String downDirAutoWithGrant(String controlBase, String token, ShareGrant pg, String destRoot, String key,
                   String sessionAuth, String recipientDevice, String relayHost, Int relayPort) {
    if (pg.type != "DIRECTORY") {
        throw "DOWN-ERR: token is not a directory share"
    }
    var entries = sortEntries(dirEntriesFromJson(pg.entriesJson))
    var host = hostOfAddress(pg.deviceAddress)
    var port = portOfAddress(pg.deviceAddress)
    var files = 0
    var i = 0
    while (i < entries.size) {
        var e = entries.get(i)
        if (e.type == "FILE") {
            var full = dirJoinSafe(destRoot, e.logicalPath)
            if (full.length() == 0) {
                throw "DOWN-ERR: traversal-shaped logical path: " + e.logicalPath
            }
            var cut = full.lastIndexOf("/")
            if (cut > 0) {
                Directory(full.substring(0, cut)).createDirectories()
            }
            var resume = 0
            if (File(full).exists()) {
                var pb = File(full).readBytes()
                resume = pb.size
            }
            var sid = ""
            if (recipientDevice.length() > 0) {
                var created = http.post(controlBase + "/sessions",
                    json.encode(SessionRequest(token, recipientDevice, "")), sessionAuth)
                if (created.indexOf("SESSION-CREATED: ") == 0) {
                    sid = created.substring(17)
                    var cidx = "" + files
                    var cl = http.post(controlBase + "/sessions/" + sid + "/claim", "{}", sessionAuth)
                    if (cl.indexOf("SESSION-STATE") != 0) {
                        throw "UF-ERR: session claim refused: " + cl
                    }
                    var ng = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
                        json.encode(AdvanceRequest("NEGOTIATING", cidx)), sessionAuth)
                    if (ng.indexOf("SESSION-STATE") != 0) {
                        throw "UF-ERR: session negotiation refused: " + ng
                    }
                } else {
                    throw "UF-ERR: session create refused: " + created
                }
            }
            var picked = pickAndDial(host, port, relayHost, relayPort)
            if (sid.length() > 0) {
                var cn = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
                    json.encode(AdvanceRequest("CONNECTED", picked.transport)), sessionAuth)
                if (cn.indexOf("SESSION-STATE") != 0) {
                    throw "UF-ERR: session connect refused: " + cn
                }
                var tr = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
                    json.encode(AdvanceRequest("TRANSFERRING", "")), sessionAuth)
                if (tr.indexOf("SESSION-STATE") != 0) {
                    throw "UF-ERR: session transfer stamp refused: " + tr
                }
            }
            fetchFileDir(picked.c, full, resume, files, pg.offerId, host, key)
            var fb = File(full).readBytes()
            var got = crypto.sha256Bytes(toBytes(fb))
            if (got != e.hash) {
                throw "DOWN-ERR: child digest mismatch " + e.logicalPath
            }
            if (sid.length() > 0) {
                http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
                    json.encode(AdvanceRequest("COMPLETED", "")), sessionAuth)
            }
            files = files + 1
        }
        i = i + 1
    }
    return "DOWN-AUTO-OK dir files=" + files + " per-child sessions, digests verified"
}
