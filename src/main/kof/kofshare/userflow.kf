package kofshare

import kof.http
import kof.json
import kof.crypto
import kof.keyExchange
import kof.secrets
import kof.net
import kofshare.domain
import kofshare.connect
import kofshare.transfer
import kofshare.control.registry
import kofshare.control.share
import kofshare.control.session

// A6 user flow — the last mile between the pieces and the person.
// `upPublish` registers device + offer in the CONTROL PLANE over real HTTP
// (the plane stamps offer freshness itself — A4 wire); `downFetch` takes the
// SHARE TOKEN, resolves the grant through the public GET /s/<token> (the
// token IS the possession authorization — C3), learns WHERE the file lives
// (deviceAddress shipped inside the grant since C2), resumes from a local
// .part through A3 negotiation, and REFUSES BY NAME if the bytes disagree
// with the offer digest (v1 trust hole closed: content identity, not
// transport luck). Same-package access: fetchFile/Transfer/SessionState are
// kofshare's own; no duplication of the wire machine.

Int indexOfChar(String s, Int from, Int ch) {
    var i = from
    while (i < s.length()) {
        if (s.charAt(i) == ch) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// "host:port" — the ONE address grammar of the plane (DeviceInfo.address).
String hostOfAddress(String address) {
    var c = indexOfChar(address, 0, 58)
    if (c <= 0) {
        throw "UF-ERR: malformed device address (want host:port): " + address
    }
    return address.substring(0, c)
}

Int portOfAddress(String address) {
    var c = indexOfChar(address, 0, 58)
    if (c <= 0 || c == address.length() - 1) {
        throw "UF-ERR: malformed device address (want host:port): " + address
    }
    var port = 0
    var i = c + 1
    while (i < address.length()) {
        var d = address.charAt(i)
        if (d < 48 || d > 57) {
            throw "UF-ERR: malformed device address (want host:port): " + address
        }
        port = port * 10 + (d - 48)
        i = i + 1
    }
    if (port < 1 || port > 65535) {
        throw "UF-ERR: malformed device address (want host:port): " + address
    }
    return port
}

// Publisher side, part 1. POSTs device then offer (OfferRequest wire — the
// SERVER stamps createdAt; A4). `controlBase` = "http://host:port". Refusals
// come back BY NAME (AUTH/REG bodies are surfaced, never swallowed).
String upPublish(String controlBase, String deviceId, String name, String address,
                 String filePath, String authHeader) {
    if (!File(filePath).exists()) {
        throw "UP-ERR: file not found: " + filePath
    }
    var data = File(filePath).readBytes()
    if (data.size == 0) {
        throw "UP-ERR: empty file: " + filePath
    }
    var digest = crypto.sha256Bytes(toBytes(data))
    var offerId = "o-" + digest.substring(0, 12)
    var reg = http.post(controlBase + "/devices",
        json.encode(DeviceInfo(deviceId, name, address)), authHeader)
    if (reg.indexOf("REGISTERED:") != 0) {
        throw "UP-ERR: device registration refused: " + reg
    }
    var off = http.post(controlBase + "/offers",
        json.encode(OfferRequest(offerId, deviceId, filePath, data.size, digest, "")), authHeader)
    if (off.indexOf("OFFERED:") != 0) {
        throw "UP-ERR: offer registration refused: " + off
    }
    return "UP-OK offer=" + offerId + " size=" + data.size + " sha256=" + digest
}

// TRACK A publisher lane (product evolution 05/10). Same story, real
// identity: the device id is DERIVED from the public key (no hand-picked
// names on the wire), enrollment carries the self-signature, and the offer
// is signed over the canonical string so the plane can refuse a lie by name
// (DEV002/DEV003/DEV004 — surfaced as UP-ERR like every other refusal).
String upPublishSigned(String controlBase, Secret sk, String name, String address,
                       String filePath, String authHeader) {
    if (!File(filePath).exists()) {
        throw "UP-ERR: file not found: " + filePath
    }
    var data = File(filePath).readBytes()
    if (data.size == 0) {
        throw "UP-ERR: empty file: " + filePath
    }
    var pub = identityPub(sk)
    var deviceId = identityDeviceId(pub)
    var digest = crypto.sha256Bytes(toBytes(data))
    var offerId = "o-" + digest.substring(0, 12)
    var regSig = signReg(sk, deviceId, name, address, pub)
    var reg = http.post(controlBase + "/devices/register",
        json.encode(DeviceRegister(deviceId, name, address, pub, regSig)), authHeader)
    if (reg.indexOf("REGISTERED:") != 0) {
        throw "UP-ERR: device enrollment refused: " + reg
    }
    var offerSig = signOffer(sk, offerId, deviceId, filePath, data.size, digest)
    var off = http.post(controlBase + "/offers",
        json.encode(OfferRequest(offerId, deviceId, filePath, data.size, digest, offerSig)), authHeader)
    if (off.indexOf("OFFERED:") != 0) {
        throw "UP-ERR: offer registration refused: " + off
    }
    // presence beat (Track D): the device JUST talked to the plane, so it
    // says "I can serve now" — OPERATIONAL, never authorization: a failed
    // beat (legacy plane without the route) does not undo the publish; the
    // outcome is SURFACED in the message, never silent.
    var beat = http.post(controlBase + "/devices/" + deviceId + "/heartbeat", "{}", authHeader)
    var beatTag = "presence=ok"
    if (beat.indexOf("HEARTBEAT-OK") != 0) {
        beatTag = "presence=skipped(" + beat + ")"
    }
    return "UP-OK id=" + deviceId + " offer=" + offerId + " size=" + data.size + " sha256=" + digest + " " + beatTag
}

// Recipient side. GET /s/<token> (public — possession of the token IS the
// authorization), decode the grant, resume from any local .part (bare
// --resume semantics: the .part size IS the announced offset, A3 verifies it
// server-side), transfer, then VERIFY THE DIGEST the offer promised.
// Returns "DOWN-OK ..." on success; throws BY NAME otherwise.
String downFetch(String controlBase, String token, String dest, String key) {
    return downFetch(controlBase, token, dest, key, "", 0)
}

// Relay leg (D4=A — manual by vote, the SAME path `fetch --relay` takes):
// dial the RELAY instead of the grant address; the A3 HELLO negotiation and
// the tag checks ride through the byte pump untouched (ciphertext-only relay
// — it never sees the content). relayHost empty == direct dial.
String downFetch(String controlBase, String token, String dest, String key,
                 String relayHost, Int relayPort) {
    var g = grantDecode(controlBase, token)
    var host = hostOfAddress(g.deviceAddress)
    var port = portOfAddress(g.deviceAddress)
    if (relayHost.length() > 0) {
        host = relayHost
        port = relayPort
    }
    var c = net.connect(host, port)
    var t = takeAndVerify(c, g, dest, key)
    return "DOWN-OK offset=" + t.offset + "/" + t.totalBytes + " digest verified"
}

// Grant resolution shared by every DOWN lane: ANY non-JSON body is a refusal
// by name (REG*, DEV*, DEV-OFFLINE since Track D — never start with "{").
// Checking only "REG" would let a lie fall through into a bogus decode.
ShareGrant grantDecode(String controlBase, String token) {
    var body = http.get(controlBase + "/s/" + token)
    if (body.indexOf("{") != 0) {
        throw "DOWN-ERR: grant refused: " + body
    }
    return json.decode<ShareGrant>(body)
}

// The pump + the two VERIFICATIONS (size against the grant, digest against
// the offer) — ONE implementation shared by the manual lanes and the
// automatic Track D runner (transport selection never forks transfer logic).
Transfer takeAndVerify(Conn c, ShareGrant g, String dest, String key) {
    var resume = 0
    if (File(dest).exists()) {
        resume = File(dest).size() as Int
    }
    var host = hostOfAddress(g.deviceAddress)
    var t = pumpOn(c, dest, resume, g.offerId, host, key)
    if (t.totalBytes != g.size) {
        throw "DOWN-ERR: size mismatch: grant says " + g.size + " transport saw " + t.totalBytes
    }
    var got = crypto.sha256Bytes(toBytes(File(dest).readBytes()))
    if (got != g.sha256Hex) {
        throw "DOWN-ERR: content digest mismatch: offer says " + g.sha256Hex + " got " + got
    }
    return t
}

// TRACK D — the automatic recipient story (the prompt's endgame): resolve
// the grant, create the session (owner announces the recipient), PICK THE
// TRANSPORT BY TRYING IT (DIRECT → RELAY, honest refusals recorded), drive
// the session through its lifecycle with the CHOSEN transport stamped at
// CONNECTED, pump the bytes, verify, and COMPLETED. Session coordination is
// BYPASSABLE on purpose (sessionSid empty == v1 recipient with no account
// story) — the DATA law (digest verified or DOWN-ERR) is never bypassable.
// Returns "DOWN-AUTO-OK transport=<x> attempts=<n> offset=… digest verified".
String downAuto(String controlBase, String token, String dest, String key,
                String sessionAuth, String recipientDevice, String relayHost, Int relayPort) {
    var g = grantDecode(controlBase, token)
    var host = hostOfAddress(g.deviceAddress)
    var port = portOfAddress(g.deviceAddress)
    var sid = ""
    if (recipientDevice.length() > 0) {
        var created = http.post(controlBase + "/sessions",
            json.encode(SessionRequest(token, recipientDevice, "")), sessionAuth)
        if (created.indexOf("SESSION-CREATED: ") == 0) {
            sid = created.substring(17)
            // CLAIMED has its own door (owner-side, stamps ownerAddr from the
            // registry); the generic advance refuses it by name — downAuto
            // speaks the SAME role matrix as the golden.
            var cl = http.post(controlBase + "/sessions/" + sid + "/claim", "{}", sessionAuth)
            if (cl.indexOf("SESSION-STATE") != 0) {
                throw "UF-ERR: session claim refused: " + cl
            }
            var ng = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
                json.encode(AdvanceRequest("NEGOTIATING", "")), sessionAuth)
            if (ng.indexOf("SESSION-STATE") != 0) {
                throw "UF-ERR: session negotiation refused: " + ng
            }
        } else {
            throw "UF-ERR: session create refused: " + created
        }
    }
    var picked = pickAndDial(host, port, relayHost, relayPort)
    if (sid.length() > 0) {
        var cn = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
            json.encode(AdvanceRequest("CONNECTED", picked.transport)), sessionAuth)
        if (cn.indexOf("SESSION-STATE") != 0) {
            throw "UF-ERR: session connect refused: " + cn
        }
        var tr = http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
            json.encode(AdvanceRequest("TRANSFERRING", "")), sessionAuth)
        if (tr.indexOf("SESSION-STATE") != 0) {
            throw "UF-ERR: session transfer stamp refused: " + tr
        }
    }
    var t = takeAndVerify(picked.c, g, dest, key)
    if (sid.length() > 0) {
        http.post(controlBase + "/sessions/" + sid + "/advance?token=" + token,
            json.encode(AdvanceRequest("COMPLETED", "")), sessionAuth)
    }
    return "DOWN-AUTO-OK transport=" + picked.transport + " sid=" + sid +
        " offset=" + t.offset + "/" + t.totalBytes + " digest verified"
}
